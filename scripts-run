#!/usr/bin/env bash
# Migration dispatcher shim (py2ts Phase 1, Step 4).
# Resolves tsx + run.ts relative to this file so it works from any cwd.
# Every script is now TypeScript (the Python→TS final deletion removed the
# .py twins); run.ts resolves <path>.ts and runs it via tsx. Repo-root-
# relative or absolute paths both work.
#
# A repo-relative script that exists is exec-ed under tsx directly: going
# through run.ts boots tsx twice per call, and CI makes a few hundred calls per
# PR. Everything else (absolute paths, which run.ts resolves against the
# script's own repo, and missing scripts, whose 127 message run.ts owns) still
# goes through run.ts.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ "$#" -ge 1 ] && [ -n "$1" ] && [ "${1#/}" = "$1" ] && [ -f "$DIR/$1.ts" ]; then
  script="$DIR/$1.ts"
  shift
  exec "$DIR/node_modules/.bin/tsx" "$script" "$@"
fi
exec "$DIR/node_modules/.bin/tsx" "$DIR/src/scripts/run.ts" "$@"
