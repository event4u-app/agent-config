#!/usr/bin/env bash
# Migration dispatcher shim (py2ts Phase 1, Step 4).
# Resolves tsx + run.ts relative to this file so it works from any cwd.
# Every script is now TypeScript (the Python→TS final deletion removed the
# .py twins); run.ts resolves <path>.ts and runs it via tsx. Repo-root-
# relative or absolute paths both work.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$DIR/node_modules/.bin/tsx" "$DIR/src/scripts/run.ts" "$@"
