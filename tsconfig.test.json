{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": ".",
        "noEmit": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "jsxImportSource": "preact",
        "types": ["node", "vitest/globals"]
    },
    "include": ["src/**/*", "tests/**/*", "internal/bench/core/**/*"],
    "exclude": ["node_modules", "dist"]
}
