# Discovery manifest (R3 — release-time scanner output).
# Generated by scripts/build_discovery_manifest.py; never committed.
# Asserted absent at PR time by scripts/check_release_includes_discovery.py.
/dist/discovery/


# Dependencies
/vendor/
/node_modules/
# Python virtualenv — used only for the live trigger-eval runner
# (anthropic SDK). Never commit.
/.venv/
# MCP server virtualenv (Python 3.11+, mcp SDK). Never commit.
/.venv-mcp/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# PHP
.phpunit.cache/
composer.lock

# Python
__pycache__/
*.pyc
.coverage
.coverage.*

# Temp
/tmp/
/.tmp/

# Playwright
/.playwright-mcp/*

# Ignore the agent settings (YAML is the active format; flat legacy is
# kept for the migration window and gets deleted by scripts/install once
# the YAML file has been written)
.agent-settings.yml
.agent-settings
.agent-settings.backup.key-value
# Exception: the bundled stub for `agent-config init --minimal` is a
# real package asset, not a user-local settings file (Step 7 Phase 2).
!templates/minimal/.agent-settings.yml

# Persistent chat-history log (crash recovery; written by
# scripts/chat_history.py, governed by the chat-history rule). Never
# commit — contains conversation content and session fingerprints.
/agents/.agent-chat-history
/agents/.agent-chat-history.bak
/agents/.agent-chat-history.*.bak
/agents/.agent-chat-history.session

# Artefact engagement telemetry log (default-off, maintainer-only;
# written by `./agent-config telemetry:record` when
# `telemetry.artifact_engagement.enabled: true`). Local-only —
# never commit.
.agent-engagement.jsonl
.agent-engagement.jsonl.bak

# Generated Augment Code projection of .agent-src/ (rebuilt by `task sync`)
/.augment/

# Generated IDE projections — only those listed in `.agent-tools.yml`
# are regenerated by `task sync` / `task generate-tools` in THIS
# package. The directories below stay ignored so a developer who runs
# `scripts/install.py --tools <id>` locally for testing does not
# accidentally re-commit them. Consumer installs are unaffected — they
# generate these outside this repository.
/.cursor/
/.clinerules/
/.windsurf/
/.windsurfrules
/.ai/
/GEMINI.md

# Dispatcher run results (produced by `dispatcher run --output …`, consumed by ci_summary)
/agents/reports/runs/

# Trigger-eval run outputs (produced by `scripts/skill_trigger_eval.py`;
# triggers.json is tracked, last-run.json is per-run output)
.agent-src.uncompressed/skills/*/evals/last-run.json
.agent-src/skills/*/evals/last-run.json
# Live trigger-eval outputs — timestamped JSON per run, not committed.
evals/results/

# Quantitative skill-eval runs (produced by `scripts/run_skill_evals.py`;
# evals.json is tracked, per-run outputs and benchmarks are not).
.agent-src.uncompressed/skills/*/evals/runs/
.agent-src/skills/*/evals/runs/

# Memory access runtime cache (per-repo `memory_status` probe result;
# regenerated on demand, never committed)
/.agent-memory/

# /implement-ticket run metrics (JSON lines per run, Q38 ✅ decided).
# Opt-in to commit for team review — default is local-only.
/agents/logs/implement-ticket/

# Phase 5.3 always-rule budget trend log (per-run JSONL, local-only).
/.github/budget-trend.jsonl

# Frugality canon baseline (per-run JSONL produced by
# scripts/measure_frugality_savings.py for road-to-trim-frugality-canon
# Phase 0). Local measurement log — canonical numbers are locked in
# agents/contexts/adr-frugality-savings-baseline.md. Never commit.
/agents/.frugality-baseline.jsonl

# Linter structural-density calibration logs (per-run JSONL / JSON,
# produced by scripts/measure_density.py + skill_linter.py for
# road-to-structural-linter-reform). Canonical numbers are locked in
# docs/contracts/linter-structural-model.md. Never commit.
/agents/.density-snapshot.jsonl
/agents/.density-baseline-lint.json

# Golden Transcript freeze-guard staging output (produced by
# `python3 -m tests.golden.capture --target tests/golden/.staging`,
# diffed against the committed baseline; never committed).
/tests/golden/.staging/
/tests/golden/.staging-*.txt
# Safety net: catch any alternative dot-prefixed staging variants
# (e.g. `.gt-staging/` debris from earlier capture iterations).
/tests/golden/.gt-*

# Cloud bundle output
/dist/

# MCP telemetry sink — per-call JSONL written by the stdio server
# (scripts/mcp_server/telemetry.py) for Phase 1 J4. Phase 2 routes the
# records into a queryable store; the local file is dev-time scratch.
/agents/.mcp-telemetry/

# Skill-usage telemetry (step-2-skill-inventory-rationalization Phase 1).
# Raw per-turn JSONL is local-only because it carries SHA-256 prompt
# hashes derived from the maintainer's own sessions. The aggregated
# report (skill-usage-report.md) IS committed as the 0-day baseline.
/agents/metrics/skill-usage.jsonl

# AI Council runtime price cache (refreshed weekly by
# `python3 scripts/update_prices.py`; bootstrapped on first /council
# call from scripts/ai_council/_default_prices.py). User-editable —
# never commit, prices drift constantly.
/agents/.agent-prices.md

# AI Council artefacts (questions, responses, sessions). Council
# output is dev-time scratch — informs decisions, never the durable
# contract. The roadmap / ADR / skill body cites convergence inline.
# Linking to council files would break for any reviewer who clones
# without the ignored content. See ai-council § Output path convention.
agents/council-questions/
agents/council-responses/*
agents/council-sessions/

# Carve-out: the 2026-05-18 roadmap-design pass is durable evidence
# cited by five proposed roadmaps' resolution gates. Tracked as a
# one-time exception; future council runs stay scratch by default.
# Pattern needs `/*` (not `/`) on the parent rule above so re-includes work.
!agents/council-responses/2026-05-18T*

# AI Council persistent events log (step-8 D3). JSONL audit trail of
# necessity / quota decisions. Local-only — hashes original_ask but is
# still considered private. See docs/contracts/ai-council-config.md.
agents/council-events.log

# AI Council per-run cache (raw provider responses keyed by run id).
# Regenerated on demand from the council session JSON; never commit.
.agent-cache/

# Tier 1 hook runtime state (context-hygiene.json, onboarding-gate.json).
# Written by SessionStart / PostToolUse hooks on Augment + Claude Code;
# regenerated on demand, never committed.
/agents/state/

# AI Video pipeline (Phase 1 of agents/roadmaps/ai-video-pipeline.md).
# The real provider-secrets file MUST NEVER be committed.
# Operator scratch under agents/ai-video/ is gitignored except the
# README, prompts library, examples, and committed fixtures used by
# the offline smoke test.
agents/.ai-video.xml
agents/ai-video/*
!agents/ai-video/README.md
!agents/ai-video/prompts/
!agents/ai-video/prompts/**
!agents/ai-video/examples/
!agents/ai-video/examples/**
/agents/tmp/
