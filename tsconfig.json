{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "exactOptionalPropertyTypes": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "declaration": false,
        "sourceMap": true,
        "baseUrl": "./src",
        "paths": {
            "@cli/*": ["cli/*"],
            "@server/*": ["server/*"]
        }
    },
    "include": ["src/cli/**/*", "src/server/**/*"],
    "exclude": ["src/ui/**/*", "node_modules", "dist", "tests"]
}
