#!/usr/bin/env bash
# Deprecated direct invocation.
#
# Public entry point is now `dist/cli/agent-config.js` via
# `npx @event4u/agent-config`. This shim survives one minor cycle
# then is removed (see ADR-012 + roadmap typescript-cli-and-local-gui-foundation).
#
# Behaviour:
#   - If dist/cli/agent-config.js exists       → forward to the TS binary
#   - If it is missing AND AGENT_CONFIG_LEGACY_DISPATCH=1 → fall back to
#     the legacy 955-line Bash dispatcher at scripts/_dispatch.bash
#   - Otherwise → error with a one-line build hint
set -euo pipefail

here="$(cd -- "$(dirname -- "$0")" && pwd)"
ts_entry="$here/../dist/cli/agent-config.js"
legacy_entry="$here/_dispatch.bash"

echo "warning: scripts/agent-config is deprecated; use 'npx @event4u/agent-config' instead" >&2

if [[ -f "$ts_entry" ]]; then
  exec node "$ts_entry" "$@"
fi

if [[ "${AGENT_CONFIG_LEGACY_DISPATCH:-0}" == "1" && -f "$legacy_entry" ]]; then
  exec bash "$legacy_entry" "$@"
fi

echo "❌  agent-config: dist/cli/agent-config.js not found" >&2
echo "    Run 'npm run build' in the package root, or set" >&2
echo "    AGENT_CONFIG_LEGACY_DISPATCH=1 to use the Bash fallback." >&2
exit 1
