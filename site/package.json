{
  "name": "@event4u/agent-config-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Docs + proof site for agent-config (Starlight). Isolated workspace — its deps never touch the package.",
  "scripts": {
    "sync": "node sync-docs.mjs && node gen-cli-reference.mjs",
    "prebuild": "node sync-docs.mjs && node gen-cli-reference.mjs && node build-demo-map.mjs",
    "predev": "node sync-docs.mjs && node gen-cli-reference.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "demo-map": "node build-demo-map.mjs",
    "cli-reference": "node gen-cli-reference.mjs"
  },
  "dependencies": {
    "astro": "7.4.1",
    "@astrojs/starlight": "0.42.6",
    "starlight-theme-rapide": "^0.6.0",
    "astro-mermaid": "^2.1.0",
    "mermaid": "^11.17.2",
    "sharp": "^0.35.5"
  }
}
