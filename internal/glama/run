#!/usr/bin/env bash
# glama.ai CMD launcher for the stdio MCP server.
#
# Companion to ./build — see that file for why the dotted literals (the tsx
# runner path `node_modules/.bin/tsx`, the `__main__.ts` entry) live in this
# committed script instead of glama's CMD field. The glama CMD only ever
# holds dot-free tokens:
#
#     ["mcp-proxy","--","bash","/app/internal/glama/run"]
#
# The server is a TypeScript module run via tsx (Node); it resolves its
# content root from its own module path, so no PYTHONPATH is needed. `exec`
# hands signals straight to Node so mcp-proxy can manage the child cleanly.
set -euo pipefail

exec node node_modules/.bin/tsx src/scripts/mcp_server/__main__.ts
