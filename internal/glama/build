#!/usr/bin/env bash
# glama.ai build step for the stdio MCP server.
#
# Why this file exists: glama's "Build steps" admin field silently drops
# the last character of any token containing a dot (e.g. `3.11` -> `3.1`,
# `node_modules/.bin/tsx` -> `…/.bin/ts`). Keeping the dotted literals
# (the tsx runner path, the `.ts` entry) inside this committed script means
# the glama field only ever holds a dot-free token:
#
#     bash /app/internal/glama/build
#
# Build context: cwd is the cloned repo root (/app).
#
# The MCP server is a TypeScript module (`src/scripts/mcp_server/`) run via
# tsx (Node) — its serving transport is the npm `@modelcontextprotocol/sdk`.
# The smoke client (`smoke.ts`) also uses the npm MCP SDK, so only Node deps
# are needed.
set -euo pipefail

npm ci
