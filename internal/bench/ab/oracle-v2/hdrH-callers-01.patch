diff --git a/src/core/money.mjs b/src/core/money.mjs
index 53a0c98..eaf233f 100644
--- a/src/core/money.mjs
+++ b/src/core/money.mjs
@@ -1,22 +1,26 @@
 // Amount parsing for the billing core. Amounts arrive as strings such as
-// "12.50", "EUR 12.50" or "USD 3". Everything downstream works in integer cents.
+// "12.50", "EUR 12.50" or "USD 3". parseAmount returns { cents, currency };
+// everything downstream works in integer cents.
 
 const CURRENCY_PREFIX = /^([A-Z]{3})\s+/;
+const DEFAULT_CURRENCY = 'EUR';
 
 export function parseAmount(text) {
   const raw = String(text).trim();
+  const match = raw.match(CURRENCY_PREFIX);
+  const currency = match ? match[1] : DEFAULT_CURRENCY;
   const body = raw.replace(CURRENCY_PREFIX, '');
   const value = Number(body);
   if (!Number.isFinite(value)) {
     throw new Error(`not an amount: ${text}`);
   }
-  return Math.round(value * 100);
+  return { cents: Math.round(value * 100), currency };
 }
 
 export function sumAmounts(texts) {
   let total = 0;
   for (const t of texts) {
-    total += parseAmount(t);
+    total += parseAmount(t).cents;
   }
   return total;
 }
