diff --git a/src/config/validate.mjs b/src/config/validate.mjs
index bba4153..e23002d 100644
--- a/src/config/validate.mjs
+++ b/src/config/validate.mjs
@@ -11,11 +11,19 @@ function oneOf(name, value, allowed) {
   return value;
 }
 
+function count(name, value) {
+  if (!/^\d+$/.test(value)) {
+    throw new UsageError(`invalid --${name}: "${value}" (expected a non-negative integer)`);
+  }
+  return Number(value);
+}
+
 export function buildConfig(raw) {
   return {
     help: raw.help === true,
     level: raw.level === undefined ? 'debug' : oneOf('level', raw.level, LEVELS),
     sort: raw.sort === undefined ? 'time' : oneOf('sort', raw.sort, SORTS),
     format: raw.format === undefined ? 'text' : oneOf('format', raw.format, FORMATS),
+    limit: raw.limit === undefined ? 0 : count('limit', raw.limit),
   };
 }
