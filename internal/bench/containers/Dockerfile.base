# Clean benchmark image: the agent CLI and the fixture toolchain, nothing else.
# Digest and CLI version are pinned so a report can name exactly what ran.
FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da

ARG CLAUDE_CLI_VERSION=2.1.316

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates php-cli \
 && rm -rf /var/lib/apt/lists/*

RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CLI_VERSION}" \
 && npm cache clean --force

# The node image ships a non-root `node` user (uid 1000); bypassPermissions is
# refused as root. Its home stays empty so nothing but the CLI defaults loads.
ENV HOME=/home/node \
    DISABLE_AUTOUPDATER=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    CI=1

RUN git config --system user.email bench@example.invalid \
 && git config --system user.name bench \
 && git config --system --add safe.directory '*'

USER node
WORKDIR /work
LABEL org.event4u.bench.role=base
