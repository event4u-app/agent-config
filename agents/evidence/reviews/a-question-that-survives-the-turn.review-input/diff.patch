+/** The reply that asks. Three options plus the single recommendation line. */
+const ASKED = [
+    'Zwei Wege sind moeglich, und die Wahl ist Deine:',
+    '',
+    '1. Den Detektor sofort scharf schalten',
+    '2. Erst eine Woche im Advisory-Modus messen',
+    '3. Gar nicht bauen',
+    '',
