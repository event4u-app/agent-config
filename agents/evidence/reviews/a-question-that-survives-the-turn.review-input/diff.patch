+const DROPPED = [
+    'Der Reviewer laeuft jetzt ueber den Diff.',
+    '',
+    'Die offene Frage bleibt davon unberuehrt und liegt bei Dir.',
+].join('\n');
+
+/** A reply that carries the block forward — the corrected behaviour. */
