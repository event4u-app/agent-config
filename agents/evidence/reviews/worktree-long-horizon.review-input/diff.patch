+    repoRoot: string,
+    rec: SessionRecord,
+    ledger: RelaunchLedger,
+    now: Date,
+): Candidate {
+    const base = {
+        session_id: rec.session_id,
+        roadmap: rec.roadmap_slug,
+        worktree: rec.worktree,
+        relaunches: ledger[rec.roadmap_slug ?? ''] ?? 0,
+    };
