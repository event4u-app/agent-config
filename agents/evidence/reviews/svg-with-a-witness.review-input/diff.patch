+        verdict: 'unverified',
+        reason: '',
+        asset_class: spec.assetClass,
+        tolerance: spec.tolerance,
+        tolerance_source: spec.toleranceSource,
+        sample_resolution: SAMPLE_RES,
+        anti_alias_band_units: unitsPerSample,
+        silhouette_iou: null,
