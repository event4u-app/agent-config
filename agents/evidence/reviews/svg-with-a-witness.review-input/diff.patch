+  <!-- planted (R10): the only motion on this page is an indefinite inline SMIL animation, and the page
+       carries no reduced-motion route at all - the shape DQ4 could not see before step 1.3.
+       The still twin below is present but hidden, so the twin file differs by this block alone. -->
+  <style>body { font-family: system-ui, sans-serif; font-size: 16px; color: #0f172a; background: #ffffff } .still { display: none }</style>
+</head>
+<body>
+  <h1>Status</h1>
+  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="48" height="48" role="img">
+    <title>Loading</title>
+    <circle class="still" cx="24" cy="24" r="11" fill="#2563eb"/>
+    <circle class="motion" cx="24" cy="24" r="8" fill="#2563eb"><animate attributeName="r" values="8;14;8" dur="1s" repeatCount="indefinite"/></circle>
+  </svg>
+</body>
+</html>
