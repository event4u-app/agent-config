+            const a = baseTexts[i];
+            const b = candTexts[i];
+            if (!a || !b) continue;
+            texts.push({
+                index: i,
+                baseline_family: a.family,
+                candidate_family: b.family,
+                baseline_box: a.box,
+                candidate_box: b.box,
+            });
+        }
