+                                        '| `gamma.gone` | A | `1` | fixture |\n',
+                                ),
+                            ),
+                        ),
+                },
+                {
+                    name: 'a class outside A|B|C is rejected',
+                    expect: 'reject',
+                    run: () =>
+                        run(
