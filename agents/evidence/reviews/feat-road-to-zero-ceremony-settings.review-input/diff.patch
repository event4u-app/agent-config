+                    name: 'a template whose every leaf is classified passes',
+                    expect: 'accept',
+                    run: () => run(seed('clean', template, clean)),
+                },
+                {
+                    name: 'an unclassified template leaf is rejected',
+                    expect: 'reject',
+                    run: () =>
