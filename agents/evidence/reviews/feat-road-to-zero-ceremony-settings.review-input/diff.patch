+                            ),
+                        ),
+                },
+                {
+                    name: 'a contract row naming a key the template lost is rejected',
+                    expect: 'reject',
+                    run: () =>
+                        run(
+                            seed(
+                                'stale-row',
+                                template,
+                                table(
