+            });
+        } catch {
+            // A refusal (lock not acquired) is a legitimate outcome, not a hold.
+        } finally {
+            stack.pop();
+        }
+    };
+
+    const prepare = (start: string): void => {
+        // Each schedule starts on the real clock, so the drift of earlier ones
+        // never makes a live guard look stale.
+        clock = realNow();
+        clear();
+        if (start === 'abandoned') {
