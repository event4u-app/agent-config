+export const DEFAULT_REMOTE_LOG_PATH = '.agent-telemetry.jsonl';
+export const DEFAULT_REMOTE_FLUSH = 'session-end';
+export const ALLOWED_REMOTE_FLUSH = ['session-end', 'never'] as const;
