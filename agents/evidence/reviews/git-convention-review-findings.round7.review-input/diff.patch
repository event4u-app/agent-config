+        eligible: eligible.length,
+        excluded,
+        authors,
+        capped,
+        cappedTotal: sample.length,
+        bar,
+        families,
+        newer,
+        older,
+        halvesAgree,
+        recent,
+        migratedBy,
+        established,
+        migrating,
+        reasons: established === null || migrating ? reasons : [],
