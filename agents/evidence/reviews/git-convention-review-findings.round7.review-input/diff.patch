+        counts.set(s, (counts.get(s) ?? 0) + 1);
+    }
+    const shapes = [...counts.entries()]
+        .map(([shape, count]) => ({ shape, count, share: count / sample.length }))
+        .sort((a, b) => b.count - a.count || a.shape.localeCompare(b.shape));
