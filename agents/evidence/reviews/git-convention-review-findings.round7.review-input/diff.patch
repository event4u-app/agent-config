+                verdict: { established: m.established, migrating: m.migrating, migrated_by: m.migratedBy, reasons: m.reasons, strongest: m.strongest },
+                branches: { sampled: b.sampled, pattern: b.pattern, share: b.share, shapes: b.shapes },
