+    });
+
+    it('yields no ticket for a security branch', () => {
+        const r = runGitConvention(['ticket', 'fix/CVE-2026-12345-patch', '--json'], repo());
+        expect(JSON.parse(r.out.join('\n'))).toMatchObject({ ticket: null });
+    });
