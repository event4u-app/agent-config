+        `observed_n: ${m.observedN}`,
+        `dominant_share: ${m.share.toFixed(2)}`,
+        `author_count: ${m.authors}`,
+        m.windowExtended === true
+            ? `sample_window: "any age (fewer than ${MIN_N} since ${MEASURE_SINCE}), newest ${MEASURE_LIMIT} non-merge commits"`
