+const REPO_ROOT = path.resolve(fileURLToPath(import.meta.url), '..', '..', '..');
+const HOOK = path.join(REPO_ROOT, 'src', 'scripts', 'hooks', 'turn_end_gate_hook.ts');
+const TSX = path.join(
+    REPO_ROOT,
+    'node_modules',
+    '.bin',
