+            unmerged = new Set(
+                String(r.stdout ?? '')
+                    .split('\n')
+                    .map((s) => s.trim())
+                    .filter((s) => s !== ''),
+            );
+        }
+    } catch {
+        unmerged = null; // no filter available — report everything rather than nothing
+    }
