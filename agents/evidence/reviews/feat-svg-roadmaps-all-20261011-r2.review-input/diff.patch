+    return {
+        status: 'read',
+        reference_files: comparable.map((r) => path.basename(r.file)),
+        reference_stroke_widths: refStrokes,
+        reference_padding: refPadding,
+        stroke_width: strokeWidth,
+        padding,
+        reason: `read from ${comparable.length} incumbent SVG(s)`,
+    };
