+    context: Awaited<ReturnType<Browser['newContext']>>,
+    openPage: OpenPage,
+    spec: {
+        url: string;
+        hostHtml: string | null;
+        width: number;
+        height: number;
+        cssWidth: number;
+        blocked: string[];
+        backgrounds: AssetReading['backgrounds'];
