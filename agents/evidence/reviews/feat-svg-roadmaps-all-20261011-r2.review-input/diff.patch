+            out.push({
+                background: mode,
+                background_color: colour,
+                silhouette_px: counts.silhouette,
+                painted_px: counts.painted,
+                low_contrast_px: counts.low,
+                low_contrast_share: counts.painted === 0 ? 0 : counts.low / counts.painted,
