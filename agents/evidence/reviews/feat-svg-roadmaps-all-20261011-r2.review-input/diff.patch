+            edit(svg),
+            RENDER,
+            edit('site/index.html'),
+        ]);
+        expect(finding).not.toBeNull();
+        expect(finding?.evidence).toBe('assets/logo.svg');
+    });
+
+    it('planted-fixture-edit-is-no-svg-obligation', () => {
