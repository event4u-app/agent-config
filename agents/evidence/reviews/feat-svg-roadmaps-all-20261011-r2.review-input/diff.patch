+                        if (y > 0) push(i - w);
+                        if (y + 1 < h) push(i + w);
+                    }
+
+                    let sil = 0;
+                    let painted = 0;
+                    let low = 0;
+                    let bleed = 0;
+                    for (let i = 0; i < w * h; i += 1) {
+                        if (outside[i] === 1) continue;
