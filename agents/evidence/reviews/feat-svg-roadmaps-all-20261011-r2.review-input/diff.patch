+const rel = (root: string, p: string): string => {
+    const slashed = p.split(path.sep).join('/');
+    if (!path.isAbsolute(p)) return slashed.replace(/^\.\//, '');
+    const inside = path.relative(root, p).split(path.sep).join('/');
