+                {
+                    silhouette: silhouette.toString('base64'),
+                    ground: shot.toString('base64'),
+                    colour,
+                    holes: spec.holeBoxes,
+                    soft: spec.softBoxes,
+                    vb: spec.viewBox,
+                    minContrast: MIN_CONTRAST_RATIO,
+                },
+            );
