+
+/** The subset of the caller's page opener this pass needs. */
+export type OpenPage = (
+    context: Awaited<ReturnType<Browser['newContext']>>,
+    spec: {
+        url: string;
+        hostHtml: string | null;
+        hostBasename: string;
+        width: number;
+        height: number;
+        background: string;
+        cssWidth: number;
+        blocked: string[];
+    },
