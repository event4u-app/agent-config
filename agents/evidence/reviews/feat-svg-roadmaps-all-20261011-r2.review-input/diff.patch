+        // basename collision inside one turn is a narrower hole than the
+        // any-render-unlocks-everything it replaces.
+        return slashed.includes(relPath) || new RegExp(`(^|[\\s/'"])${escapeRe(base)}(\\s|$|['"])`).test(slashed);
+    });
