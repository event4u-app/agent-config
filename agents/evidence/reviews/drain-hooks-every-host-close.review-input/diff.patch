index 0000000000000000000000000000000000000000..dd6e61154d2d2798ea52fe3b1bc3f56f3c1c24d4
--- /dev/null
+++ b/.github/workflows/host-docs-digest.yml
@@ -0,0 +1,100 @@
+name: Host Docs Digest Watch
+
+# READ-ONLY watcher for the "a vendor rewrote its hooks contract and nothing
+# noticed" failure mode (road-to-hooks-on-every-host Phase 1.3).
+#
+# `src/scripts/hooks/host_lowering.yaml` records, per host, the page each row's
+# answers were read off and the sha256 of that page's body on the day it was
+# read. Without this job the only thing watching those pages is the row's own
+# `expires`, which is up to a year out — so a host could change its refusal
+# contract and every gate in this tree would stay green for months.
+#
+# WHAT THIS JOB DOES NOT DO, deliberately. It never writes to the table and it
+# never opens a pull request. A changed body is evidence that the page MOVED,
+# not a reading of what it now says, and the one thing this package must not do
+# is adopt upstream text automatically — that would turn a vendor's edit into
+# this package's claim without a human ever reading it. The job goes red; a
+# human reads the page; the row is re-established BY HAND. Note that
+# `./scripts-run src/scripts/check_host_docs_digest --fetch --write` does not
+# finish that job — it marks the row stale (pulls `expires` BACK and keeps the
+# recorded digest) and nothing moves `expires` forward again. Re-establishing
+# means editing `docs_at`, `docs_digest` and `expires` after reading the page,
+# and that edit carries its own ratification artifact (the table is on
+# `check_kernel_edit_ratified`'s plumbing list).
+#
+# So: red here means "go read a page", never "something is broken in this repo".
+#
+# Unreachable is not drift. `--strict-fetch` is deliberately NOT passed: a
+# flaky vendor host or a runner with no egress establishes nothing about the
+# page, and a watcher that cried wolf on every 503 would be muted within a
+# month. Unreachable rows are listed in the log and the job stays green.
+#
+# A 404/410 is the exception and reds WITHOUT `--strict-fetch`, because a
+# removed page is not a flake: it is the server stating that the citation is
+# dead, which is the one thing a watcher must not sit on quietly while the row
+# keeps a stale digest and a year-long `expires`.
+#
+# Recovery writes TWO files, not one. `--fetch --write` rewrites the YAML, and
+# `src/scripts/hooks/host_lowering.json` is fingerprinted over that YAML's
+# text, so the write makes the compiled sibling stale and reds `task preflight`
+# and CI until `./scripts-run src/scripts/compile_hook_manifest --table
+# host-lowering` is run too. The script prints that as a NEXT line; it is
+# repeated here because this comment is where someone reading a red run looks.
+
+on:
+  schedule:
+    # Weekly, not daily. The rows carry year-long `expires` values and the
+    # signal this watches moves on the order of product releases, so a daily
+    # run would spend 7x the vendor requests for the same finding. Monday
+    # early-UTC so a drift is in front of a human at the start of a week.
+    - cron: "17 6 * * 1"
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: host-docs-digest
+  cancel-in-progress: true
+
+jobs:
+  digest-watch:
+    runs-on: ubuntu-latest
+    steps:
+      # No `ref: main`. Pinning the ref made the job untestable before it was
+      # relied on: a scheduled run already uses the default branch, while a
+      # `workflow_dispatch` from a branch would have checked out main anyway and
+      # run main's table rather than the branch's. Taking the dispatched ref
+      # means this YAML and this table can be exercised once from a branch
+      # before anyone depends on the weekly signal — which a completion review
+      # pointed out had never happened.
+      - name: Check out the dispatched ref (the default branch on a schedule)
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
+        with:
+          persist-credentials: false
+
+      - name: Set up Node
+        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020  # v7.0.0
+        with:
+          node-version: '20'
+          cache: 'npm'
+
+      # `./scripts-run` execs node_modules/.bin/tsx — without this the job dies
+      # at exit 127 and a real drift is indistinguishable from a broken runner.
+      - name: Install Node deps
+        run: |
+          npm ci --no-audit --no-fund --fetch-retries=5 --fetch-retry-mintimeout=10000 \
+            || (sleep 10 && npm ci --no-audit --no-fund --fetch-retries=5 --fetch-retry-mintimeout=10000)
+
+      # Offline first, and this step is load-bearing beyond tidiness. It is the
+      # invocation `check_gate_coverage` spawns on every pull request to read
+      # this gate's `scanned:` floor — `src/config/gate-coverage.yml` pins
+      # `argv: []` to match it. Pinning the `--fetch` form instead would make
+      # every PR in the repository issue eight live vendor requests to learn a
+      # number that `reportScanned` emits before any fetch happens, and would
+      # put up to 8 x 30s of third-party latency inside a required check.
+      - name: Report the watch scope (offline, no egress)
+        run: ./scripts-run src/scripts/check_host_docs_digest
+
+      - name: Re-fetch each host docs page and compare (read-only)
+        run: ./scripts-run src/scripts/check_host_docs_digest --fetch
