+    // The base advances, so the rebase rewrites something.
+    sb.commit(seed, 'base2.txt', 'base2\n', 'base moves');
+    sb.git(seed, 'push', '-q', 'origin', 'main');
+
+    const collab = path.join(sb.root, 'collab');
