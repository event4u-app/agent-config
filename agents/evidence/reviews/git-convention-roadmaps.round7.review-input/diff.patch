+        const oldEdit = r.sb.git(r.me, 'rev-parse', '--short', `${save}`);
+        const newEdit = r.sb.git(r.me, 'rev-parse', '--short', 'HEAD');
+        const untouchedNew = r.sb.git(r.me, 'rev-parse', '--short', 'HEAD~1');
