+
+describe('all three keys', () => {
+    it('reads every key in one pass', () => {
+        const dir = tmp();
+        const p = file(dir, 'p.yml', 'git:\n  commit_format: ticket-scope\n  branch_pattern: "{ticket}-{slug}"\n');
