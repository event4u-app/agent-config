+/**
+ * Pins the `limits:` block of `analyze/pr/command.md` against its flow text
+ * (step 5.2/5.3), and both against the code the flow names, so the frontmatter
+ * pin, the body and `analysis_pr_optimize.ts` cannot drift apart.
+ */
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+import { describe, expect, it } from 'vitest';
+import { parse } from 'yaml';
+
+import { MAX_OPTIMIZE_ROUNDS } from '../../src/scripts/analysis_pr_optimize.js';
+import { DEFAULT_CONFIDENCE_THRESHOLD } from '../../src/scripts/analysis_pr_review.js';
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..', '..');
+const COMMAND = path.join(ROOT, 'src/domains/analysis-workbench/analyze/pr/command.md');
+const text = fs.readFileSync(COMMAND, 'utf-8');
+const fm = parse(/^---\n([\s\S]*?)\n---\n/u.exec(text)![1]!) as Record<string, unknown>;
+
+describe('analyze:pr limits', () => {
+    it('pins the limit values and matches the code', () => {
+        expect(fm['limits']).toEqual({ mode_default: 'plan', max_iterations: 3, hard_ceiling: 3, no_gain_stop: 1, target_metric: 'required' });
+        expect(MAX_OPTIMIZE_ROUNDS).toBe(3);
+        expect(text).toContain(`Default \`${DEFAULT_CONFIDENCE_THRESHOLD}\``);
+    });
+
+    it('the body restates each limit', () => {
+        expect(text).toContain('`--optimize` must be\n**explicitly present in the invocation**');
+        expect(text).toContain('At most **three** fix rounds');
+        expect(text).toMatch(/One review that finds\s+nothing new above the threshold stops the run/u);
+        expect(text).toContain('findings with a diff anchor');
+    });
+
+    it('feedback is read-only and the door never merges', () => {
+        expect(text).toContain('makes no `gh` write call');
+        expect(text).toContain('Never merges, never approves its own changes');
+    });
+
+    it('links the shared analysis-loop context (step 1.3)', () => {
+        expect(text).toContain('](../../contexts/execution/analysis-loop.md)');
+    });
+});
diff --git a/tests/scripts/analyze_router_routes.test.ts b/tests/scripts/analyze_router_routes.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7a87e975537f074b14cf6b795b36e511bd0acb6d
--- /dev/null
+++ b/tests/scripts/analyze_router_routes.test.ts
@@ -0,0 +1,49 @@
+/**
+ * Step 6.1: the `/analyze` dispatcher names every `routes_to` entry in its
+ * sub-command table, keyword table and menu, and its eval set routes one prompt
+ * per entry to that entry — counted from `routes_to`, never written as a number.
+ */
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+import { describe, expect, it } from 'vitest';
+import { parse } from 'yaml';
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..', '..');
+const text = fs.readFileSync(path.join(ROOT, 'src/domains/analysis-workbench/analyze/command.md'), 'utf-8');
+const fm = parse(/^---\n([\s\S]*?)\n---\n/u.exec(text)![1]!) as { routes_to: string[] };
+const evals = JSON.parse(fs.readFileSync(path.join(ROOT, 'src/agent-src/commands/evals/analyze.json'), 'utf-8')) as {
+    cases: Array<{ prompt: string; expected: string }>;
+};
+const subOf = (name: string): string => name.replace(/^analyze-/u, '');
+
+describe('/analyze router (step 6.1)', () => {
+    it('every routes_to entry is a command file in the cluster', () => {
+        for (const r of fm.routes_to) {
+            const file = path.join(ROOT, 'src/domains/analysis-workbench/analyze', subOf(r), 'command.md');
+            expect(fs.existsSync(file), r).toBe(true);
+            expect(fs.readFileSync(file, 'utf-8')).toContain(`name: ${r}\n`);
+        }
+    });
+
+    it('the sub-command table, the keyword table and the menu name every entry', () => {
+        for (const r of fm.routes_to) {
+            const sub = subOf(r);
+            expect(text, `table row ${sub}`).toContain(`| \`/analyze:${sub}\` | \`analyze/${sub}/command.md\` |`);
+            expect(text, `keyword row ${sub}`).toMatch(new RegExp(`\\| \`${sub}\` \\|\\n`, 'u'));
+            expect(text, `menu entry ${sub}`).toMatch(new RegExp(`^> \\d+\\. \\[[a-z]+\\] .*\\(\`/analyze:${sub}\`\\)`, 'mu'));
+        }
+    });
+
+    it('the escape is counted from routes_to, not written as a number', () => {
+        expect(text).toContain('show every `routes_to` entry');
+        expect(text).not.toMatch(/show all \w+ options unranked/u);
+    });
+
+    it('the eval set routes one prompt per routes_to entry to that entry', () => {
+        for (const r of fm.routes_to) {
+            expect(evals.cases.filter((c) => c.expected === r), r).toHaveLength(1);
+        }
+    });
+});
