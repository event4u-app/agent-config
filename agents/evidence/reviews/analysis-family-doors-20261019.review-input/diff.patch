@@ -0,0 +1,40 @@
+/**
+ * analysis_and_optimize.ts — what `analyze:and-optimize` reads (step 4.5,
+ * ADR-288 D1).
+ *
+ * The door's scope is the one `analysis_target.ts` resolved, never a path the
+ * caller names: inside a module every reader — the anchor table and the code
+ * the analysts open — stays under the module root, while `project_root` stays
+ * the outer project for settings and publication. The read set includes code,
+ * not only roadmaps and ADRs.
+ */
+import * as path from 'node:path';
+
+import { buildAnchorTable, walk, type AnchorTable, type Issue } from './analysis_anchors.js';
+import { isInside, type AnalysisTarget } from './analysis_target.js';
+
+const CODE_EXT = /\.(ts|tsx|js|jsx|mjs|cjs|py|php|rb|go|rs|java|kt|swift|cs|c|h|cpp|vue|svelte|sh)$/;
+
+export interface ReadSet {
+    scope_root: string;
+    anchors: AnchorTable;
+    /** Absolute paths of the code files the analysts read. */
+    code: string[];
+    /** Every absolute path a reader of this run opens. */
+    readers: string[];
+}
+
+export function readSet(target: AnalysisTarget, opts: { goal?: string; issues?: readonly Issue[] } = {}): ReadSet {
+    const root = target.scope_root;
+    const anchors = buildAnchorTable({ root, goal: opts.goal, issues: opts.issues });
+    const code = walk(root)
+        .filter((f) => CODE_EXT.test(f))
+        .map((f) => path.join(root, f));
+    const anchored = anchors.rows
+        .filter((r) => r.source !== 'issue' && r.source !== 'goal')
+        .map((r) => path.join(root, r.anchor.replace(/:\d+$/u, '')));
+    const readers = [...new Set([...code, ...anchored])].sort();
+    const escaped = readers.filter((p) => !isInside(p, root));
+    if (escaped.length > 0) throw new Error(`reader outside the scope root ${root}: ${escaped.join(', ')}`);
+    return { scope_root: root, anchors, code, readers };
+}
diff --git a/src/scripts/analysis_inbox_final.ts b/src/scripts/analysis_inbox_final.ts
new file mode 100644
index 0000000000000000000000000000000000000000..acb17b62d35f388d8816f94eaf6cbde2a63e86a0
--- /dev/null
+++ b/src/scripts/analysis_inbox_final.ts
@@ -0,0 +1,154 @@
+/**
+ * analysis_inbox_final.ts — what makes `analyze:inbox` the final stage of the
+ * analysis doors (step 3.4, ADR-288 D1).
+ *
+ * - `roundUnion`: one round is the runtime round folder plus the owner's drops,
+ *   read as one set; lineage comes from the round's manifest, not from
+ *   filenames; an opaque round id skips the Phase 1 rename.
+ * - `directiveBinding`: which turns bind, by provenance.
+ * - `convergenceRow`: the final Convergence loop names every binding directive
+ *   it checked, or it is refused.
+ * - `planLanes` / `foldLaneLedgers`: a round above the slicing size runs as
+ *   parallel lanes, each with its own census and point ledger, folded once.
+ */
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+
+import { isOpaqueRoundId } from './_lib/source_shape.js';
+import { DROPS_REL } from './analysis_analysts.js';
+import { RUN_STATE_FILE, RUNS_REL } from './analysis_run.js';
+
+/** ADR-288 D9: the inbox's own measured batch threshold (Phase 2b). */
+export const INBOX_LANE_MAX_BYTES = 400_000;
+export const INBOX_LANE_MAX_TOPICS = 5;
+export const ROUND_MANIFEST = 'manifest.json';
+
+export class InboxFinalError extends Error {}
+
+export interface RoundFile {
+    rel: string;
+    origin: 'runtime' | 'drop';
+}
+
+export interface RoundUnion {
+    files: RoundFile[];
+    lineage: Record<string, string[]>;
+    renameBeforeTriage: boolean;
+}
+
+const SEGMENT = /^[A-Za-z0-9][A-Za-z0-9._-]*$/u;
+const BOOKKEEPING = new Set([RUN_STATE_FILE, ROUND_MANIFEST]);
+
+function listFiles(projectRoot: string, rel: string): string[] {
+    const dir = path.join(projectRoot, rel);
+    if (!fs.existsSync(dir)) return [];
+    const out: string[] = [];
+    for (const entry of fs.readdirSync(dir, { withFileTypes: true }).sort((a, b) => a.name.localeCompare(b.name))) {
+        if (entry.name.startsWith('.')) continue;
+        const r = `${rel}/${entry.name}`;
+        if (entry.isDirectory()) out.push(...listFiles(projectRoot, r));
+        else if (entry.isFile()) out.push(r);
+    }
+    return out;
+}
+
+export function roundUnion(projectRoot: string, roundId: string): RoundUnion {
+    if (!SEGMENT.test(roundId) || roundId.includes('..')) {
+        throw new InboxFinalError(`round id ${JSON.stringify(roundId)} is not a single folder name`);
+    }
+    const runtimeRel = `${RUNS_REL}/${roundId}`;
+    const runtime = listFiles(projectRoot, runtimeRel)
+        .filter((r) => !BOOKKEEPING.has(r.slice(runtimeRel.length + 1)))
+        .map((rel): RoundFile => ({ rel, origin: 'runtime' }));
+    const drops = listFiles(projectRoot, `${DROPS_REL}/${roundId}`).map((rel): RoundFile => ({ rel, origin: 'drop' }));
+    let lineage: Record<string, string[]> = {};
+    const manifest = path.join(projectRoot, runtimeRel, ROUND_MANIFEST);
+    if (fs.existsSync(manifest)) {
+        const data = JSON.parse(fs.readFileSync(manifest, 'utf8')) as { lineage?: unknown };
+        if (data.lineage !== undefined && (typeof data.lineage !== 'object' || data.lineage === null || Array.isArray(data.lineage))) {
+            throw new InboxFinalError(`${ROUND_MANIFEST} carries a lineage that is not a map`);
+        }
+        lineage = (data.lineage ?? {}) as Record<string, string[]>;
+    }
+    return { files: [...runtime, ...drops], lineage, renameBeforeTriage: !isOpaqueRoundId(roundId) };
+}
+
+export interface Directive {
+    id: string;
+    role: 'user' | 'assistant';
+    provenance: 'current-session' | 'transcript-structured' | 'transcript-recovered';
+    text: string;
+    /** Another input that contradicts this one, when there is one. */
+    contradictedBy?: string;
+}
+
+/** `binds` constrains the run; `batch` joins the owner's post-action batch (step 2.7); `claim` is verified like any claim. */
+export function directiveBinding(d: Directive): 'binds' | 'batch' | 'claim' {
+    if (d.role !== 'user') return 'claim';
+    if (d.provenance === 'current-session') return 'binds';
+    if (d.provenance === 'transcript-structured') return d.contradictedBy === undefined ? 'binds' : 'batch';
+    return 'batch';
+}
+
+export interface DirectiveCheck {
+    directive: string;
+    roadmap: string;
+    verdict: 'honoured' | 'violated' | 'not-applicable';
+    evidence: string;
+}
+
+export interface ConvergenceRow {
+    lens: 'convergence';
+    directives_checked: string[];
+    violated: string[];
+    checks: DirectiveCheck[];
+}
+
+export function convergenceRow(directives: readonly Directive[], checks: readonly DirectiveCheck[]): ConvergenceRow {
+    const binding = directives.filter((d) => directiveBinding(d) === 'binds').map((d) => d.id);
+    const checked = new Set(checks.filter((c) => c.evidence.trim() !== '').map((c) => c.directive));
+    const missing = binding.filter((id) => !checked.has(id));
+    if (missing.length > 0) throw new InboxFinalError(`final Convergence loop left binding directive(s) unchecked: ${missing.join(', ')}`);
+    const violated = [...new Set(checks.filter((c) => c.verdict === 'violated').map((c) => c.directive))];
+    return { lens: 'convergence', directives_checked: binding, violated, checks: [...checks] };
+}
+
+export interface Lane {
+    lane: string;
+    topics: string[];
+}
+
+/** First-fit by size into lanes under both thresholds; one lane when the round fits. */
+export function planLanes(topics: ReadonlyArray<{ topic: string; bytes: number }>): Lane[] {
+    const lanes: Array<Lane & { bytes: number }> = [];
+    for (const t of [...topics].sort((a, b) => b.bytes - a.bytes || a.topic.localeCompare(b.topic))) {
+        const fit = lanes.find((l) => l.topics.length < INBOX_LANE_MAX_TOPICS && l.bytes + t.bytes <= INBOX_LANE_MAX_BYTES);
+        if (fit !== undefined) {
+            fit.topics.push(t.topic);
+            fit.bytes += t.bytes;
+        } else {
+            lanes.push({ lane: '', topics: [t.topic], bytes: t.bytes });
+        }
+    }
+    return lanes.map((l, i) => ({ lane: `L${i + 1}`, topics: l.topics }));
+}
+
+export interface LaneLedger {
+    lane: string;
+    /** The lane's own anchor census — the denominator its reading cannot shrink. */
+    census: number;
+    points: Array<{ id: string; disposition: string }>;
+}
+
+export function foldLaneLedgers(lanes: readonly LaneLedger[]): { lanes: number; census: number; points: number } {
+    for (const l of lanes) {
+        if (l.census <= 0 || l.points.length === 0) {
+            throw new InboxFinalError(`lane ${l.lane} has no census or no point ledger of its own; a fold without one loses that lane`);
+        }
+    }
+    return {
+        lanes: lanes.length,
+        census: lanes.reduce((n, l) => n + l.census, 0),
+        points: lanes.reduce((n, l) => n + l.points.length, 0),
+    };
+}
diff --git a/src/scripts/analysis_pr_optimize.ts b/src/scripts/analysis_pr_optimize.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1bc2ccafe611dffa96353eac6620929881f77fb2
--- /dev/null
+++ b/src/scripts/analysis_pr_optimize.ts
@@ -0,0 +1,172 @@
+/**
+ * analysis_pr_optimize.ts — `analyze:pr --optimize` (step 5.3, ADR-288 D6).
+ *
+ * Eligibility first: an open PR whose head branch lives in this repository and
+ * is writable gets fixes pushed to it; anything else gets a patch file beside
+ * the verdict. Each fix carries exactly one test disposition. Every push is a
+ * compare-and-swap on the head the run last saw — a moved head stops the run
+ * before it pushes. Re-review after each push; stop when nothing new clears
+ * the threshold or after three rounds.
+ *
+ * The port has no merge and no approve: the flow cannot do either.
+ */
+import { execFileSync } from 'node:child_process';
+import * as fs from 'node:fs';
+import * as os from 'node:os';
+import * as path from 'node:path';
+
+import { assertRefName, PublishError } from './analysis_publish.js';
+
+export const MAX_OPTIMIZE_ROUNDS = 3;
+
+/** Why a fix ships without a test; the disprove pass reviews each one. */
+export const INFEASIBLE_REASONS = ['no-test-harness', 'nondeterministic', 'external-dependency', 'docs-only', 'config-only'] as const;
+
+const OBJECT_ID = /^(?:[0-9a-f]{40}|[0-9a-f]{64})$/;
+
+export class OptimizeError extends Error {}
+
+export interface PrBranch {
+    pr: number;
+    state: 'OPEN' | 'CLOSED' | 'MERGED';
+    headRefName: string;
+    headSha: string;
+    isCrossRepository: boolean;
+    viewerCanPush: boolean;
+}
+
+export type Eligibility = { kind: 'push'; branch: string } | { kind: 'patch'; reason: string };
+
+export type Disposition =
+    | { kind: 'regression-test-red'; test: string }
+    | { kind: 'existing-test-red'; test: string }
+    | { kind: 'static-check'; check: string }
+    | { kind: 'infeasible'; reasonCode: string; reviewedBy: string };
+
+export interface Fix {
+    findingKey: string;
+    disposition: Disposition;
+}
+
+export interface KeyedFinding {
+    key: string;
+}
+
+export interface OptimizePort {
+    remoteHead(branch: string): string | null;
+    /** Applies and commits the fixes locally; returns the new local head. */
+    applyFixes(fixes: readonly Fix[]): string;
+    /** Fails, changing nothing, unless the remote head is exactly `expected`. */
+    push(branch: string, expected: string): void;
+    /** Writes the fixes as a patch file; returns its path. */
+    writePatch(pr: number, fixes: readonly Fix[]): string;
+}
+
+export type OptimizeEnd = 'converged' | 'round-cap' | 'moved-head' | 'patch';
+
+export interface OptimizeResult {
+    end: OptimizeEnd;
+    rounds: number;
+    fixes: Fix[];
+    patch?: string;
+    reason?: string;
+}
+
+export function eligibility(pr: PrBranch): Eligibility {
+    if (pr.state !== 'OPEN') return { kind: 'patch', reason: `PR #${pr.pr} is ${pr.state.toLowerCase()}` };
+    if (pr.isCrossRepository) return { kind: 'patch', reason: `PR #${pr.pr} comes from a fork` };
+    if (!pr.viewerCanPush) return { kind: 'patch', reason: `the head branch of PR #${pr.pr} is not writable` };
+    try {
+        return { kind: 'push', branch: assertRefName(pr.headRefName, 'head branch') };
+    } catch (err) {
+        if (err instanceof PublishError) return { kind: 'patch', reason: err.message };
+        throw err;
+    }
+}
+
+function nonEmpty(s: string): boolean {
+    return s.trim() !== '';
+}
+
+function checkDispositions(findings: readonly KeyedFinding[], fixes: readonly Fix[]): void {
+    const wanted = new Set(findings.map((f) => f.key));
+    const seen = new Set<string>();
+    for (const fix of fixes) {
+        if (!wanted.has(fix.findingKey)) throw new OptimizeError(`fix for ${fix.findingKey} answers no finding of this round`);
+        if (seen.has(fix.findingKey)) throw new OptimizeError(`finding ${fix.findingKey} carries more than one disposition`);
+        seen.add(fix.findingKey);
+        const d = fix.disposition;
+        const ok =
+            d.kind === 'infeasible'
+                ? (INFEASIBLE_REASONS as readonly string[]).includes(d.reasonCode) && nonEmpty(d.reviewedBy)
+                : nonEmpty(d.kind === 'static-check' ? d.check : d.test);
+        if (!ok) throw new OptimizeError(`finding ${fix.findingKey} has an incomplete ${d.kind} disposition`);
+    }
+    const missing = [...wanted].filter((k) => !seen.has(k));
+    if (missing.length > 0) throw new OptimizeError(`no disposition for: ${missing.join(', ')}`);
+}
+
+export function optimizePr(
+    pr: PrBranch,
+    port: OptimizePort,
+    review: (headSha: string) => KeyedFinding[],
+    planFixes: (findings: KeyedFinding[]) => Fix[],
+): OptimizeResult {
+    if (!OBJECT_ID.test(pr.headSha)) throw new OptimizeError(`head SHA ${JSON.stringify(pr.headSha)} is not a full object id`);
+    const target = eligibility(pr);
+    const done: Fix[] = [];
+    const known = new Set<string>();
+    let expected = pr.headSha;
+    for (let rounds = 0; ; rounds += 1) {
+        const fresh = review(expected).filter((f) => !known.has(f.key));
+        if (fresh.length === 0) return { end: 'converged', rounds, fixes: done };
+        if (rounds >= MAX_OPTIMIZE_ROUNDS) return { end: 'round-cap', rounds, fixes: done };
+        const fixes = planFixes(fresh);
+        checkDispositions(fresh, fixes);
+        if (target.kind === 'patch') {
+            done.push(...fixes);
+            return { end: 'patch', rounds: rounds + 1, fixes: done, patch: port.writePatch(pr.pr, fixes), reason: target.reason };
+        }
+        const remote = port.remoteHead(target.branch);
+        if (remote !== expected) {
+            return { end: 'moved-head', rounds, fixes: done, reason: `${target.branch} is at ${String(remote)}, expected ${expected}` };
+        }
+        const next = port.applyFixes(fixes);
+        port.push(target.branch, expected);
+        for (const f of fresh) known.add(f.key);
+        done.push(...fixes);
+        expected = next;
+    }
+}
+
+/** The git + gh port a door uses: a leased fast-forward push, a patch file, nothing else. */
+export function gitOptimizePort(cwd: string, apply: (fixes: readonly Fix[]) => void): OptimizePort {
+    const run = (bin: string, args: string[]): string => execFileSync(bin, args, { cwd, encoding: 'utf8', stdio: 'pipe' }).trim();
+    return {
+        remoteHead: (branch) => {
+            const ref = `refs/heads/${assertRefName(branch, 'branch')}`;
+            const row = run('git', ['ls-remote', 'origin', ref])
+                .split('\n')
+                .map((l) => l.split(/\s+/))
+                .find((cols) => cols[1] === ref);
+            return row?.[0] ?? null;
+        },
+        applyFixes: (fixes) => {
+            apply(fixes);
+            run('git', ['commit', '-m', `fix: analyze:pr --optimize (${fixes.length} finding(s))`]);
+            return run('git', ['rev-parse', 'HEAD']);
+        },
+        push: (branch, expected) => {
+            const ref = `refs/heads/${assertRefName(branch, 'branch')}`;
+            if (!OBJECT_ID.test(expected)) throw new OptimizeError(`expected head ${JSON.stringify(expected)} is not a full object id`);
+            run('git', ['merge-base', '--is-ancestor', expected, 'HEAD']);
+            run('git', ['push', '--porcelain', `--force-with-lease=${ref}:${expected}`, 'origin', `HEAD:${ref}`]);
+        },
+        writePatch: (pr, fixes) => {
+            apply(fixes);
+            const file = path.join(fs.mkdtempSync(path.join(os.tmpdir(), 'analyze-pr-')), `pr-${pr}.patch`);
+            fs.writeFileSync(file, run('git', ['diff', '--no-color', '--no-ext-diff', 'HEAD']));
+            return file;
+        },
+    };
+}
diff --git a/src/scripts/analysis_pr_review.ts b/src/scripts/analysis_pr_review.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e954cdd405e9de07aac7a835b3f40a9a6a0fd4e4
--- /dev/null
+++ b/src/scripts/analysis_pr_review.ts
@@ -0,0 +1,214 @@
+/**
+ * analysis_pr_review.ts — the read-only verdict of `analyze:pr` (step 5.2,
+ * ADR-288 D1, D9).
+ *
+ * The PR head is read in a throwaway worktree, the analysts and seats propose
+ * candidate findings, a model of a different family tries to disprove each,
+ * and what survives the confidence threshold is folded and classified against
+ * `base..head`. Every remote effect goes through a `PrReviewPort`; the only
+ * write it has is a comment, and it runs only on `--comment`.
+ *
+ * Finding a defect is model work and stays with the door; this module decides
+ * what of it is reported, so a clean head reports "no finding above threshold"
+ * instead of a padded list.
+ */
+import { execFileSync } from 'node:child_process';
+import * as fs from 'node:fs';
+import * as os from 'node:os';
+import * as path from 'node:path';
+
+export const DEFAULT_CONFIDENCE_THRESHOLD = 0.7;
+
+const OBJECT_ID = /^(?:[0-9a-f]{40}|[0-9a-f]{64})$/;
+
+export class ReviewError extends Error {}
+
+export type Severity = 'critical' | 'high' | 'medium' | 'low';
+
+export interface CandidateFinding {
+    severity: Severity;
+    file: string;
+    line: number;
+    claim: string;
+    evidence: string;
+    fix: string;
+    /** The proposer's own confidence, 0..1. */
+    confidence: number;
+    /** A command, input or test that shows the defect; null when there is none. */
+    reproduction: string | null;
+    /** Model family of the analyst or seat that proposed it. */
+    family: string;
+}
+
+export interface DisproveResult {
+    refuted: boolean;
+    family: string;
+    note: string;
+}
+
+export interface PrFinding extends CandidateFinding {
+    origin: 'introduced' | 'pre-existing';
+    disprove_note: string;
+}
+
+export interface PrReviewPort {
+    /** A detached checkout of `headSha`; returns its path. */
+    openWorktree(headSha: string): string;
+    removeWorktree(worktree: string): void;
+    diff(baseSha: string, headSha: string): string;
+    comment(pr: number, body: string): void;
+}
+
+export interface PrReviewInput {
+    pr: number;
+    baseSha: string;
+    headSha: string;
+    comment: boolean;
+    threshold?: number;
+}
+
+export interface PrVerdict {
+    pr: number;
+    baseSha: string;
+    headSha: string;
+    findings: PrFinding[];
+    belowThreshold: number;
+    refuted: number;
+    duplicates: number;
+    /** ADR-288 D9 metric for this door: introduced findings that carry a reproduction or a test. */
+    metric: number;
+    text: string;
+}
+
+function assertObjectId(sha: string, what: string): string {
+    if (!OBJECT_ID.test(sha)) throw new ReviewError(`${what} ${JSON.stringify(sha)} is not a full object id`);
+    return sha;
+}
+
+/** Head-side line numbers added per file, read from a unified diff. */
+export function addedLines(diff: string): Map<string, Set<number>> {
+    const out = new Map<string, Set<number>>();
+    let file: string | null = null;
+    let line = 0;
+    for (const raw of diff.split('\n')) {
+        if (raw.startsWith('+++ ')) {
+            const target = raw.slice(4).trim();
+            file = target === '/dev/null' ? null : target.replace(/^b\//u, '');
+            continue;
+        }
+        if (raw.startsWith('--- ')) continue;
+        const hunk = /^@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@/u.exec(raw);
+        if (hunk !== null) {
+            line = Number(hunk[1]);
+            continue;
+        }
+        if (file === null || line === 0) continue;
+        if (raw.startsWith('+')) {
+            let set = out.get(file);
+            if (set === undefined) {
+                set = new Set();
+                out.set(file, set);
+            }
+            set.add(line);
+            line += 1;
+        } else if (raw.startsWith(' ')) {
+            line += 1;
+        }
+    }
+    return out;
+}
+
+function dedupeKey(f: CandidateFinding): string {
+    return `${f.file}:${f.line}:${f.claim.trim().replace(/\s+/gu, ' ').toLowerCase()}`;
+}
+
+export function renderVerdict(v: Omit<PrVerdict, 'text'>, threshold: number): string {
+    const head = `analyze:pr #${v.pr} at ${v.headSha.slice(0, 12)} (base ${v.baseSha.slice(0, 12)})`;
+    const tally = `refuted ${v.refuted} · below threshold ${v.belowThreshold} · folded duplicates ${v.duplicates}`;
+    if (v.findings.length === 0) return `${head}\n\nno finding above threshold (${threshold}) — ${tally}\n`;
+    const rows = v.findings.map(
+        (f) =>
+            `- **${f.severity}** \`${f.file}:${f.line}\` — ${f.claim}\n` +
+            `  - evidence: ${f.evidence}\n` +
+            `  - fix: ${f.fix}\n` +
+            `  - confidence: ${f.confidence} · ${f.origin === 'introduced' ? 'introduced here' : 'pre-existing'}` +
+            (f.reproduction === null ? '' : `\n  - reproduction: ${f.reproduction}`),
+    );
+    return `${head}\n\n${rows.join('\n')}\n\n${tally}\n`;
+}
+
+/** Read-only by default: the port's `comment` runs only when `input.comment` is set. */
+export function reviewPr(
+    input: PrReviewInput,
+    port: PrReviewPort,
+    analyse: (worktree: string, diff: string) => CandidateFinding[],
+    disprove: (finding: CandidateFinding) => DisproveResult,
+): PrVerdict {
+    const baseSha = assertObjectId(input.baseSha, 'base SHA');
+    const headSha = assertObjectId(input.headSha, 'head SHA');
+    const threshold = input.threshold ?? DEFAULT_CONFIDENCE_THRESHOLD;
+    const worktree = port.openWorktree(headSha);
+    let candidates: CandidateFinding[];
+    let diff: string;
+    try {
+        diff = port.diff(baseSha, headSha);
+        candidates = analyse(worktree, diff);
+    } finally {
+        port.removeWorktree(worktree);
+    }
+    const added = addedLines(diff);
+    let belowThreshold = 0;
+    let refuted = 0;
+    let duplicates = 0;
+    const kept = new Map<string, PrFinding>();
+    for (const f of candidates) {
+        if (f.confidence < threshold) {
+            belowThreshold += 1;
+            continue;
+        }
+        const d = disprove(f);
+        if (d.family === f.family) {
+            throw new ReviewError(`disprove pass for ${f.file}:${f.line} ran on the proposer's own family (${f.family})`);
+        }
+        if (d.refuted) {
+            refuted += 1;
+            continue;
+        }
+        const key = dedupeKey(f);
+        const prior = kept.get(key);
+        if (prior !== undefined) {
+            duplicates += 1;
+            if (prior.confidence >= f.confidence) continue;
+        }
+        const origin = added.get(f.file)?.has(f.line) === true ? 'introduced' : 'pre-existing';
+        kept.set(key, { ...f, origin, disprove_note: d.note });
+    }
+    const findings = [...kept.values()];
+    const metric = findings.filter((f) => f.origin === 'introduced' && f.reproduction !== null && f.reproduction.trim() !== '').length;
+    const base = { pr: input.pr, baseSha, headSha, findings, belowThreshold, refuted, duplicates, metric };
+    const text = renderVerdict(base, threshold);
+    if (input.comment) port.comment(input.pr, text);
+    return { ...base, text };
+}
+
+/** The git + gh port a door uses. Its one write is `gh pr comment`, reached only through `--comment`. */
+export function gitGhReviewPort(cwd: string): PrReviewPort {
+    const run = (bin: string, args: string[]): string => execFileSync(bin, args, { cwd, encoding: 'utf8', stdio: 'pipe' });
+    return {
+        openWorktree: (headSha) => {
+            const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'analyze-pr-'));
+            run('git', ['worktree', 'add', '--detach', dir, assertObjectId(headSha, 'head SHA')]);
+            return dir;
+        },
+        removeWorktree: (worktree) => {
+            run('git', ['worktree', 'remove', '--force', worktree]);
+        },
+        diff: (baseSha, headSha) =>
+            run('git', ['diff', '--no-color', '--no-ext-diff', `${assertObjectId(baseSha, 'base SHA')}..${assertObjectId(headSha, 'head SHA')}`]),
+        comment: (pr, body) => {
+            const file = path.join(fs.mkdtempSync(path.join(os.tmpdir(), 'analyze-pr-body-')), 'body.md');
+            fs.writeFileSync(file, body);
+            run('gh', ['pr', 'comment', String(pr), '--body-file', file]);
+        },
+    };
+}
