+function rowFor2(inv: ReturnType<typeof buildInventory>, wt: string) {
+    const row = inv.rows.find((r) => path.basename(r.path) === path.basename(wt));
+    if (row === undefined) throw new Error(`no inventory row for ${wt}`);
+    return row;
