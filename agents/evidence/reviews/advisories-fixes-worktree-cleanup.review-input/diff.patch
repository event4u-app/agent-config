diff --git a/src/config/agent-settings.template.yml b/src/config/agent-settings.template.yml
index 9a9185f57b91c32fafb6a9c13127e636af29be50..a2bb016a847efaa5e9857f8d3b0151b61de11c7c 100644
--- a/src/config/agent-settings.template.yml
+++ b/src/config/agent-settings.template.yml
@@ -921,6 +921,25 @@ subagents:
 #
 # The Iron-Law gates on creation (ignore-safety check, clean baseline) are
 # unchanged and still run on every explicitly-requested worktree.
+#
+# Removal is a different question, and it has a setting. What the agent may do
+# about a worktree whose work is provably on the trunk — merged (merge commit,
+# rebase or squash), clean, holding no ignored file a rebuild would not restore,
+# and with no live session in it:
+#
+#   notify  say once a day how many such worktrees exist; remove nothing
+#           (the default, and what an absent key resolves to)
+#   auto    remove them: right after `/pr:merge`, and once a day on the first
+#           session start (three-second budget, `git worktree remove` without
+#           force, local branches always kept, one journal line per removal)
+#   off     say nothing, remove nothing
+#
+# The daily pass asks GitHub, through your own gh login, which pull requests
+# merged (branch name and head commit only) — that is how a squash merge is
+# recognised. `auto` deletes directories; that is why it is yours to turn on
+# (ADR-295).
+worktrees:
+  cleanup: notify
 
 # --- AI Council (external second-opinion network) ---
 #
@@ -1497,6 +1516,28 @@ decision_engine:
 update_check:
   enabled: true
 
+# --- Security advisories ---
+#
+# Advisories, malware reports, end-of-support dates and pre-announced security
+# releases for what THIS project runs (lockfiles, runtimes, images, CI actions).
+#
+# mode:
+#   notify  (default) the first session start of a day prints one line per
+#           finding that needs action today, read from the local cache only —
+#           a session start never touches the network
+#   off     print nothing; `agent-config audit:deps show` still works
+#
+# egress — what leaves the machine when `agent-config audit:deps refresh` runs:
+#   query   (default) names and versions of PUBLIC packages go to api.osv.dev;
+#           runtime lifecycle data comes from endoflife.date; the PHP and Node
+#           release feeds are read. A private package name is never sent, and a
+#           native `npm audit` / `composer audit` runs only for a lockfile with no
+#           private package in it
+#   none    nothing is sent; findings read `unknown`, never "clear"
+advisories:
+  mode: notify
+  egress: query
+
 # --- Update install mode ---
 #
 # What the agent may DO about a newer release, as opposed to whether it
