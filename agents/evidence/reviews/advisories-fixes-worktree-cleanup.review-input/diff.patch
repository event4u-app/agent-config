+            const t = (tier: string): number => r.state.findings.filter((f) => f.tier === tier).length;
+            process.stdout.write(
+                `${r.state.root}: ${r.reason} · T0 ${t('T0')} · T1 ${t('T1')} · T2 ${t('T2')} · T3 ${t('T3')} · ` +
+                    `sources ${r.state.reports.map((x) => `${x.source}=${x.status}`).join(' ')}\n`,
+            );
+        }
+        return 0;
+    }
+    if (mode === 'show') {
