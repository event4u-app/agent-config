diff --git a/src/scripts/_lib/advisory_inventory.ts b/src/scripts/_lib/advisory_inventory.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a464b739095a342f01ed96f194abe309abdbf71a
--- /dev/null
+++ b/src/scripts/_lib/advisory_inventory.ts
@@ -0,0 +1,386 @@
+/**
+ * What a project actually runs — the input to every advisory question
+ * (road-to-advisories-heard-the-same-day Phase 1).
+ *
+ * Deterministic and offline: it reads files, never a network and never a
+ * package manager. Each entry carries the `file:line` it was read from and a
+ * provenance, because a declared range and a deployed version are different
+ * claims: `composer.json` saying `"php": "^8.3"` is not the PHP a Dockerfile
+ * pins, and reporting one as the other is the confusion the roadmap names.
+ *
+ * Private names (path / link / VCS dependencies, packages from a registry other
+ * than the public one) are marked here, once, so no later stage has to decide
+ * it again — every outbound query filters on this flag (D4).
+ */
+
+import { createHash } from 'node:crypto';
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+
+export type Ecosystem = 'npm' | 'Packagist' | 'GitHub Actions' | 'runtime' | 'manager' | 'image';
+export type Provenance = 'lockfile' | 'declared' | 'image' | 'ci';
+
+export interface InventoryEntry {
+    ecosystem: Ecosystem;
+    /** Package name, runtime (`php`, `node`), manager (`npm`, `composer`), or image. */
+    name: string;
+    /** Exact version when the source pins one, else `null`. */
+    version: string | null;
+    /** The declared range when the source only constrains, else `null`. */
+    range: string | null;
+    provenance: Provenance;
+    /** Repo-relative path of the file read. */
+    file: string;
+    line: number;
+    /** Never sent to a public service. */
+    private: boolean;
+    /** `dev` for development-only lockfile packages; `null` where unknown. */
+    scope: 'runtime' | 'dev' | null;
+}
+
+export interface Inventory {
+    entries: InventoryEntry[];
+    /** sha256 over every file read, in order. */
+    hash: string;
+    /** `inventoryFingerprint` at read time — the cheap reuse check (1.2). */
+    fingerprint: string;
+    files: string[];
+}
+
+const SKIP_DIRS = new Set(['node_modules', '.git', 'vendor', 'dist', '.claude', '.worktrees', 'coverage', '.next']);
+const MAX_DEPTH = 4;
+
+function lineOf(text: string, needle: string): number {
+    const i = text.indexOf(needle);
+    return i < 0 ? 1 : text.slice(0, i).split('\n').length;
+}
+
+/** Repo-relative files whose basename matches, walked to a bounded depth. */
+function walk(root: string, match: (name: string, rel: string) => boolean): string[] {
+    const out: string[] = [];
+    const visit = (dir: string, depth: number): void => {
+        let names: fs.Dirent[];
+        try {
+            names = fs.readdirSync(dir, { withFileTypes: true });
+        } catch {
+            return;
+        }
+        for (const d of names) {
+            const abs = path.join(dir, d.name);
+            const rel = path.relative(root, abs);
+            if (d.isDirectory()) {
+                if (depth < MAX_DEPTH && !SKIP_DIRS.has(d.name)) visit(abs, depth + 1);
+            } else if (d.isFile() && match(d.name, rel)) {
+                out.push(rel);
+            }
+        }
+    };
+    visit(root, 0);
+    return out.sort();
+}
+
+const PUBLIC_NPM = /^https:\/\/registry\.npmjs\.org\//;
+
+/** package-lock.json v2/v3 — the `packages` map is the resolved tree. */
+function readNpmLock(rel: string, text: string): InventoryEntry[] {
+    let doc: { packages?: Record<string, { version?: string; resolved?: string; dev?: boolean; link?: boolean }> };
+    try {
+        doc = JSON.parse(text);
+    } catch {
+        return [];
+    }
+    const out: InventoryEntry[] = [];
+    for (const [key, pkg] of Object.entries(doc.packages ?? {})) {
+        if (key === '' || typeof pkg?.version !== 'string') continue;
+        const name = key.replace(/^.*node_modules\//, '');
+        const resolved = typeof pkg.resolved === 'string' ? pkg.resolved : '';
+        out.push({
+            ecosystem: 'npm',
+            name,
+            version: pkg.version,
+            range: null,
+            provenance: 'lockfile',
+            file: rel,
+            line: lineOf(text, `"${key}": {`),
+            private: pkg.link === true || !PUBLIC_NPM.test(resolved),
+            scope: pkg.dev === true ? 'dev' : 'runtime',
+        });
+    }
+    return out;
+}
+
+/** composer.lock — a package without the public Packagist notification URL is private. */
+function readComposerLock(rel: string, text: string): InventoryEntry[] {
+    type Pkg = { name?: string; version?: string; 'notification-url'?: string };
+    let doc: { packages?: Pkg[]; 'packages-dev'?: Pkg[] };
+    try {
+        doc = JSON.parse(text);
+    } catch {
+        return [];
+    }
+    const out: InventoryEntry[] = [];
+    for (const [list, scope] of [
+        [doc.packages ?? [], 'runtime'],
+        [doc['packages-dev'] ?? [], 'dev'],
+    ] as const) {
+        for (const p of list) {
+            if (typeof p.name !== 'string' || typeof p.version !== 'string') continue;
+            out.push({
+                ecosystem: 'Packagist',
+                name: p.name,
+                version: p.version.replace(/^v(?=\d)/, ''),
+                range: null,
+                provenance: 'lockfile',
+                file: rel,
+                line: lineOf(text, `"name": "${p.name}"`),
+                private: p['notification-url'] !== 'https://packagist.org/downloads/',
+                scope,
+            });
+        }
+    }
+    return out;
+}
+
+function runtime(
+    name: string,
+    value: string,
+    provenance: Provenance,
+    file: string,
+    line: number,
+): InventoryEntry {
+    const v = value.trim();
+    const exact = /^v?\d+(\.\d+){0,2}([-+.][0-9A-Za-z.]+)*$/.test(v);
+    return {
+        ecosystem: 'runtime',
+        name,
+        version: exact ? v.replace(/^v/, '') : null,
+        range: exact ? null : v,
+        provenance,
+        file,
+        line,
+        private: false,
+        scope: 'runtime',
+    };
+}
+
+function readComposerJson(rel: string, text: string): InventoryEntry[] {
+    let doc: { require?: Record<string, string>; config?: { platform?: Record<string, string> } };
+    try {
+        doc = JSON.parse(text);
+    } catch {
+        return [];
+    }
+    const out: InventoryEntry[] = [];
+    const req = doc.require?.['php'];
+    if (typeof req === 'string') out.push(runtime('php', req, 'declared', rel, lineOf(text, '"php"')));
+    const platform = doc.config?.platform?.['php'];
+    if (typeof platform === 'string') {
+        out.push(runtime('php', platform, 'declared', rel, lineOf(text, '"platform"')));
+    }
+    return out;
+}
+
+function readPackageJson(rel: string, text: string): InventoryEntry[] {
+    let doc: {
+        engines?: Record<string, string>;
+        packageManager?: string;
+        dependencies?: Record<string, string>;
+        devDependencies?: Record<string, string>;
+    };
+    try {
+        doc = JSON.parse(text);
+    } catch {
+        return [];
+    }
+    const out: InventoryEntry[] = [];
+    // Direct dependencies, as declared ranges: what decides whether a fix is a
+    // range bump of a direct dependency or an override of a transitive one.
+    // A range is never queried as if it were a version.
+    for (const [deps, scope] of [
+        [doc.dependencies ?? {}, 'runtime'],
+        [doc.devDependencies ?? {}, 'dev'],
+    ] as const) {
+        for (const [name, spec] of Object.entries(deps)) {
+            if (typeof spec !== 'string') continue;
+            out.push({
+                ecosystem: 'npm',
+                name,
+                version: null,
+                range: spec,
+                provenance: 'declared',
+                file: rel,
+                line: lineOf(text, `"${name}"`),
+                private: /^(file:|link:|git|github:|workspace:|\.|\/)/.test(spec),
+                scope,
+            });
+        }
+    }
+    const node = doc.engines?.['node'];
+    if (typeof node === 'string') out.push(runtime('node', node, 'declared', rel, lineOf(text, '"engines"')));
+    const pm = /^(npm|pnpm|yarn|bun)@(\d[^+\s]*)/.exec(doc.packageManager ?? '');
+    if (pm) {
+        out.push({
+            ecosystem: 'manager',
+            name: pm[1]!,
+            version: pm[2]!,
+            range: null,
+            provenance: 'declared',
+            file: rel,
+            line: lineOf(text, '"packageManager"'),
+            private: false,
+            scope: 'runtime',
+        });
+    }
+    return out;
+}
+
+/** `.nvmrc`, `.node-version`, `.php-version` — one version, first non-comment line. */
+function readVersionFile(rel: string, text: string, name: 'node' | 'php'): InventoryEntry[] {
+    const lines = text.split('\n');
+    const i = lines.findIndex((l) => l.trim() !== '' && !l.trim().startsWith('#'));
+    return i < 0 ? [] : [runtime(name, lines[i]!.trim(), 'declared', rel, i + 1)];
+}
+
+/** `.tool-versions` (asdf) and `mise.toml` [tools]. */
+function readToolVersions(rel: string, text: string): InventoryEntry[] {
+    const out: InventoryEntry[] = [];
+    text.split('\n').forEach((raw, i) => {
+        const l = raw.replace(/#.*/, '').trim();
+        const asdf = /^(nodejs|node|php)\s+(\S+)/.exec(l);
+        const mise = /^(node|php)\s*=\s*["']?([^"'\s]+)["']?/.exec(l);
+        const m = asdf ?? mise;
+        if (m) out.push(runtime(m[1] === 'nodejs' ? 'node' : m[1]!, m[2]!, 'declared', rel, i + 1));
+    });
+    return out;
+}
+
+/**
+ * An official `php` or `node` image tag names the runtime it ships
+ * (`php:8.3.12-fpm` → php 8.3.12). Any other image is recorded as an image,
+ * never guessed into a runtime.
+ */
+function imageEntry(ref: string, provenance: Provenance, file: string, line: number): InventoryEntry {
+    // Anchored: the image NAME must be exactly php or node (phpmyadmin, nodered/node-red are not).
+    const m = /^(?:docker\.io\/)?(?:library\/)?(php|node)(?::([^@\s]+))?(?:@\S+)?$/.exec(ref);
+    if (m) {
+        const tag = m[2] ?? 'latest';
+        const num = /^(\d+(?:\.\d+){0,2})/.exec(tag);
+        return runtime(m[1]!, num ? num[1]! : tag, provenance, file, line);
+    }
+    const [name, tag] = ref.split(/[:@]/, 2) as [string, string | undefined];
+    return {
+        ecosystem: 'image',
+        name,
+        version: tag ?? null,
+        range: null,
+        provenance,
+        file,
+        line,
+        private: false,
+        scope: 'runtime',
+    };
+}
+
+function readDockerfile(rel: string, text: string): InventoryEntry[] {
+    const out: InventoryEntry[] = [];
+    text.split('\n').forEach((raw, i) => {
+        const m = /^\s*FROM\s+(?:--platform=\S+\s+)?(\S+)/i.exec(raw);
+        if (m && !m[1]!.startsWith('$') && m[1] !== 'scratch') out.push(imageEntry(m[1]!, 'image', rel, i + 1));
+    });
+    return out;
+}
+
+/** Compose files and CI workflows: `image:` lines, runtime setup keys, action pins. */
+function readYaml(rel: string, text: string, ci: boolean): InventoryEntry[] {
+    const out: InventoryEntry[] = [];
+    const prov: Provenance = ci ? 'ci' : 'image';
+    text.split('\n').forEach((raw, i) => {
+        const l = raw.replace(/\s#.*$/, '');
+        const img = /^\s*image:\s*["']?([^"'\s]+)["']?\s*$/.exec(l);
+        if (img && !img[1]!.includes('${')) out.push(imageEntry(img[1]!, prov, rel, i + 1));
+        if (!ci) return;
+        const setup = /^\s*(node-version|php-version):\s*["']?([^"'\s[\]]+)["']?\s*$/.exec(l);
+        if (setup && !setup[2]!.includes('${')) {
+            out.push(runtime(setup[1] === 'node-version' ? 'node' : 'php', setup[2]!, 'ci', rel, i + 1));
+        }
+        const uses = /^\s*-?\s*uses:\s*["']?([\w.-]+\/[\w./-]+)@([^"'\s]+)["']?/.exec(l);
+        if (uses) {
+            out.push({
+                ecosystem: 'GitHub Actions',
+                name: uses[1]!,
+                version: uses[2]!,
+                range: null,
+                provenance: 'ci',
+                file: rel,
+                line: i + 1,
+                private: false,
+                scope: 'runtime',
+            });
+        }
+    });
+    return out;
+}
+
+/** Every file this reader consults, with the parser for it. */
+function sources(root: string): Array<{ rel: string; parse: (rel: string, text: string) => InventoryEntry[] }> {
+    const list: Array<{ rel: string; parse: (rel: string, text: string) => InventoryEntry[] }> = [];
+    const add = (rels: string[], parse: (rel: string, text: string) => InventoryEntry[]): void => {
+        for (const rel of rels) list.push({ rel, parse });
+    };
+    add(walk(root, (n) => n === 'package-lock.json'), readNpmLock);
+    add(walk(root, (n) => n === 'composer.lock'), readComposerLock);
+    add(walk(root, (n) => n === 'composer.json'), readComposerJson);
+    add(walk(root, (n) => n === 'package.json'), readPackageJson);
+    add(walk(root, (n) => n === '.nvmrc' || n === '.node-version'), (r, t) => readVersionFile(r, t, 'node'));
+    add(walk(root, (n) => n === '.php-version'), (r, t) => readVersionFile(r, t, 'php'));
+    add(walk(root, (n) => n === '.tool-versions' || n === 'mise.toml' || n === '.mise.toml'), readToolVersions);
+    add(walk(root, (n) => /^Dockerfile(\..+)?$/.test(n) || n.endsWith('.Dockerfile')), readDockerfile);
+    add(walk(root, (n) => /^(docker-)?compose(\.[\w-]+)?\.ya?ml$/.test(n)), (r, t) => readYaml(r, t, false));
+    add(
+        walk(root, (_n, rel) => /^\.github[\\/]workflows[\\/][^\\/]+\.ya?ml$/.test(rel)),
+        (r, t) => readYaml(r, t, true),
+    );
+    return list;
+}
+
+/** Read the whole inventory. Unreadable files are skipped, never guessed. */
+export function readInventory(root: string): Inventory {
+    const hash = createHash('sha256');
+    const finger = createHash('sha256');
+    const entries: InventoryEntry[] = [];
+    const files: string[] = [];
+    for (const { rel, parse } of sources(root)) {
+        let text: string;
+        let st: fs.Stats;
+        try {
+            st = fs.statSync(path.join(root, rel));
+            text = fs.readFileSync(path.join(root, rel), 'utf-8');
+        } catch {
+            continue;
+        }
+        files.push(rel);
+        hash.update(`${rel}\0${text}\0`);
+        finger.update(`${rel}\0${st.size}\0${st.mtimeMs}\0`);
+        entries.push(...parse(rel, text));
+    }
+    // The same fingerprint `inventoryFingerprint` computes, from the same walk.
+    return { entries, hash: hash.digest('hex'), fingerprint: finger.digest('hex'), files };
+}
+
+/**
+ * A fingerprint over every source file's path, size and mtime — never its
+ * body. Equal to the stored one means the stored inventory is still current,
+ * and no lockfile is read at all (1.2).
+ */
+export function inventoryFingerprint(root: string): string {
+    const hash = createHash('sha256');
+    for (const { rel } of sources(root)) {
+        try {
+            const st = fs.statSync(path.join(root, rel));
+            hash.update(`${rel}\0${st.size}\0${st.mtimeMs}\0`);
+        } catch {
+            /* an unreadable file is absent from both the fingerprint and the inventory */
+        }
+    }
+    return hash.digest('hex');
+}
diff --git a/src/scripts/_lib/advisory_notice.ts b/src/scripts/_lib/advisory_notice.ts
new file mode 100644
index 0000000000000000000000000000000000000000..dec9bfa1d25aee897f77b7914f73cf77d1a20af1
--- /dev/null
+++ b/src/scripts/_lib/advisory_notice.ts
@@ -0,0 +1,233 @@
+/**
+ * The read-only half of advisories — what a session start may do
+ * (road-to-advisories-heard-the-same-day Phase 4).
+ *
+ * Kept apart from `advisories.ts` on purpose: this module is inlined into the
+ * hook bundle, and it holds no network code at all — no fetch, no process
+ * spawn. A session start reads one cache file, prints at most a few lines, and
+ * writes one "already shown today" stamp. Everything that touches the network
+ * lives in `advisories.ts`, which a hook never imports.
+ */
+
+import { createHash } from 'node:crypto';
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+
+import { load_agent_settings, settings_layer_states } from './agent_settings.js';
+import type { InventoryEntry } from './advisory_inventory.js';
+import type { SourceReport } from './advisory_sources.js';
+import type { Acceptance, Finding, Ledger } from './advisory_verdicts.js';
+import { git_common_dir } from './git_common_dir.js';
+import { mergedNotDeployed, type Remediations } from './security_fix.js';
+
+export type AdvisoriesMode = 'notify' | 'off';
+export type AdvisoriesEgress = 'query' | 'none';
+export type AdvisoriesKev = 'on' | 'off';
+
+/** Advisory data older than this makes the notice say so instead of looking current. */
+export const STALE_AFTER_HOURS = 24;
+/** Three days of a silent source is itself a notice (4.4). */
+export const SILENCE_NOTICE_DAYS = 3;
+
+export interface AdvisoryState {
+    schema: 1;
+    root: string;
+    at: string;
+    fingerprint: string;
+    /** The egress setting this state was refreshed under. */
+    egress?: AdvisoriesEgress;
+    inventory: InventoryEntry[];
+    findings: Finding[];
+    reports: SourceReport[];
+    ledger: Ledger;
+    acceptances: Acceptance[];
+    /** What the last refresh decided to announce; the session start prints it once. */
+    notice: { at: string; interrupt: string[]; digest: number } | null;
+    /** First time each source went silent, for the 4.4 silence notice. */
+    silent_since: Record<string, string>;
+    /** Fixes in flight and their lifecycle (road-to-security-fixes-carried-to-the-merge Phase 3). */
+    remediations?: Remediations;
+}
+
+export function readAdvisorySettings(root: string): { mode: AdvisoriesMode; egress: AdvisoriesEgress; kev: AdvisoriesKev } {
+    try {
+        if (settings_layer_states({ cwd: root }).some((l) => l.state === 'malformed')) return { mode: 'off', egress: 'none', kev: 'off' };
+        const section = load_agent_settings({ cwd: root })['advisories'];
+        const s = section !== null && typeof section === 'object' && !Array.isArray(section) ? (section as Record<string, unknown>) : {};
+        return {
+            mode: s['mode'] === 'off' ? 'off' : 'notify',
+            egress: s['egress'] === 'none' ? 'none' : 'query',
+            kev: s['kev'] === 'off' ? 'off' : 'on',
+        };
+    } catch {
+        return { mode: 'off', egress: 'none', kev: 'off' };
+    }
+}
+
+/**
+ * One cache per checkout. The git common dir is shared by every worktree of a
+ * repository, so the file is keyed by the checkout's own real path: a refresh
+ * inside a fix worktree describes that branch and never overwrites the main
+ * checkout's findings.
+ */
+export function statePath(root: string): string | null {
+    const common = git_common_dir(root);
+    if (common === null) return null;
+    let real = path.resolve(root);
+    try {
+        real = fs.realpathSync(root);
+    } catch {
+        /* a vanished checkout still gets a stable key from its resolved path */
+    }
+    const key = createHash('sha256').update(real).digest('hex').slice(0, 16);
+    return path.join(common, 'agent-config', 'advisories', `${key}.json`);
+}
+
+export function readState(root: string): AdvisoryState | null {
+    const p = statePath(root);
+    if (p === null) return null;
+    try {
+        const doc = JSON.parse(fs.readFileSync(p, 'utf-8')) as AdvisoryState;
+        return isState(doc) ? doc : null;
+    } catch {
+        return null;
+    }
+}
+
+const isObject = (v: unknown): v is Record<string, unknown> => v !== null && typeof v === 'object' && !Array.isArray(v);
+
+/** The shape every reader below relies on; a cache that is not it is no cache. */
+function isState(doc: unknown): doc is AdvisoryState {
+    if (!isObject(doc) || doc['schema'] !== 1 || typeof doc['at'] !== 'string') return false;
+    if (!Array.isArray(doc['findings']) || !doc['findings'].every((f) => isObject(f) && typeof f['key'] === 'string')) return false;
+    const n = doc['notice'];
+    if (n !== null && n !== undefined && !(isObject(n) && Array.isArray(n['interrupt']) && typeof n['digest'] === 'number')) return false;
+    if (doc['silent_since'] !== undefined && !isObject(doc['silent_since'])) return false;
+    if (doc['remediations'] !== undefined && !isObject(doc['remediations'])) return false;
+    return true;
+}
+
+/** Most lines a session start prints, whatever the cache holds. */
+export const MAX_NOTICE_LINES = 8;
+
+/**
+ * Every field a session line carries comes from a cache file on disk, and the
+ * line lands in privileged session context. JSON encoding protects the file's
+ * framing, not what the decoded string says — so each field is checked against
+ * a strict single-line grammar with a length cap before it is printed, and a
+ * field that fails is replaced, never passed through (council 2026-10-21, round 2).
+ */
+const FIELD = /^[A-Za-z0-9@._:/+~^<>=*-]{1,200}$/;
+
+export function safeField(v: unknown, max = 80): string {
+    if (typeof v === 'number' && Number.isInteger(v) && v >= 0 && v < 10_000_000) return String(v);
+    if (typeof v !== 'string' || v.length > max || !FIELD.test(v)) return '?';
+    return v;
+}
+
+const TIERS = new Set(['T0', 'T1', 'T2', 'T3']);
+const VERDICTS = new Set([
+    'affected', 'fix-available', 'fix-fresh', 'no-fix', 'malware', 'eol', 'eol-soon', 'pre-announced', 'unknown', 'accepted',
+]);
+
+function enumField(v: unknown, allowed: Set<string>): string {
+    return typeof v === 'string' && allowed.has(v) ? v : '?';
+}
+
+function where(f: Finding): string {
+    return f.file === '' ? '' : ` (${safeField(f.file, 200)}:${safeField(f.line)})`;
+}
+
+export function describe(f: Finding): string {
+    const tier = enumField(f.tier, TIERS);
+    const verdict = enumField(f.verdict, VERDICTS);
+    const pkg = safeField(f.package);
+    const ver = f.version === null ? '' : ` ${safeField(f.version)}`;
+    const fix = f.fixed === null ? '' : ` → ${safeField(f.fixed)}`;
+    const date = safeField(f.date);
+    const ids = [f.id, ...(Array.isArray(f.aliases) ? f.aliases : [])].slice(0, 3).map((i) => safeField(i)).join(', ');
+    // Provenance of the tier: "known exploited" is a fact, never a prediction.
+    const kev = f.kev === true ? ' — known exploited (KEV)' : '';
+    switch (verdict) {
+        case 'pre-announced':
+            return `${tier} ${pkg}: a security release is pre-announced (${date}); fixed versions not yet named${where(f)}`;
+        case 'eol':
+            return `${tier} ${pkg}${ver}: security support ended ${date}${where(f)}`;
+        case 'eol-soon':
+            return `${tier} ${pkg}${ver}: security support ends ${date}${where(f)}`;
+        case 'unknown':
+            if (typeof f.note === 'string' && f.note.includes('egress-none')) return `${tier} ${pkg}: not checked — advisories.egress is none`;
+            if (typeof f.note === 'string' && f.note.startsWith('vendor-patched')) return `${tier} ${pkg}${ver}: distro-patched — judge it by the distro's own advisory${where(f)}`;
+            return `${tier} ${pkg}: unknown — the source did not answer`;
+        default:
+            return `${tier} ${pkg}${ver}${fix} [${verdict}] ${ids}${kev}${where(f)}`;
+    }
+}
+
+/**
+ * The session notice — computed from the cache, never from the network, and
+ * never an action. Each T0/T1 line ends in the offer; the routing behind the
+ * offer is owned by road-to-security-fixes-carried-to-the-merge.
+ */
+export function noticeLines(state: AdvisoryState | null, now: Date = new Date()): string[] {
+    if (state === null) return [];
+    const lines: string[] = [];
+    // An unreadable or future timestamp proves nothing about freshness: stale.
+    const atMs = Date.parse(state.at);
+    const ageH = Number.isFinite(atMs) && atMs <= now.getTime() ? (now.getTime() - atMs) / 3600000 : Number.POSITIVE_INFINITY;
+    const byKey = new Map(state.findings.map((f) => [f.key, f]));
+    const pending = state.notice?.interrupt.map((k) => byKey.get(k)).filter((f): f is Finding => f !== undefined) ?? [];
+    for (const f of pending) {
+        lines.push(`advisory ${describe(f)} — fix now: /audit deps fix ${safeField(f.id)} (here or in its own worktree), or later`);
+    }
+    if ((state.notice?.digest ?? 0) > 0) lines.push(`advisories: ${safeField(state.notice!.digest)} more in the digest — /audit deps`);
+    for (const [source, since] of Object.entries(state.silent_since ?? {}).slice(0, 4)) {
+        const sinceMs = Date.parse(String(since));
+        if (!Number.isFinite(sinceMs) || sinceMs > now.getTime()) {
+            lines.push(`advisories: ${safeField(source)} silent since an unreadable date — findings from it are unknown, not clear`);
+            continue;
+        }
+        const days = (now.getTime() - sinceMs) / 86400000;
+        if (days >= SILENCE_NOTICE_DAYS) lines.push(`advisories: ${safeField(source)} has not answered for ${Math.floor(days)} days — findings from it are unknown, not clear`);
+    }
+    for (const u of mergedNotDeployed(state.remediations ?? {}, state.findings, now)) {
+        const sha = u.mergeSha === null ? '' : ` (${safeField(u.mergeSha.slice(0, 12))})`;
+        lines.push(`advisory ${safeField(u.id)}: merged${sha} but not deployed for ${safeField(u.hours)} h — deploy it the way this project deploys`);
+    }
+    if (ageH === Number.POSITIVE_INFINITY) {
+        lines.push('advisories: data age unreadable — run `agent-config audit:deps refresh`');
+    } else if (ageH >= STALE_AFTER_HOURS) {
+        lines.push(`advisories: data is ${Math.floor(ageH / 24) || 1} day(s) old — run \`agent-config audit:deps refresh\``);
+    }
+    return lines.length > MAX_NOTICE_LINES ? [...lines.slice(0, MAX_NOTICE_LINES - 1), `advisories: ${lines.length - MAX_NOTICE_LINES + 1} more — /audit deps`] : lines;
+}
+
+/** Shown once per notice: the stamp records which notice this checkout already printed. */
+export function sessionNotice(root: string, now: Date = new Date()): string | null {
+    if (readAdvisorySettings(root).mode === 'off') return null;
+    const state = readState(root);
+    if (state === null) return null;
+    const stamp = statePath(root) + '.shown';
+    let shown = '';
+    try {
+        shown = fs.readFileSync(stamp, 'utf-8').trim();
+    } catch {
+        shown = '';
+    }
+    const lines = noticeLines(state, now);
+    if (lines.length === 0) return null;
+    // Keyed by what would be printed, not only by when: a same-day change in a
+    // silence, a remediation or staleness is a new notice.
+    // Hours and days counted up since the last print are not a new notice; the
+    // hash ignores the numbers that only age.
+    const stable = lines.map((l) => l.replace(/\b\d+ (?:h|days?|day\(s\))\b/g, '#')).join('\n');
+    const id = `${now.toISOString().slice(0, 10)}|${createHash('sha256').update(stable).digest('hex').slice(0, 16)}`;
+    if (shown === id) return null;
+    try {
+        fs.writeFileSync(stamp, `${id}\n`);
+    } catch {
+        /* an unwritable stamp means the line may show twice; never a failure */
+    }
+    return lines.join('\n');
+}
+
diff --git a/src/scripts/_lib/advisory_sources.ts b/src/scripts/_lib/advisory_sources.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6c4697eadf8e101f7338ce8f28c206d0613eca59
--- /dev/null
+++ b/src/scripts/_lib/advisory_sources.ts
@@ -0,0 +1,690 @@
+/**
+ * Ask the authorities, carry nothing (road-to-advisories-heard-the-same-day
+ * Phase 2).
+ *
+ * Every adapter reports `ok | unavailable | error` — a timeout is never `ok`,
+ * and "no findings" from a source that did not answer is never "no findings".
+ * Every outbound request goes to a host on a fixed allowlist; no URL is built
+ * from fetched content except an advisory ID that passed a strict shape check.
+ * What leaves an adapter is IDs, versions, enums and numbers only — no advisory
+ * prose — because the cache is the sanitising boundary (C3): nothing fetched
+ * may reach model context as text.
+ *
+ * Transport and process execution are injected, so every adapter runs offline
+ * against fixtures in tests.
+ */
+
+// egress-content: fixed-corpus — sends public package names and versions read from the project's lockfiles to api.osv.dev, and plain GETs to endoflife.date, the PHP/Node feeds and the whole CISA KEV catalog; never session content, never a private package name
+
+import { execFileSync } from 'node:child_process';
+import * as path from 'node:path';
+
+import type { Ecosystem, InventoryEntry } from './advisory_inventory.js';
+import { compare_versions } from './version_order.js';
+
+export type SourceName = 'native-npm' | 'native-composer' | 'osv' | 'lifecycle' | 'vendor-php' | 'vendor-node' | 'kev';
+export type SourceStatus = 'ok' | 'unavailable' | 'error';
+
+export interface SourceReport {
+    source: SourceName;
+    status: SourceStatus;
+    /** A short machine reason (`timeout`, `http-503`, `private-names-present`), never fetched text. */
+    reason: string | null;
+}
+
+export type FindingKind = 'vulnerability' | 'malware' | 'eol' | 'eol-soon' | 'pre-announced' | 'outdated';
+export type Severity = 'low' | 'moderate' | 'high' | 'critical' | null;
+
+/** One finding as a source reported it. IDs, versions, enums and numbers only. */
+export interface RawFinding {
+    id: string;
+    aliases: string[];
+    kind: FindingKind;
+    ecosystem: Ecosystem;
+    package: string;
+    version: string | null;
+    severity: Severity;
+    /** CVSS base score when the source states one numerically. */
+    score: number | null;
+    /** Known exploited (CISA KEV) — only when a source asserts it. */
+    kev: boolean;
+    /** Smallest version that fixes it for this package, when known. */
+    fixed: string | null;
+    /** End of security support or announced release date (ISO day), for lifecycle and vendor findings. */
+    date: string | null;
+    source: SourceName;
+    /** Source-side `modified` stamp, the key for corrected-advisory detection. */
+    modified: string | null;
+    file: string;
+    line: number;
+}
+
+export interface FetchResponse {
+    status: number;
+    text: () => Promise<string>;
+}
+export type Fetcher = (url: string, init?: { method?: string; body?: string; timeoutMs?: number }) => Promise<FetchResponse>;
+/**
+ * `code` is the exit status; `-1` means the command could not start (not
+ * installed), `-2` that it was killed (timeout, signal) — its stdout is then
+ * never an answer, however parseable.
+ */
+export type Runner = (cmd: string, args: string[], cwd: string, timeoutMs: number) => { code: number; stdout: string };
+
+/** The only hosts any adapter may contact. */
+export const ALLOWED_HOSTS = ['api.osv.dev', 'endoflife.date', 'www.php.net', 'nodejs.org', 'www.cisa.gov'] as const;
+
+/** A fetched advisory ID is used in a URL only after this shape check. */
+const ID_SHAPE = /^[A-Z][A-Z0-9]*-[A-Za-z0-9._:-]{1,80}$/;
+
+export function assertAllowed(url: string): void {
+    let host: string;
+    try {
+        host = new URL(url).host;
+    } catch {
+        throw new Error('host not allowed: (malformed url)');
+    }
+    if (!(ALLOWED_HOSTS as readonly string[]).includes(host)) throw new Error(`host not allowed: ${host}`);
+}
+
+export const defaultFetcher: Fetcher = async (url, init = {}) => {
+    assertAllowed(url);
+    const res = await fetch(url, {
+        method: init.method ?? 'GET',
+        ...(init.body === undefined ? {} : { body: init.body, headers: { 'content-type': 'application/json' } }),
+        signal: AbortSignal.timeout(init.timeoutMs ?? 8000),
+        redirect: 'error',
+    });
+    return { status: res.status, text: () => res.text() };
+};
+
+export const defaultRunner: Runner = (cmd, args, cwd, timeoutMs) => {
+    try {
+        const stdout = execFileSync(cmd, args, { cwd, encoding: 'utf-8', stdio: ['ignore', 'pipe', 'ignore'], timeout: timeoutMs });
+        return { code: 0, stdout };
+    } catch (e) {
+        const err = e as { status?: number | null; signal?: string | null; code?: string; stdout?: string };
+        if (err.code === 'ENOENT') return { code: -1, stdout: '' };
+        if (typeof err.signal === 'string' || typeof err.status !== 'number') return { code: -2, stdout: '' };
+        // `npm audit` and `composer audit` exit non-zero WHEN they find something;
+        // their JSON is still on stdout and is the answer.
+        return { code: err.status, stdout: typeof err.stdout === 'string' ? err.stdout : '' };
+    }
+};
+
+function severityOf(v: unknown): Severity {
+    const s = String(v ?? '').toLowerCase();
+    if (s === 'critical') return 'critical';
+    if (s === 'high') return 'high';
+    if (s === 'moderate' || s === 'medium') return 'moderate';
+    if (s === 'low') return 'low';
+    return null;
+}
+
+function numberOrNull(v: unknown): number | null {
+    return typeof v === 'number' && Number.isFinite(v) ? v : null;
+}
+
+// ---------------------------------------------------------------------------
+// Native audits — the package managers' own answer
+// ---------------------------------------------------------------------------
+
+/**
+ * `npm audit` and `composer audit` send the dependency names to the registry
+ * they query. Run them only where every package in that lockfile is public, so
+ * a private name never leaves the machine through a native audit either (D7).
+ */
+export function nativeAudits(
+    root: string,
+    entries: InventoryEntry[],
+    run: Runner = defaultRunner,
+): { findings: RawFinding[]; reports: SourceReport[] } {
+    const findings: RawFinding[] = [];
+    const reports: SourceReport[] = [];
+    const byFile = new Map<string, InventoryEntry[]>();
+    for (const e of entries) {
+        if (e.provenance !== 'lockfile') continue;
+        byFile.set(e.file, [...(byFile.get(e.file) ?? []), e]);
+    }
+    for (const [file, list] of byFile) {
+        // Exactly the two lockfiles whose audit reads THIS file: any other name
+        // would run an audit over a sibling file the privacy check never saw.
+        const base = path.basename(file);
+        if (base !== 'package-lock.json' && base !== 'composer.lock') continue;
+        const npm = base === 'package-lock.json';
+        const source: SourceName = npm ? 'native-npm' : 'native-composer';
+        if (list.some((e) => e.private)) {
+            reports.push({ source, status: 'unavailable', reason: 'private-names-present' });
+            continue;
+        }
+        const cwd = path.join(root, path.dirname(file));
+        const r = npm
+            ? run('npm', ['audit', '--json', '--package-lock-only'], cwd, 30000)
+            : run('composer', ['audit', '--format=json', '--locked', '--no-interaction'], cwd, 30000);
+        if (r.code < 0) {
+            reports.push({ source, status: r.code === -1 ? 'unavailable' : 'error', reason: r.code === -1 ? 'not-installed' : 'killed' });
+            continue;
+        }
+        let doc: unknown;
+        try {
+            doc = JSON.parse(r.stdout);
+        } catch {
+            reports.push({ source, status: 'error', reason: 'unparseable' });
+            continue;
+        }
+        const line = (name: string): number => list.find((e) => e.name === name)?.line ?? 1;
+        // Several resolved versions of one name (nested duplicates): the audit
+        // does not say which one, so the version is unknown, never the first.
+        const version = (name: string): string | null => {
+            const vs = new Set(list.filter((e) => e.name === name).map((e) => e.version));
+            return vs.size === 1 ? ([...vs][0] ?? null) : null;
+        };
+        if (npm) {
+            const vulns = (doc as { vulnerabilities?: Record<string, { via?: unknown[]; fixAvailable?: unknown }> }).vulnerabilities ?? {};
+            for (const [name, v] of Object.entries(vulns)) {
+                for (const via of v.via ?? []) {
+                    if (typeof via !== 'object' || via === null) continue;
+                    const o = via as { url?: string; severity?: string; cvss?: { score?: number } };
+                    const ghsa = /GHSA-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4}/i.exec(o.url ?? '')?.[0];
+                    if (ghsa === undefined) continue;
+                    const fix = v.fixAvailable as { name?: string; version?: string } | boolean | undefined;
+                    findings.push({
+                        id: `GHSA-${ghsa.slice(5).toLowerCase()}`,
+                        aliases: [],
+                        kind: 'vulnerability',
+                        ecosystem: 'npm',
+                        package: name,
+                        version: version(name),
+                        severity: severityOf(o.severity),
+                        score: numberOrNull(o.cvss?.score),
+                        kev: false,
+                        fixed: typeof fix === 'object' && fix?.name === name ? (fix.version ?? null) : null,
+                        date: null,
+                        source,
+                        modified: null,
+                        file,
+                        line: line(name),
+                    });
+                }
+            }
+        } else {
+            const adv = (doc as { advisories?: Record<string, Array<{ advisoryId?: string; cve?: string | null; severity?: string }>> }).advisories ?? {};
+            for (const [name, list2] of Object.entries(adv)) {
+                for (const a of list2) {
+                    const id = String(a.advisoryId ?? '');
+                    if (!ID_SHAPE.test(id)) continue;
+                    findings.push({
+                        id,
+                        aliases: a.cve && ID_SHAPE.test(a.cve) ? [a.cve] : [],
+                        kind: 'vulnerability',
+                        ecosystem: 'Packagist',
+                        package: name,
+                        version: version(name),
+                        severity: severityOf(a.severity),
+                        score: null,
+                        kev: false,
+                        fixed: null,
+                        date: null,
+                        source,
+                        modified: null,
+                        file,
+                        line: line(name),
+                    });
+                }
+            }
+        }
+        reports.push({ source, status: 'ok', reason: null });
+    }
+    return { findings, reports };
+}
+
+// ---------------------------------------------------------------------------
+// OSV — cross-ecosystem, public packages only
+// ---------------------------------------------------------------------------
+
+const OSV_ECOSYSTEMS: Partial<Record<Ecosystem, string>> = {
+    npm: 'npm',
+    Packagist: 'Packagist',
+    'GitHub Actions': 'GitHub Actions',
+};
+
+interface OsvVuln {
+    id?: string;
+    aliases?: string[];
+    modified?: string;
+    severity?: Array<{ type?: string; score?: string }>;
+    database_specific?: { severity?: string };
+    affected?: Array<{ package?: { name?: string; ecosystem?: string }; ranges?: Array<{ events?: Array<{ fixed?: string }> }> }>;
+}
+
+/**
+ * CVSS v3.x base score from a vector string, per the specification's published
+ * formula. `null` for anything else (a v4 vector, a malformed one): an unknown
+ * score is left unknown rather than guessed.
+ */
+export function cvss3Base(vector: string): number | null {
+    const m = /^CVSS:3\.[01]\/(.+)$/.exec(vector.trim());
+    if (m === null) return null;
+    const v: Record<string, string> = {};
+    for (const part of m[1]!.split('/')) {
+        const [k, val] = part.split(':');
+        if (k !== undefined && val !== undefined) v[k] = val;
+    }
+    const AV: Record<string, number> = { N: 0.85, A: 0.62, L: 0.55, P: 0.2 };
+    const AC: Record<string, number> = { L: 0.77, H: 0.44 };
+    const UI: Record<string, number> = { N: 0.85, R: 0.62 };
+    const CIA: Record<string, number> = { H: 0.56, L: 0.22, N: 0 };
+    const scope = v['S'];
+    const PR: Record<string, number> = scope === 'C' ? { N: 0.85, L: 0.68, H: 0.5 } : { N: 0.85, L: 0.62, H: 0.27 };
+    const need = [AV[v['AV'] ?? ''], AC[v['AC'] ?? ''], PR[v['PR'] ?? ''], UI[v['UI'] ?? ''], CIA[v['C'] ?? ''], CIA[v['I'] ?? ''], CIA[v['A'] ?? '']];
+    if (need.some((x) => x === undefined) || (scope !== 'U' && scope !== 'C')) return null;
+    const [av, ac, pr, ui, c, i, a] = need as number[];
+    const iss = 1 - (1 - c!) * (1 - i!) * (1 - a!);
+    const impact = scope === 'U' ? 6.42 * iss : 7.52 * (iss - 0.029) - 3.25 * Math.pow(iss - 0.02, 15);
+    const exploit = 8.22 * av! * ac! * pr! * ui!;
+    if (impact <= 0) return 0;
+    const roundUp = (x: number): number => {
+        const n = Math.round(x * 100000);
+        return n % 10000 === 0 ? n / 100000 : (Math.floor(n / 10000) + 1) / 10;
+    };
+    return scope === 'U' ? roundUp(Math.min(impact + exploit, 10)) : roundUp(Math.min(1.08 * (impact + exploit), 10));
+}
+
+function cvssScore(vuln: OsvVuln): number | null {
+    for (const s of vuln.severity ?? []) {
+        if (typeof s.score === 'string') {
+            const n = cvss3Base(s.score);
+            if (n !== null) return n;
+        }
+    }
+    return null;
+}
+
+function severityFromScore(score: number | null): Severity {
+    if (score === null) return null;
+    if (score >= 9) return 'critical';
+    if (score >= 7) return 'high';
+    if (score >= 4) return 'moderate';
+    return score > 0 ? 'low' : null;
+}
+
+/** Detail cache: an advisory is fetched again only when its `modified` stamp moved. */
+export type OsvDetailCache = Map<string, { modified: string; vuln: OsvVuln }>;
+
+export async function osvQuery(
+    entries: InventoryEntry[],
+    opts: { fetcher?: Fetcher | undefined; cache?: OsvDetailCache; timeoutMs?: number; deadlineMs?: number } = {},
+): Promise<{ findings: RawFinding[]; report: SourceReport }> {
+    // `timeoutMs` bounds one request; `deadlineMs` bounds the whole query, so a
+    // batch with hundreds of advisories cannot run for hundreds of timeouts.
+    const deadlineAt = Date.now() + (opts.deadlineMs ?? 120000);
+    const inner = opts.fetcher ?? defaultFetcher;
+    const fetcher: Fetcher = (url, init) => {
+        if (Date.now() >= deadlineAt) return Promise.reject(Object.assign(new Error('deadline'), { name: 'TimeoutError' }));
+        return inner(url, init);
+    };
+    const cache = opts.cache ?? new Map();
+    // Private names never leave (1.3); entries without an exact version have nothing to query.
+    const wanted = entries.filter((e) => !e.private && e.version !== null && OSV_ECOSYSTEMS[e.ecosystem] !== undefined);
+    // One query per ecosystem/name/version: two projects (or two lockfiles) that
+    // pin the same package cost one question, and every holder gets the answer.
+    const keyOf = (e: InventoryEntry): string => `${e.ecosystem}|${e.name}|${e.version}`;
+    const holders = new Map<string, InventoryEntry[]>();
+    for (const e of wanted) holders.set(keyOf(e), [...(holders.get(keyOf(e)) ?? []), e]);
+    const queryable = [...holders.values()].map((list) => list[0]!);
+    if (queryable.length === 0) return { findings: [], report: { source: 'osv', status: 'ok', reason: 'nothing-queryable' } };
+    const findings: RawFinding[] = [];
+    let partial: string | null = null;
+    try {
+        for (let i = 0; i < queryable.length; i += 1000) {
+            const batch = queryable.slice(i, i + 1000);
+            const body = JSON.stringify({
+                queries: batch.map((e) => ({ package: { name: e.name, ecosystem: OSV_ECOSYSTEMS[e.ecosystem] }, version: e.version })),
+            });
+            const res = await fetcher('https://api.osv.dev/v1/querybatch', { method: 'POST', body, timeoutMs: opts.timeoutMs ?? 10000 });
+            if (res.status !== 200) return { findings: [], report: { source: 'osv', status: 'error', reason: `http-${res.status}` } };
+            const doc = JSON.parse(await res.text()) as {
+                results?: Array<{ vulns?: Array<{ id?: string; modified?: string }>; next_page_token?: string }>;
+            };
+            const results = doc.results ?? [];
+            // One result per query, or the answer is not an answer: a truncated
+            // array would read the missing packages as clean.
+            if (!Array.isArray(results) || results.length !== batch.length) {
+                return { findings: [], report: { source: 'osv', status: 'error', reason: 'result-count' } };
+            }
+            // A package with many advisories is paginated: follow each token (bounded).
+            for (let j = 0; j < results.length; j++) {
+                let token = results[j]?.next_page_token;
+                for (let page = 0; typeof token === 'string' && token !== '' && page < 5; page++) {
+                    const e = batch[j]!;
+                    const more = await fetcher('https://api.osv.dev/v1/querybatch', {
+                        method: 'POST',
+                        body: JSON.stringify({ queries: [{ package: { name: e.name, ecosystem: OSV_ECOSYSTEMS[e.ecosystem] }, version: e.version, page_token: token }] }),
+                        timeoutMs: opts.timeoutMs ?? 10000,
+                    });
+                    if (more.status !== 200) {
+                        partial = `page-http-${more.status}`;
+                        break;
+                    }
+                    const r = (JSON.parse(await more.text()) as typeof doc).results?.[0];
+                    results[j] = { vulns: [...(results[j]?.vulns ?? []), ...(r?.vulns ?? [])] };
+                    token = r?.next_page_token;
+                }
+                // Stopped at the cap with pages still outstanding: the answer is partial.
+                if (typeof token === 'string' && token !== '') partial = partial ?? 'page-cap';
+            }
+            for (let j = 0; j < batch.length; j++) {
+                const sameKey = holders.get(keyOf(batch[j]!)) ?? [batch[j]!];
+                for (const ref of results[j]?.vulns ?? []) {
+                    const id = String(ref.id ?? '');
+                    if (!ID_SHAPE.test(id)) continue;
+                    const modified = String(ref.modified ?? '');
+                    let vuln = cache.get(id)?.modified === modified ? cache.get(id)!.vuln : null;
+                    if (vuln === null) {
+                        const det = await fetcher(`https://api.osv.dev/v1/vulns/${encodeURIComponent(id)}`, { timeoutMs: opts.timeoutMs ?? 10000 });
+                        const got = det.status === 200 ? (JSON.parse(await det.text()) as OsvVuln) : null;
+                        // Validated before it is cached: a detail for another ID, or
+                        // one without the shape read below, is treated as missing.
+                        if (got !== null && got.id === id && (got.affected === undefined || Array.isArray(got.affected))) {
+                            vuln = got;
+                            cache.set(id, { modified, vuln });
+                        } else {
+                            // The batch SAID it is affected; a missing detail does not
+                            // undo that. Keep the finding with what is known, and mark
+                            // the source partial rather than ok.
+                            vuln = { id };
+                            partial = det.status === 200 ? 'detail-mismatch' : `detail-http-${det.status}`;
+                        }
+                    }
+                    for (const entry of sameKey) {
+                        findings.push({
+                            id,
+                            aliases: (vuln.aliases ?? []).filter((a: string) => ID_SHAPE.test(a)),
+                            kind: id.startsWith('MAL-') ? 'malware' : 'vulnerability',
+                            ecosystem: entry.ecosystem,
+                            package: entry.name,
+                            version: entry.version,
+                            severity: severityOf(vuln.database_specific?.severity) ?? severityFromScore(cvssScore(vuln)),
+                            score: cvssScore(vuln),
+                            kev: false,
+                            fixed: smallestFix(vuln, entry),
+                            date: null,
+                            source: 'osv',
+                            modified: modified === '' ? null : modified,
+                            file: entry.file,
+                            line: entry.line,
+                        });
+                    }
+                }
+            }
+        }
+        return { findings, report: partial === null ? { source: 'osv', status: 'ok', reason: null } : { source: 'osv', status: 'error', reason: partial } };
+    } catch (e) {
+        return { findings: [], report: { source: 'osv', status: 'unavailable', reason: (e as Error).name === 'TimeoutError' ? 'timeout' : 'network' } };
+    }
+}
+
+/** Smallest `fixed` event above the installed version, for this package only. */
+function smallestFix(vuln: OsvVuln, entry: InventoryEntry): string | null {
+    let best: string | null = null;
+    for (const a of vuln.affected ?? []) {
+        if (a.package?.name !== entry.name || a.package?.ecosystem !== OSV_ECOSYSTEMS[entry.ecosystem]) continue;
+        for (const r of a.ranges ?? []) {
+            for (const ev of r.events ?? []) {
+                if (typeof ev.fixed !== 'string') continue;
+                if (entry.version !== null && compare_versions(ev.fixed, entry.version) !== 1) continue;
+                if (best === null || compare_versions(ev.fixed, best) === -1) best = ev.fixed;
+            }
+        }
+    }
+    return best;
+}
+
+// ---------------------------------------------------------------------------
+// Runtime lifecycle and vendor pre-announcements
+// ---------------------------------------------------------------------------
+
+const EOL_PRODUCT: Record<string, string> = { php: 'php', node: 'nodejs' };
+/** Days before end of security support that count as `eol-soon`. */
+export const EOL_SOON_DAYS = 90;
+
+/** The release line a version belongs to: `8.3` for PHP, `22` for Node. */
+export function releaseLine(runtime: string, version: string): string | null {
+    const m = /^(\d+)(?:\.(\d+))?/.exec(version);
+    if (!m) return null;
+    return runtime === 'php' ? (m[2] === undefined ? null : `${m[1]}.${m[2]}`) : m[1]!;
+}
+
+/** A distro-patched version (`8.2.7-1+deb12u1`) is not judged on its upstream number (2.5). */
+export function isVendorPatched(version: string): boolean {
+    return /\+deb\d|ubuntu\d|[-.]el\d|\.amzn\d|-r\d+$/.test(version);
+}
+
+export async function lifecycle(
+    entries: InventoryEntry[],
+    opts: { fetcher?: Fetcher | undefined; now?: Date; timeoutMs?: number } = {},
+): Promise<{ findings: RawFinding[]; report: SourceReport }> {
+    const fetcher = opts.fetcher ?? defaultFetcher;
+    const now = opts.now ?? new Date();
+    const runtimes = entries.filter((e) => e.ecosystem === 'runtime' && e.version !== null && EOL_PRODUCT[e.name] !== undefined);
+    if (runtimes.length === 0) return { findings: [], report: { source: 'lifecycle', status: 'ok', reason: 'no-runtime' } };
+    const findings: RawFinding[] = [];
+    try {
+        const tables = new Map<string, Array<{ cycle?: string; eol?: string | boolean }>>();
+        for (const name of new Set(runtimes.map((e) => e.name))) {
+            const res = await fetcher(`https://endoflife.date/api/${EOL_PRODUCT[name]}.json`, { timeoutMs: opts.timeoutMs ?? 8000 });
+            if (res.status !== 200) return { findings: [], report: { source: 'lifecycle', status: 'error', reason: `http-${res.status}` } };
+            tables.set(name, JSON.parse(await res.text()));
+        }
+        for (const e of runtimes) {
+            const line = releaseLine(e.name, e.version!);
+            const row = (tables.get(e.name) ?? []).find((r) => String(r.cycle) === line);
+            if (row === undefined || typeof row.eol !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(row.eol)) continue;
+            const days = (Date.parse(`${row.eol}T00:00:00Z`) - now.getTime()) / 86400000;
+            if (days > EOL_SOON_DAYS) continue;
+            findings.push({
+                id: `EOL-${e.name}-${line}`,
+                aliases: [],
+                kind: days <= 0 ? 'eol' : 'eol-soon',
+                ecosystem: 'runtime',
+                package: e.name,
+                version: e.version,
+                severity: null,
+                score: null,
+                kev: false,
+                fixed: null,
+                date: row.eol,
+                source: 'lifecycle',
+                modified: null,
+                file: e.file,
+                line: e.line,
+            });
+        }
+        return { findings, report: { source: 'lifecycle', status: 'ok', reason: null } };
+    } catch (e) {
+        return { findings: [], report: { source: 'lifecycle', status: 'unavailable', reason: (e as Error).name === 'TimeoutError' ? 'timeout' : 'network' } };
+    }
+}
+
+const VENDOR_FEEDS: Record<'php' | 'node', { url: string; source: SourceName }> = {
+    php: { url: 'https://www.php.net/feed.atom', source: 'vendor-php' },
+    node: { url: 'https://nodejs.org/en/feed/vulnerability.xml', source: 'vendor-node' },
+};
+const ANNOUNCES_RELEASE = /security release/i;
+const ANNOUNCES_AHEAD = /upcoming|pre-?announce|will be released|scheduled|planned/i;
+/** A pre-announcement older than this is no longer "ahead" of anything. */
+export const PREANNOUNCE_WINDOW_DAYS = 14;
+
+/**
+ * A runtime vendor's own feed — the one signal that exists BEFORE an advisory
+ * record does. The release JSON of PHP carries no security flag at all, and the
+ * worked case of 2026-10-21 was announced a day before its release, with the
+ * patched versions not yet named. Only the title's class and the entry's date
+ * are kept: the finding says "announced for <runtime> on <day>", never the text.
+ */
+export async function vendorAnnouncements(
+    entries: InventoryEntry[],
+    opts: { fetcher?: Fetcher | undefined; now?: Date; timeoutMs?: number } = {},
+): Promise<{ findings: RawFinding[]; reports: SourceReport[] }> {
+    const fetcher = opts.fetcher ?? defaultFetcher;
+    const now = opts.now ?? new Date();
+    const findings: RawFinding[] = [];
+    const reports: SourceReport[] = [];
+    for (const runtimeName of ['php', 'node'] as const) {
+        const users = entries.filter((e) => e.ecosystem === 'runtime' && e.name === runtimeName);
+        if (users.length === 0) continue;
+        const feed = VENDOR_FEEDS[runtimeName];
+        try {
+            const res = await fetcher(feed.url, { timeoutMs: opts.timeoutMs ?? 8000 });
+            if (res.status !== 200) {
+                reports.push({ source: feed.source, status: 'error', reason: `http-${res.status}` });
+                continue;
+            }
+            const xml = await res.text();
+            const items = xml.split(/<(?:entry|item)[\s>]/).slice(1);
+            const criticalDays: string[] = [];
+            const releases: Array<{ version: string; day: string }> = [];
+            for (const item of items) {
+                // A released version: "PHP 8.3.27 Released!" / "Node v22.11.1 (LTS)", whose
+                // body says it is a security release. Only the version and day are kept.
+                const t = /<title[^>]*>([\s\S]*?)<\/title>/.exec(item)?.[1] ?? '';
+                const ver = /(\d+\.\d+\.\d+)/.exec(t)?.[1];
+                const when = Date.parse(/<(?:published|updated|pubDate)>([^<]+)</.exec(item)?.[1] ?? '');
+                if (ver !== undefined && /released|\(lts\)|\(current\)/i.test(t) && /security/i.test(item) && Number.isFinite(when)) {
+                    const ageDays = (now.getTime() - when) / 86400000;
+                    if (ageDays >= 0 && ageDays <= PREANNOUNCE_WINDOW_DAYS) releases.push({ version: ver, day: new Date(when).toISOString().slice(0, 10) });
+                }
+            }
+            for (const item of items) {
+                const title = /<title[^>]*>([\s\S]*?)<\/title>/.exec(item)?.[1] ?? '';
+                const stamp = /<(?:published|updated|pubDate)>([^<]+)</.exec(item)?.[1] ?? '';
+                const at = Date.parse(stamp);
+                if (!Number.isFinite(at)) continue;
+                const age = (now.getTime() - at) / 86400000;
+                if (age < 0 || age > PREANNOUNCE_WINDOW_DAYS) continue;
+                if (!ANNOUNCES_RELEASE.test(title) || !ANNOUNCES_AHEAD.test(title)) continue;
+                const day = new Date(at).toISOString().slice(0, 10);
+                if (/critical/i.test(title)) criticalDays.push(day);
+                // The release it announced is out: the release finding speaks instead.
+                if (releases.some((r) => r.day >= day)) continue;
+                const subject = users[0]!;
+                findings.push({
+                    id: `PRE-${runtimeName}-${day}`,
+                    aliases: [],
+                    kind: 'pre-announced',
+                    ecosystem: 'runtime',
+                    package: runtimeName,
+                    version: subject.version,
+                    severity: /critical/i.test(title) ? 'critical' : null,
+                    score: null,
+                    kev: false,
+                    fixed: null,
+                    date: day,
+                    source: feed.source,
+                    modified: null,
+                    file: subject.file,
+                    line: subject.line,
+                });
+            }
+            // Once the release is out, each project pin on the same line below it
+            // has a fix — and the pre-announcement's severity carries over.
+            for (const u of users) {
+                if (u.version === null || isVendorPatched(u.version)) continue;
+                const lineOfUse = releaseLine(runtimeName, u.version);
+                // The SMALLEST newer security release on the line, whatever the feed order.
+                const rel = releases
+                    .filter((r) => releaseLine(runtimeName, r.version) === lineOfUse && compare_versions(r.version, u.version) === 1)
+                    .sort((a, b) => compare_versions(a.version, b.version) ?? 0)[0];
+                if (rel === undefined) continue;
+                // Critical only when a critical pre-announcement preceded THIS release
+                // within the window; a vendor-labelled security release is otherwise high.
+                const relAt = Date.parse(rel.day);
+                const critical = criticalDays.some((d) => {
+                    const gap = (relAt - Date.parse(d)) / 86400000;
+                    return gap >= 0 && gap <= PREANNOUNCE_WINDOW_DAYS;
+                });
+                findings.push({
+                    id: `REL-${runtimeName}-${rel.version}`,
+                    aliases: [],
+                    kind: 'vulnerability',
+                    ecosystem: 'runtime',
+                    package: runtimeName,
+                    version: u.version,
+                    severity: critical ? 'critical' : 'high',
+                    score: null,
+                    kev: false,
+                    fixed: rel.version,
+                    date: rel.day,
+                    source: feed.source,
+                    modified: null,
+                    file: u.file,
+                    line: u.line,
+                });
+            }
+            reports.push({ source: feed.source, status: 'ok', reason: null });
+        } catch (e) {
+            reports.push({ source: feed.source, status: 'unavailable', reason: (e as Error).name === 'TimeoutError' ? 'timeout' : 'network' });
+        }
+    }
+    return { findings, reports };
+}
+
+// ---------------------------------------------------------------------------
+// CISA KEV — an enrichment, never a finding source (council 2026-10-21, round 3)
+// ---------------------------------------------------------------------------
+
+export const KEV_URL = 'https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json';
+/** A catalog this old is still used when a fetch fails — and the report says so. */
+export const KEV_MAX_AGE_DAYS = 7;
+
+export interface KevCatalog {
+    at: string;
+    cves: string[];
+}
+
+/**
+ * Mark every finding whose CVE is in the known-exploited catalog. The catalog is
+ * downloaded WHOLE and matched here, so the request carries nothing about the
+ * project. A failed fetch falls back to the last catalog while it is at most
+ * KEV_MAX_AGE_DAYS old and reports `kev-stale`; older, or none, reports
+ * `kev-unavailable` and marks nothing — the tier then rests on the other sources,
+ * which is a stated gap, never a silent downgrade of a fact.
+ */
+export async function kevEnrich(
+    findings: RawFinding[],
+    opts: { fetcher?: Fetcher | undefined; cached?: KevCatalog | null; now?: Date; timeoutMs?: number } = {},
+): Promise<{ catalog: KevCatalog | null; report: SourceReport }> {
+    const now = opts.now ?? new Date();
+    let catalog: KevCatalog | null = null;
+    let reason: string | null = null;
+    try {
+        const res = await (opts.fetcher ?? defaultFetcher)(KEV_URL, { timeoutMs: opts.timeoutMs ?? 15000 });
+        if (res.status === 200) {
+            const doc = JSON.parse(await res.text()) as { vulnerabilities?: Array<{ cveID?: unknown }> };
+            const cves = (doc.vulnerabilities ?? []).map((v) => v.cveID).filter((c): c is string => typeof c === 'string' && /^CVE-\d{4}-\d{4,}$/.test(c));
+            if (cves.length > 0) catalog = { at: now.toISOString(), cves };
+            else reason = 'kev-empty';
+        } else reason = `kev-http-${res.status}`;
+    } catch (e) {
+        reason = (e as Error).name === 'TimeoutError' ? 'kev-timeout' : 'kev-network';
+    }
+    let status: SourceReport['status'] = 'ok';
+    if (catalog === null) {
+        const age = opts.cached ? (now.getTime() - Date.parse(opts.cached.at)) / 86400000 : Number.NaN;
+        if (opts.cached && Number.isFinite(age) && age >= 0 && age <= KEV_MAX_AGE_DAYS) {
+            catalog = opts.cached;
+            status = 'error';
+            reason = `kev-stale (${reason})`;
+        } else {
+            status = 'unavailable';
+            reason = `kev-unavailable (${reason})`;
+        }
+    }
+    if (catalog !== null) {
+        const known = new Set(catalog.cves);
+        for (const f of findings) {
+            if (known.has(f.id) || f.aliases.some((a) => known.has(a))) f.kev = true;
+        }
+    }
+    return { catalog, report: { source: 'kev', status, reason } };
+}
