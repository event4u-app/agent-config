+
+export function knownProjects(mdir: string = machineDir()): string[] {
+    try {
+        return Object.keys(JSON.parse(fs.readFileSync(path.join(mdir, 'projects.json'), 'utf-8'))).filter((r) => fs.existsSync(r));
+    } catch {
