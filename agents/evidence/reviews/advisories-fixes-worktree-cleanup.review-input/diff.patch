@@ -0,0 +1,487 @@
+/**
+ * Ask the authorities, carry nothing (road-to-advisories-heard-the-same-day
+ * Phase 2).
+ *
+ * Every adapter reports `ok | unavailable | error` — a timeout is never `ok`,
+ * and "no findings" from a source that did not answer is never "no findings".
+ * Every outbound request goes to a host on a fixed allowlist; no URL is built
+ * from fetched content except an advisory ID that passed a strict shape check.
+ * What leaves an adapter is IDs, versions, enums and numbers only — no advisory
+ * prose — because the cache is the sanitising boundary (C3): nothing fetched
+ * may reach model context as text.
+ *
+ * Transport and process execution are injected, so every adapter runs offline
+ * against fixtures in tests.
+ */
+
+import { execFileSync } from 'node:child_process';
+import * as path from 'node:path';
+
+import type { Ecosystem, InventoryEntry } from './advisory_inventory.js';
+import { compare_versions } from './version_order.js';
+
+export type SourceName = 'native-npm' | 'native-composer' | 'osv' | 'lifecycle' | 'vendor-php' | 'vendor-node';
+export type SourceStatus = 'ok' | 'unavailable' | 'error';
+
+export interface SourceReport {
+    source: SourceName;
+    status: SourceStatus;
+    /** A short machine reason (`timeout`, `http-503`, `private-names-present`), never fetched text. */
+    reason: string | null;
+}
+
+export type FindingKind = 'vulnerability' | 'malware' | 'eol' | 'eol-soon' | 'pre-announced' | 'outdated';
+export type Severity = 'low' | 'moderate' | 'high' | 'critical' | null;
+
+/** One finding as a source reported it. IDs, versions, enums and numbers only. */
+export interface RawFinding {
+    id: string;
+    aliases: string[];
+    kind: FindingKind;
+    ecosystem: Ecosystem;
+    package: string;
+    version: string | null;
+    severity: Severity;
+    /** CVSS base score when the source states one numerically. */
+    score: number | null;
+    /** Known exploited (CISA KEV) — only when a source asserts it. */
+    kev: boolean;
+    /** Smallest version that fixes it for this package, when known. */
+    fixed: string | null;
+    /** End of security support or announced release date (ISO day), for lifecycle and vendor findings. */
+    date: string | null;
+    source: SourceName;
+    /** Source-side `modified` stamp, the key for corrected-advisory detection. */
+    modified: string | null;
+    file: string;
+    line: number;
+}
+
+export interface FetchResponse {
+    status: number;
+    text: () => Promise<string>;
+}
+export type Fetcher = (url: string, init?: { method?: string; body?: string; timeoutMs?: number }) => Promise<FetchResponse>;
+export type Runner = (cmd: string, args: string[], cwd: string, timeoutMs: number) => { code: number; stdout: string };
+
+/** The only hosts any adapter may contact. */
+export const ALLOWED_HOSTS = ['api.osv.dev', 'endoflife.date', 'www.php.net', 'nodejs.org'] as const;
+
+/** A fetched advisory ID is used in a URL only after this shape check. */
+const ID_SHAPE = /^[A-Z][A-Z0-9]*-[A-Za-z0-9._:-]{1,80}$/;
+
+export function assertAllowed(url: string): void {
+    const host = new URL(url).host;
+    if (!(ALLOWED_HOSTS as readonly string[]).includes(host)) throw new Error(`host not allowed: ${host}`);
+}
+
+export const defaultFetcher: Fetcher = async (url, init = {}) => {
+    assertAllowed(url);
+    const res = await fetch(url, {
+        method: init.method ?? 'GET',
+        ...(init.body === undefined ? {} : { body: init.body, headers: { 'content-type': 'application/json' } }),
+        signal: AbortSignal.timeout(init.timeoutMs ?? 8000),
+        redirect: 'error',
+    });
+    return { status: res.status, text: () => res.text() };
+};
+
+export const defaultRunner: Runner = (cmd, args, cwd, timeoutMs) => {
+    try {
+        const stdout = execFileSync(cmd, args, { cwd, encoding: 'utf-8', stdio: ['ignore', 'pipe', 'ignore'], timeout: timeoutMs });
+        return { code: 0, stdout };
+    } catch (e) {
+        const err = e as { status?: number | null; stdout?: string };
+        // `npm audit` and `composer audit` exit non-zero WHEN they find something;
+        // their JSON is still on stdout and is the answer.
+        return { code: typeof err.status === 'number' ? err.status : -1, stdout: typeof err.stdout === 'string' ? err.stdout : '' };
+    }
+};
+
+function severityOf(v: unknown): Severity {
+    const s = String(v ?? '').toLowerCase();
+    if (s === 'critical') return 'critical';
+    if (s === 'high') return 'high';
+    if (s === 'moderate' || s === 'medium') return 'moderate';
+    if (s === 'low') return 'low';
+    return null;
+}
+
+function numberOrNull(v: unknown): number | null {
+    return typeof v === 'number' && Number.isFinite(v) ? v : null;
+}
+
+// ---------------------------------------------------------------------------
+// Native audits — the package managers' own answer
+// ---------------------------------------------------------------------------
+
+/**
+ * `npm audit` and `composer audit` send the dependency names to the registry
+ * they query. Run them only where every package in that lockfile is public, so
+ * a private name never leaves the machine through a native audit either (D7).
+ */
+export function nativeAudits(
+    root: string,
+    entries: InventoryEntry[],
+    run: Runner = defaultRunner,
+): { findings: RawFinding[]; reports: SourceReport[] } {
+    const findings: RawFinding[] = [];
+    const reports: SourceReport[] = [];
+    const byFile = new Map<string, InventoryEntry[]>();
+    for (const e of entries) {
+        if (e.provenance !== 'lockfile') continue;
+        byFile.set(e.file, [...(byFile.get(e.file) ?? []), e]);
+    }
+    for (const [file, list] of byFile) {
+        const npm = path.basename(file) === 'package-lock.json';
+        const source: SourceName = npm ? 'native-npm' : 'native-composer';
+        if (list.some((e) => e.private)) {
+            reports.push({ source, status: 'unavailable', reason: 'private-names-present' });
+            continue;
+        }
+        const cwd = path.join(root, path.dirname(file));
+        const r = npm
+            ? run('npm', ['audit', '--json', '--package-lock-only'], cwd, 30000)
+            : run('composer', ['audit', '--format=json', '--locked', '--no-interaction'], cwd, 30000);
+        let doc: unknown;
+        try {
+            doc = JSON.parse(r.stdout);
+        } catch {
+            reports.push({ source, status: r.code === -1 ? 'unavailable' : 'error', reason: r.code === -1 ? 'not-installed' : 'unparseable' });
+            continue;
+        }
+        const line = (name: string): number => list.find((e) => e.name === name)?.line ?? 1;
+        const version = (name: string): string | null => list.find((e) => e.name === name)?.version ?? null;
+        if (npm) {
+            const vulns = (doc as { vulnerabilities?: Record<string, { via?: unknown[]; fixAvailable?: unknown }> }).vulnerabilities ?? {};
+            for (const [name, v] of Object.entries(vulns)) {
+                for (const via of v.via ?? []) {
+                    if (typeof via !== 'object' || via === null) continue;
+                    const o = via as { url?: string; severity?: string; cvss?: { score?: number } };
+                    const ghsa = /GHSA-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4}/i.exec(o.url ?? '')?.[0];
+                    if (ghsa === undefined) continue;
+                    const fix = v.fixAvailable as { name?: string; version?: string } | boolean | undefined;
+                    findings.push({
+                        id: `GHSA-${ghsa.slice(5).toLowerCase()}`,
+                        aliases: [],
+                        kind: 'vulnerability',
+                        ecosystem: 'npm',
+                        package: name,
+                        version: version(name),
+                        severity: severityOf(o.severity),
+                        score: numberOrNull(o.cvss?.score),
+                        kev: false,
+                        fixed: typeof fix === 'object' && fix?.name === name ? (fix.version ?? null) : null,
+                        date: null,
+                        source,
+                        modified: null,
+                        file,
+                        line: line(name),
+                    });
+                }
+            }
+        } else {
+            const adv = (doc as { advisories?: Record<string, Array<{ advisoryId?: string; cve?: string | null; severity?: string }>> }).advisories ?? {};
+            for (const [name, list2] of Object.entries(adv)) {
+                for (const a of list2) {
+                    const id = String(a.advisoryId ?? '');
+                    if (!ID_SHAPE.test(id)) continue;
+                    findings.push({
+                        id,
+                        aliases: a.cve && ID_SHAPE.test(a.cve) ? [a.cve] : [],
+                        kind: 'vulnerability',
+                        ecosystem: 'Packagist',
+                        package: name,
+                        version: version(name),
+                        severity: severityOf(a.severity),
+                        score: null,
+                        kev: false,
+                        fixed: null,
+                        date: null,
+                        source,
+                        modified: null,
+                        file,
+                        line: line(name),
+                    });
+                }
+            }
+        }
+        reports.push({ source, status: 'ok', reason: null });
+    }
+    return { findings, reports };
+}
+
+// ---------------------------------------------------------------------------
+// OSV — cross-ecosystem, public packages only
+// ---------------------------------------------------------------------------
+
+const OSV_ECOSYSTEMS: Partial<Record<Ecosystem, string>> = {
+    npm: 'npm',
+    Packagist: 'Packagist',
+    'GitHub Actions': 'GitHub Actions',
+};
+
+interface OsvVuln {
+    id?: string;
+    aliases?: string[];
+    modified?: string;
+    database_specific?: { severity?: string };
+    affected?: Array<{ package?: { name?: string; ecosystem?: string }; ranges?: Array<{ events?: Array<{ fixed?: string }> }> }>;
+}
+
+/** Detail cache: an advisory is fetched again only when its `modified` stamp moved. */
+export type OsvDetailCache = Map<string, { modified: string; vuln: OsvVuln }>;
+
+export async function osvQuery(
+    entries: InventoryEntry[],
+    opts: { fetcher?: Fetcher | undefined; cache?: OsvDetailCache; timeoutMs?: number } = {},
+): Promise<{ findings: RawFinding[]; report: SourceReport }> {
+    const fetcher = opts.fetcher ?? defaultFetcher;
+    const cache = opts.cache ?? new Map();
+    // Private names never leave (1.3); entries without an exact version have nothing to query.
+    const queryable = entries.filter((e) => !e.private && e.version !== null && OSV_ECOSYSTEMS[e.ecosystem] !== undefined);
+    if (queryable.length === 0) return { findings: [], report: { source: 'osv', status: 'ok', reason: 'nothing-queryable' } };
+    const findings: RawFinding[] = [];
+    try {
+        for (let i = 0; i < queryable.length; i += 1000) {
+            const batch = queryable.slice(i, i + 1000);
+            const body = JSON.stringify({
+                queries: batch.map((e) => ({ package: { name: e.name, ecosystem: OSV_ECOSYSTEMS[e.ecosystem] }, version: e.version })),
+            });
+            const res = await fetcher('https://api.osv.dev/v1/querybatch', { method: 'POST', body, timeoutMs: opts.timeoutMs ?? 10000 });
+            if (res.status !== 200) return { findings: [], report: { source: 'osv', status: 'error', reason: `http-${res.status}` } };
+            const doc = JSON.parse(await res.text()) as { results?: Array<{ vulns?: Array<{ id?: string; modified?: string }> }> };
+            const results = doc.results ?? [];
+            for (let j = 0; j < batch.length; j++) {
+                const entry = batch[j]!;
+                for (const ref of results[j]?.vulns ?? []) {
+                    const id = String(ref.id ?? '');
+                    if (!ID_SHAPE.test(id)) continue;
+                    const modified = String(ref.modified ?? '');
+                    let vuln = cache.get(id)?.modified === modified ? cache.get(id)!.vuln : null;
+                    if (vuln === null) {
+                        const det = await fetcher(`https://api.osv.dev/v1/vulns/${encodeURIComponent(id)}`, { timeoutMs: opts.timeoutMs ?? 10000 });
+                        if (det.status !== 200) continue;
+                        vuln = JSON.parse(await det.text()) as OsvVuln;
+                        cache.set(id, { modified, vuln });
+                    }
+                    findings.push({
+                        id,
+                        aliases: (vuln.aliases ?? []).filter((a: string) => ID_SHAPE.test(a)),
+                        kind: id.startsWith('MAL-') ? 'malware' : 'vulnerability',
+                        ecosystem: entry.ecosystem,
+                        package: entry.name,
+                        version: entry.version,
+                        severity: severityOf(vuln.database_specific?.severity),
+                        score: null,
+                        kev: false,
+                        fixed: smallestFix(vuln, entry),
+                        date: null,
+                        source: 'osv',
+                        modified: modified === '' ? null : modified,
+                        file: entry.file,
+                        line: entry.line,
+                    });
+                }
+            }
+        }
+        return { findings, report: { source: 'osv', status: 'ok', reason: null } };
+    } catch (e) {
+        return { findings: [], report: { source: 'osv', status: 'unavailable', reason: (e as Error).name === 'TimeoutError' ? 'timeout' : 'network' } };
+    }
+}
+
+/** Smallest `fixed` event above the installed version, for this package only. */
+function smallestFix(vuln: OsvVuln, entry: InventoryEntry): string | null {
+    let best: string | null = null;
+    for (const a of vuln.affected ?? []) {
+        if (a.package?.name !== entry.name) continue;
+        for (const r of a.ranges ?? []) {
+            for (const ev of r.events ?? []) {
+                if (typeof ev.fixed !== 'string') continue;
+                if (entry.version !== null && compare_versions(ev.fixed, entry.version) !== 1) continue;
+                if (best === null || compare_versions(ev.fixed, best) === -1) best = ev.fixed;
+            }
+        }
+    }
+    return best;
+}
+
+// ---------------------------------------------------------------------------
+// Runtime lifecycle and vendor pre-announcements
+// ---------------------------------------------------------------------------
+
+const EOL_PRODUCT: Record<string, string> = { php: 'php', node: 'nodejs' };
+/** Days before end of security support that count as `eol-soon`. */
+export const EOL_SOON_DAYS = 90;
+
+/** The release line a version belongs to: `8.3` for PHP, `22` for Node. */
+export function releaseLine(runtime: string, version: string): string | null {
+    const m = /^(\d+)(?:\.(\d+))?/.exec(version);
+    if (!m) return null;
+    return runtime === 'php' ? (m[2] === undefined ? null : `${m[1]}.${m[2]}`) : m[1]!;
+}
+
+/** A distro-patched version (`8.2.7-1+deb12u1`) is not judged on its upstream number (2.5). */
+export function isVendorPatched(version: string): boolean {
+    return /\+deb\d|ubuntu\d|[-.]el\d|\.amzn\d|-r\d+$/.test(version);
+}
+
+export async function lifecycle(
+    entries: InventoryEntry[],
+    opts: { fetcher?: Fetcher | undefined; now?: Date; timeoutMs?: number } = {},
+): Promise<{ findings: RawFinding[]; report: SourceReport }> {
+    const fetcher = opts.fetcher ?? defaultFetcher;
+    const now = opts.now ?? new Date();
+    const runtimes = entries.filter((e) => e.ecosystem === 'runtime' && e.version !== null && EOL_PRODUCT[e.name] !== undefined);
+    if (runtimes.length === 0) return { findings: [], report: { source: 'lifecycle', status: 'ok', reason: 'no-runtime' } };
+    const findings: RawFinding[] = [];
+    try {
+        const tables = new Map<string, Array<{ cycle?: string; eol?: string | boolean }>>();
+        for (const name of new Set(runtimes.map((e) => e.name))) {
+            const res = await fetcher(`https://endoflife.date/api/${EOL_PRODUCT[name]}.json`, { timeoutMs: opts.timeoutMs ?? 8000 });
+            if (res.status !== 200) return { findings: [], report: { source: 'lifecycle', status: 'error', reason: `http-${res.status}` } };
+            tables.set(name, JSON.parse(await res.text()));
+        }
+        for (const e of runtimes) {
+            const line = releaseLine(e.name, e.version!);
+            const row = (tables.get(e.name) ?? []).find((r) => String(r.cycle) === line);
+            if (row === undefined || typeof row.eol !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(row.eol)) continue;
+            const days = (Date.parse(`${row.eol}T00:00:00Z`) - now.getTime()) / 86400000;
+            if (days > EOL_SOON_DAYS) continue;
+            findings.push({
+                id: `EOL-${e.name}-${line}`,
+                aliases: [],
+                kind: days <= 0 ? 'eol' : 'eol-soon',
+                ecosystem: 'runtime',
+                package: e.name,
+                version: e.version,
+                severity: null,
+                score: null,
+                kev: false,
+                fixed: null,
+                date: row.eol,
+                source: 'lifecycle',
+                modified: null,
+                file: e.file,
+                line: e.line,
+            });
+        }
+        return { findings, report: { source: 'lifecycle', status: 'ok', reason: null } };
+    } catch (e) {
+        return { findings: [], report: { source: 'lifecycle', status: 'unavailable', reason: (e as Error).name === 'TimeoutError' ? 'timeout' : 'network' } };
+    }
+}
+
+const VENDOR_FEEDS: Record<'php' | 'node', { url: string; source: SourceName }> = {
+    php: { url: 'https://www.php.net/feed.atom', source: 'vendor-php' },
+    node: { url: 'https://nodejs.org/en/feed/vulnerability.xml', source: 'vendor-node' },
+};
+const ANNOUNCES_RELEASE = /security release/i;
+const ANNOUNCES_AHEAD = /upcoming|pre-?announce|will be released|scheduled|planned/i;
+/** A pre-announcement older than this is no longer "ahead" of anything. */
+export const PREANNOUNCE_WINDOW_DAYS = 14;
+
+/**
+ * A runtime vendor's own feed — the one signal that exists BEFORE an advisory
+ * record does. The release JSON of PHP carries no security flag at all, and the
+ * worked case of 2026-10-21 was announced a day before its release, with the
+ * patched versions not yet named. Only the title's class and the entry's date
+ * are kept: the finding says "announced for <runtime> on <day>", never the text.
+ */
+export async function vendorAnnouncements(
+    entries: InventoryEntry[],
+    opts: { fetcher?: Fetcher | undefined; now?: Date; timeoutMs?: number } = {},
+): Promise<{ findings: RawFinding[]; reports: SourceReport[] }> {
+    const fetcher = opts.fetcher ?? defaultFetcher;
+    const now = opts.now ?? new Date();
+    const findings: RawFinding[] = [];
+    const reports: SourceReport[] = [];
+    for (const runtimeName of ['php', 'node'] as const) {
+        const users = entries.filter((e) => e.ecosystem === 'runtime' && e.name === runtimeName);
+        if (users.length === 0) continue;
+        const feed = VENDOR_FEEDS[runtimeName];
+        try {
+            const res = await fetcher(feed.url, { timeoutMs: opts.timeoutMs ?? 8000 });
+            if (res.status !== 200) {
+                reports.push({ source: feed.source, status: 'error', reason: `http-${res.status}` });
+                continue;
+            }
+            const xml = await res.text();
+            const items = xml.split(/<(?:entry|item)[\s>]/).slice(1);
+            let criticalAhead = false;
+            const releases: Array<{ version: string; day: string }> = [];
+            for (const item of items) {
+                // A released version: "PHP 8.3.27 Released!" / "Node v22.11.1 (LTS)", whose
+                // body says it is a security release. Only the version and day are kept.
+                const t = /<title[^>]*>([\s\S]*?)<\/title>/.exec(item)?.[1] ?? '';
+                const ver = /(\d+\.\d+\.\d+)/.exec(t)?.[1];
+                const when = Date.parse(/<(?:published|updated|pubDate)>([^<]+)</.exec(item)?.[1] ?? '');
+                if (ver !== undefined && /released|\(lts\)|\(current\)/i.test(t) && /security/i.test(item) && Number.isFinite(when)) {
+                    const ageDays = (now.getTime() - when) / 86400000;
+                    if (ageDays >= 0 && ageDays <= PREANNOUNCE_WINDOW_DAYS) releases.push({ version: ver, day: new Date(when).toISOString().slice(0, 10) });
+                }
+            }
+            for (const item of items) {
+                const title = /<title[^>]*>([\s\S]*?)<\/title>/.exec(item)?.[1] ?? '';
+                const stamp = /<(?:published|updated|pubDate)>([^<]+)</.exec(item)?.[1] ?? '';
+                const at = Date.parse(stamp);
+                if (!Number.isFinite(at)) continue;
+                const age = (now.getTime() - at) / 86400000;
+                if (age < 0 || age > PREANNOUNCE_WINDOW_DAYS) continue;
+                if (!ANNOUNCES_RELEASE.test(title) || !ANNOUNCES_AHEAD.test(title)) continue;
+                const day = new Date(at).toISOString().slice(0, 10);
+                if (/critical/i.test(title)) criticalAhead = true;
+                // The release it announced is out: the release finding speaks instead.
+                if (releases.some((r) => r.day >= day)) continue;
+                const subject = users[0]!;
+                findings.push({
+                    id: `PRE-${runtimeName}-${day}`,
+                    aliases: [],
+                    kind: 'pre-announced',
+                    ecosystem: 'runtime',
+                    package: runtimeName,
+                    version: subject.version,
+                    severity: /critical/i.test(title) ? 'critical' : null,
+                    score: null,
+                    kev: false,
+                    fixed: null,
+                    date: day,
+                    source: feed.source,
+                    modified: null,
+                    file: subject.file,
+                    line: subject.line,
+                });
+            }
+            // Once the release is out, each project pin on the same line below it
+            // has a fix — and the pre-announcement's severity carries over.
+            for (const u of users) {
+                if (u.version === null || isVendorPatched(u.version)) continue;
+                const lineOfUse = releaseLine(runtimeName, u.version);
+                const rel = releases.find((r) => releaseLine(runtimeName, r.version) === lineOfUse && compare_versions(r.version, u.version) === 1);
+                if (rel === undefined) continue;
+                findings.push({
+                    id: `REL-${runtimeName}-${rel.version}`,
+                    aliases: [],
+                    kind: 'vulnerability',
+                    ecosystem: 'runtime',
+                    package: runtimeName,
+                    version: u.version,
+                    severity: criticalAhead ? 'critical' : 'high',
+                    score: null,
+                    kev: false,
+                    fixed: rel.version,
+                    date: rel.day,
+                    source: feed.source,
+                    modified: null,
+                    file: u.file,
+                    line: u.line,
+                });
+            }
+            reports.push({ source: feed.source, status: 'ok', reason: null });
+        } catch (e) {
+            reports.push({ source: feed.source, status: 'unavailable', reason: (e as Error).name === 'TimeoutError' ? 'timeout' : 'network' });
+        }
+    }
+    return { findings, reports };
+}
diff --git a/src/scripts/_lib/advisory_verdicts.ts b/src/scripts/_lib/advisory_verdicts.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d55b2eee6edb2eccb761e11be9c401b64fc7009b
--- /dev/null
+++ b/src/scripts/_lib/advisory_verdicts.ts
@@ -0,0 +1,310 @@
+/**
+ * From raw source answers to a finding a person can act on
+ * (road-to-advisories-heard-the-same-day Phases 2.2–2.5 and 3).
+ *
+ * Deterministic and pure: no file, no network. The closed verdict vocabulary,
+ * the alias merge, the tiers, the delta ledger, acceptance with expiry and the
+ * noise budget all live here so each is testable over fixtures alone.
+ */
+
+import type { InventoryEntry } from './advisory_inventory.js';
+import type { RawFinding, Severity, SourceReport } from './advisory_sources.js';
+import { isVendorPatched } from './advisory_sources.js';
+
+export type Verdict =
+    | 'affected'
+    | 'fix-available'
+    | 'fix-fresh'
+    | 'no-fix'
+    | 'malware'
+    | 'eol'
+    | 'eol-soon'
+    | 'pre-announced'
+    | 'unknown'
+    | 'accepted';
+
+export type Tier = 'T0' | 'T1' | 'T2' | 'T3';
+
+export interface Finding {
+    /** Stable across runs: canonical ID + package + version. */
+    key: string;
+    /** The canonical ID — a CVE when one is among the aliases, else the first seen. */
+    id: string;
+    aliases: string[];
+    verdict: Verdict;
+    tier: Tier;
+    ecosystem: string;
+    package: string;
+    version: string | null;
+    fixed: string | null;
+    severity: Severity;
+    score: number | null;
+    kev: boolean;
+    date: string | null;
+    scope: 'runtime' | 'dev' | null;
+    sources: string[];
+    /** Newest source-side `modified` stamp; a change means a corrected advisory. */
+    modified: string | null;
+    file: string;
+    line: number;
+    /** Why the verdict is what it is, when it is not obvious (`vendor-patched`, `source-unavailable`). */
+    note: string | null;
+}
+
+export interface Acceptance {
+    id: string;
+    reason: string;
+    /** ISO day; past it the acceptance lapses and the finding returns. */
+    expires: string;
+}
+
+const SEVERITY_RANK: Record<NonNullable<Severity>, number> = { low: 1, moderate: 2, high: 3, critical: 4 };
+
+function stronger(a: Severity, b: Severity): Severity {
+    if (a === null) return b;
+    if (b === null) return a;
+    return SEVERITY_RANK[a] >= SEVERITY_RANK[b] ? a : b;
+}
+
+/** A CVE is the alias most people search for; prefer it as the canonical ID. */
+function canonical(ids: string[]): string {
+    return ids.find((i) => i.startsWith('CVE-')) ?? ids.find((i) => i.startsWith('GHSA-')) ?? ids[0]!;
+}
+
+/**
+ * Merge source answers that describe the same thing: the same package version
+ * and overlapping ID sets (a GHSA, its CVE and its OSV record are one finding,
+ * reported once with every source that saw it — 2.4).
+ */
+export function mergeFindings(raw: RawFinding[]): RawFinding[][] {
+    const groups: Array<{ ids: Set<string>; items: RawFinding[]; pkg: string }> = [];
+    for (const f of raw) {
+        const pkg = `${f.ecosystem}\0${f.package}\0${f.version ?? ''}`;
+        const ids = [f.id, ...f.aliases];
+        const hit = groups.find((g) => g.pkg === pkg && ids.some((i) => g.ids.has(i)));
+        if (hit) {
+            for (const i of ids) hit.ids.add(i);
+            hit.items.push(f);
+        } else {
+            groups.push({ ids: new Set(ids), items: [f], pkg });
+        }
+    }
+    return groups.map((g) => g.items);
+}
+
+/** The verdict, from the strongest fact any source asserted (2.2). */
+export function verdictOf(items: RawFinding[], now: Date, acceptances: Acceptance[], ids: string[]): { verdict: Verdict; note: string | null } {
+    const today = now.toISOString().slice(0, 10);
+    if (acceptances.some((a) => ids.includes(a.id) && a.expires >= today)) return { verdict: 'accepted', note: null };
+    if (items.some((f) => f.kind === 'malware')) return { verdict: 'malware', note: null };
+    const kinds = new Set(items.map((f) => f.kind));
+    if (kinds.has('pre-announced')) return { verdict: 'pre-announced', note: 'patched versions not yet named' };
+    if (kinds.has('eol')) return { verdict: 'eol', note: null };
+    if (kinds.has('eol-soon')) return { verdict: 'eol-soon', note: null };
+    const version = items[0]!.version;
+    if (version !== null && isVendorPatched(version)) {
+        // A distro carries its own backports; the upstream number says nothing (2.5).
+        return { verdict: 'unknown', note: 'vendor-patched — judge by the distro advisory' };
+    }
+    const fixed = items.map((f) => f.fixed).find((v) => v !== null) ?? null;
+    if (fixed !== null) return { verdict: 'fix-available', note: null };
+    if (items.every((f) => f.source === 'native-npm' || f.source === 'native-composer')) {
+        // A native audit names the problem without a per-advisory fixed version.
+        return { verdict: 'affected', note: null };
+    }
+    return { verdict: 'no-fix', note: null };
+}
+
+/**
+ * Deterministic tiers (3.1). T0 interrupts, T1 is today, T2 is the digest, T3
+ * is the ledger. KEV raises a tier and never lowers one.
+ */
+export function tierOf(f: Pick<Finding, 'verdict' | 'severity' | 'score' | 'kev' | 'scope' | 'ecosystem'>): Tier {
+    const runtimeScope = f.scope !== 'dev';
+    const critical = f.severity === 'critical' || (f.score !== null && f.score >= 9);
+    const high = f.severity === 'high' || (f.score !== null && f.score >= 7);
+    let tier: Tier;
+    switch (f.verdict) {
+        case 'malware':
+            return 'T0';
+        case 'accepted':
+            return 'T3';
+        case 'pre-announced':
+            tier = critical && f.ecosystem === 'runtime' ? 'T0' : 'T1';
+            break;
+        case 'eol':
+            tier = 'T1';
+            break;
+        case 'eol-soon':
+        case 'unknown':
+            tier = 'T2';
+            break;
+        default:
+            if (critical && runtimeScope && (f.verdict === 'fix-available' || f.verdict === 'fix-fresh')) tier = 'T0';
+            else if ((critical || high) && runtimeScope) tier = 'T1';
+            else if (critical || high || f.severity === 'moderate') tier = 'T2';
+            else tier = 'T3';
+    }
+    if (f.kev && runtimeScope && tier !== 'T0') tier = tier === 'T1' ? 'T0' : 'T1';
+    return tier;
+}
+
+/** Raw source answers → findings, one per real thing. */
+export function buildFindings(
+    raw: RawFinding[],
+    inventory: InventoryEntry[],
+    reports: SourceReport[],
+    opts: { now?: Date; acceptances?: Acceptance[] } = {},
+): Finding[] {
+    const now = opts.now ?? new Date();
+    const out: Finding[] = [];
+    for (const items of mergeFindings(raw)) {
+        const ids = [...new Set(items.flatMap((f) => [f.id, ...f.aliases]))];
+        const id = canonical(ids);
+        const first = items[0]!;
+        const scope = inventory.find((e) => e.name === first.package && e.file === first.file)?.scope ?? null;
+        const { verdict, note } = verdictOf(items, now, opts.acceptances ?? [], ids);
+        const base = {
+            verdict,
+            severity: items.map((f) => f.severity).reduce(stronger, null as Severity),
+            score: items.map((f) => f.score).find((s) => s !== null) ?? null,
+            kev: items.some((f) => f.kev),
+            scope,
+            ecosystem: first.ecosystem,
+        };
+        out.push({
+            key: `${id}|${first.package}|${first.version ?? ''}`,
+            id,
+            aliases: ids.filter((i) => i !== id).sort(),
+            tier: tierOf(base),
+            package: first.package,
+            version: first.version,
+            fixed: items.map((f) => f.fixed).find((v) => v !== null) ?? null,
+            date: items.map((f) => f.date).find((v) => v !== null) ?? null,
+            sources: [...new Set(items.map((f) => f.source))].sort(),
+            modified: items.map((f) => f.modified).filter((m): m is string => m !== null).sort().pop() ?? null,
+            file: first.file,
+            line: first.line,
+            note,
+            ...base,
+        });
+    }
+    // Silence is a verdict, never an empty list (F6): every source that did not
+    // answer becomes one `unknown` finding naming it.
+    for (const r of reports) {
+        if (r.status === 'ok') continue;
+        if (r.reason === 'private-names-present') continue; // a deliberate skip, not silence
+        out.push({
+            key: `UNKNOWN-${r.source}`,
+            id: `UNKNOWN-${r.source}`,
+            aliases: [],
+            verdict: 'unknown',
+            tier: 'T2',
+            ecosystem: 'runtime',
+            package: r.source,
+            version: null,
+            fixed: null,
+            severity: null,
+            score: null,
+            kev: false,
+            date: null,
+            scope: null,
+            sources: [r.source],
+            modified: null,
+            file: '',
+            line: 0,
+            note: `source-${r.status}${r.reason === null ? '' : `: ${r.reason}`}`,
+        });
+    }
+    const order: Record<Tier, number> = { T0: 0, T1: 1, T2: 2, T3: 3 };
+    return out.sort((a, b) => order[a.tier] - order[b.tier] || a.key.localeCompare(b.key));
+}
+
+// ---------------------------------------------------------------------------
+// The delta ledger and the noise budget
+// ---------------------------------------------------------------------------
+
+export interface LedgerEntry {
+    tier: Tier;
+    verdict: Verdict;
+    modified: string | null;
+    first_seen: string;
+    announced_at: string | null;
+}
+
+export interface Ledger {
+    entries: Record<string, LedgerEntry>;
+    /** ISO stamps of interrupting announcements, pruned to the last seven days. */
+    interrupts: string[];
+    /** Recorded transitions — a corrected advisory or a verdict change (2.5). */
+    transitions: Array<{ at: string; key: string; from: string; to: string }>;
+}
+
+/** At most this many interrupting notices per project per week; the rest go to the digest (0.3). */
+export const INTERRUPT_BUDGET_PER_WEEK = 3;
+
+export function emptyLedger(): Ledger {
+    return { entries: {}, interrupts: [], transitions: [] };
+}
+
+const RANK: Record<Tier, number> = { T0: 0, T1: 1, T2: 2, T3: 3 };
+
+export interface Announcement {
+    interrupt: Finding[];
+    digest: Finding[];
+    ledger: Ledger;
+}
+
+/**
+ * Only what is new, escalated or corrected is announced (3.2). T0/T1 interrupt
+ * until the weekly budget is spent, then fall into the digest — a fourth T1 in
+ * a week is still reported, just not as an interruption.
+ */
+export function announce(findings: Finding[], previous: Ledger, now: Date = new Date()): Announcement {
+    const at = now.toISOString();
+    const weekAgo = now.getTime() - 7 * 86400000;
+    const ledger: Ledger = {
+        entries: { ...previous.entries },
+        interrupts: previous.interrupts.filter((t) => Date.parse(t) >= weekAgo),
+        transitions: [...previous.transitions],
+    };
+    const interrupt: Finding[] = [];
+    const digest: Finding[] = [];
+    for (const f of findings) {
+        const old = ledger.entries[f.key];
+        const isNew = old === undefined;
+        const escalated = old !== undefined && RANK[f.tier] < RANK[old.tier];
+        const corrected = old !== undefined && f.modified !== null && old.modified !== null && f.modified !== old.modified;
+        const verdictMoved = old !== undefined && old.verdict !== f.verdict;
+        if (corrected || verdictMoved) {
+            ledger.transitions.push({ at, key: f.key, from: `${old!.verdict}/${old!.tier}`, to: `${f.verdict}/${f.tier}` });
+        }
+        ledger.entries[f.key] = {
+            tier: f.tier,
+            verdict: f.verdict,
+            modified: f.modified,
+            first_seen: old?.first_seen ?? at,
+            announced_at: old?.announced_at ?? null,
+        };
+        if (!(isNew || escalated || corrected || verdictMoved)) continue;
+        if ((f.tier === 'T0' || f.tier === 'T1') && ledger.interrupts.length < INTERRUPT_BUDGET_PER_WEEK) {
+            interrupt.push(f);
+            ledger.interrupts.push(at);
+        } else if (f.tier !== 'T3') {
+            digest.push(f);
+        }
+        ledger.entries[f.key]!.announced_at = at;
+    }
+    return { interrupt, digest, ledger };
+}
+
+/** An acceptance needs a reason and an expiry; a grep-negative is not a reason (3.3, K4). */
+export function validateAcceptance(a: Partial<Acceptance>): string | null {
+    if (typeof a.id !== 'string' || a.id === '') return 'an acceptance names the finding ID';
+    if (typeof a.reason !== 'string' || a.reason.trim().length < 10) return 'an acceptance carries a reason of at least a sentence';
+    if (/\b(grep|not (found|used|reachable)|no (hits|matches|usage))\b/i.test(a.reason)) {
+        return 'absence of a hit is not unreachability — name what makes the code path unreachable';
+    }
+    if (typeof a.expires !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(a.expires)) return 'an acceptance carries an expiry day (YYYY-MM-DD)';
+    return null;
+}
diff --git a/src/scripts/_lib/security_fix.ts b/src/scripts/_lib/security_fix.ts
new file mode 100644
index 0000000000000000000000000000000000000000..05c48328f18d8a9bb55aad61383f478c36e88cff
--- /dev/null
+++ b/src/scripts/_lib/security_fix.ts
@@ -0,0 +1,356 @@
+/**
+ * The decidable half of carrying a security finding to a merged, deployed fix
+ * (road-to-security-fixes-carried-to-the-merge).
+ *
+ * Council 2026-10-21 Q5 (2/2): the package-manager mutations stay in the
+ * agent's session, where a person sees them; what can be decided without
+ * judgement lives here, deterministic and fixture-tested — the route, the
+ * smallest fixing change, the runtime file edits, the cooldown and
+ * agent-directory checks, the "fixed by the authority's own answer" comparison,
+ * the PR body, the release draft, and the lifecycle up to `fixed-deployed`.
+ * Nothing here merges, tags, publishes or deploys.
+ */
+
+import type { InventoryEntry } from './advisory_inventory.js';
+import type { Finding } from './advisory_verdicts.js';
+import { compare_versions } from './version_order.js';
+
+// ---------------------------------------------------------------------------
+// Where the fix goes (Phase 2)
+// ---------------------------------------------------------------------------
+
+export interface RoutingContext {
+    /** HEAD is the trunk (or detached on it). */
+    onTrunk: boolean;
+    /** The working tree has no uncommitted change. */
+    clean: boolean;
+    /** The current branch already changes the lockfile/manifest the fix touches. */
+    branchTouchesFile: boolean;
+    /** The current branch introduced the vulnerable dependency. */
+    branchIntroducedDependency: boolean;
+    /** The user asked for the fix in the current branch. */
+    userWantsCurrent: boolean;
+    /** An open bot PR that already moves this package to a fixing version. */
+    openBotPr: number | null;
+    /** The project publishes releases (a package, not an application). */
+    isLibrary: boolean;
+    /** The finding is a runtime, not a package. */
+    isRuntime: boolean;
+}
+
+export type Route = 'new-branch-here' | 'worktree' | 'current-branch' | 'complete-bot-pr';
+
+export interface RoutingDecision {
+    route: Route;
+    /** Prepare a patch-release draft and stop before the tag (2.4). */
+    releaseDraft: boolean;
+    /** List what no file controls — hosting, a base image built elsewhere (1.2). */
+    opsChecklist: boolean;
+    /** After the fix merges, offer the feature branch a rebase onto the new trunk. */
+    rebaseOfferAfterMerge: boolean;
+    /** One sentence the offer shows with the route. */
+    reason: string;
+}
+
+/**
+ * The routing table of 2.1, first matching row wins. Security fixes travel
+ * alone unless the bug lives in the current branch (D1).
+ */
+export function routeSecurityFix(c: RoutingContext): RoutingDecision {
+    const extras = { releaseDraft: c.isLibrary, opsChecklist: c.isRuntime };
+    if (c.openBotPr !== null) {
+        return { route: 'complete-bot-pr', rebaseOfferAfterMerge: false, ...extras, reason: `bot PR #${c.openBotPr} already moves this dependency — complete it rather than open a second` };
+    }
+    if (c.userWantsCurrent || c.branchIntroducedDependency) {
+        return {
+            route: 'current-branch',
+            rebaseOfferAfterMerge: false,
+            ...extras,
+            reason: c.branchIntroducedDependency
+                ? 'this branch introduced the dependency — fixing it elsewhere would leave this PR shipping it'
+                : 'asked for in the current branch',
+        };
+    }
+    if (c.onTrunk && c.clean) {
+        return { route: 'new-branch-here', rebaseOfferAfterMerge: false, ...extras, reason: 'on the trunk with a clean tree — nothing to isolate from' };
+    }
+    if (c.branchTouchesFile) {
+        return { route: 'worktree', rebaseOfferAfterMerge: true, ...extras, reason: 'the feature branch changes the same file — the fix travels alone, the feature rebases onto it after the merge' };
+    }
+    return { route: 'worktree', rebaseOfferAfterMerge: false, ...extras, reason: 'a feature is in progress — the fix travels alone, mergeable and releasable without it' };
+}
+
+// ---------------------------------------------------------------------------
+// The smallest fixing change (Phase 1)
+// ---------------------------------------------------------------------------
+
+export interface FixPlan {
+    /** Shell commands the agent runs in the fix branch, in order. */
+    commands: string[];
+    /** Exact file edits for a runtime fix. */
+    edits: Array<{ file: string; line: number; from: string; to: string }>;
+    /** What no file in the repository controls. */
+    opsChecklist: string[];
+    /** Why this is the smallest change. */
+    note: string;
+}
+
+function shellArg(v: string): string {
+    return /^[A-Za-z0-9@._/:+=-]+$/.test(v) ? v : `'${v.replace(/'/g, `'\\''`)}'`;
+}
+
+/**
+ * Smallest fixing version inside the current constraint first; a constraint
+ * change only when the fix is outside it; never `audit fix --force`, never an
+ * unannounced major (1.1).
+ */
+export function fixPlan(f: Finding, inventory: InventoryEntry[]): FixPlan {
+    if (f.ecosystem === 'runtime') return runtimePlan(f, inventory);
+    if (f.fixed === null) {
+        return { commands: [], edits: [], opsChecklist: [], note: 'no fixing version exists — offer a mitigation instead (1.5)' };
+    }
+    const major = (v: string | null): string | null => (v === null ? null : (/^(\d+)/.exec(v)?.[1] ?? null));
+    const crossesMajor = major(f.version) !== null && major(f.fixed) !== null && major(f.version) !== major(f.fixed);
+    const pkg = shellArg(f.package);
+    const fixed = shellArg(f.fixed);
+    if (f.ecosystem === 'npm') {
+        const direct = inventory.some((e) => e.file.endsWith('package.json') && e.name === f.package);
+        return {
+            commands: direct ? [`npm install ${pkg}@^${fixed} --save-exact=false`] : [`npm update ${pkg}`, `npm ls ${pkg}`],
+            edits: [],
+            opsChecklist: [],
+            note: crossesMajor
+                ? `the fix (${f.fixed}) is a new major — state the compatibility analysis before running it`
+                : direct
+                  ? 'raise the direct dependency to the fixing version inside its range'
+                  : `transitive: \`npm update\` within the existing ranges; if ${f.package} stays below ${f.fixed}, add an \`overrides\` entry for it, never \`npm audit fix --force\``,
+        };
+    }
+    if (f.ecosystem === 'Packagist') {
+        return {
+            commands: [`composer update ${pkg} --with-dependencies`, `composer show ${pkg}`],
+            edits: [],
+            opsChecklist: [],
+            note: crossesMajor
+                ? `the fix (${f.fixed}) is a new major — change the constraint deliberately and state the compatibility analysis`
+                : 'update this package and what it needs within the current constraints; change composer.json only if the fixing version is outside them',
+        };
+    }
+    return { commands: [], edits: [], opsChecklist: [], note: `${f.ecosystem} fixes are a manual pin change to ${f.fixed}` };
+}
+
+/** Every file that pins the runtime changes in one commit; what no file controls is listed (1.2). */
+function runtimePlan(f: Finding, inventory: InventoryEntry[]): FixPlan {
+    const to = f.fixed;
+    if (to === null) {
+        return { commands: [], edits: [], opsChecklist: [], note: 'no fixed runtime release is named yet — prepare, do not invent a version' };
+    }
+    const pins = inventory.filter((e) => e.ecosystem === 'runtime' && e.name === f.package && e.version !== null);
+    const edits = pins
+        .filter((e) => compare_versions(e.version, to) === -1)
+        .map((e) => ({ file: e.file, line: e.line, from: e.version!, to }));
+    const runtimeName = f.package === 'node' ? 'Node.js' : f.package === 'php' ? 'PHP' : f.package;
+    return {
+        commands: [],
+        edits,
+        opsChecklist: [
+            `every host or managed service that runs ${runtimeName} outside these files: move it to ${to} or later`,
+            'any base image built in another repository from these pins: rebuild it',
+            'after the deploy: confirm the running version (`php -v` / `node -v`) on each environment',
+        ],
+        note: `${edits.length} pinning file(s) move to ${to}; a declared range that already admits ${to} is left alone`,
+    };
+}
+
+// ---------------------------------------------------------------------------
+// Cooldown and provenance (1.3)
+// ---------------------------------------------------------------------------
+
+/** A fixing release younger than this is `fix-fresh` and gets the post-update audit first. */
+export const COOLDOWN_DAYS = 3;
+
+export function isFixFresh(releasedAt: string | null, now: Date = new Date()): boolean {
+    if (releasedAt === null) return false;
+    const t = Date.parse(releasedAt);
+    return Number.isFinite(t) && now.getTime() - t < COOLDOWN_DAYS * 86400000;
+}
+
+/**
+ * Paths a dependency update must never touch: agent configuration (a 2026 worm
+ * persisted through a session-start hook there) and install scripts. Any of
+ * them in the fix diff stops the fix.
+ */
+export function suspiciousPaths(changed: string[], packageJsonScripts: { before: Record<string, string>; after: Record<string, string> } | null = null): string[] {
+    const hits = changed.filter((p) => /^(\.claude|\.vscode|\.cursor|\.github\/workflows)\//.test(p));
+    if (packageJsonScripts !== null) {
+        for (const k of ['preinstall', 'install', 'postinstall', 'prepare']) {
+            if (packageJsonScripts.before[k] !== packageJsonScripts.after[k]) hits.push(`package.json scripts.${k}`);
+        }
+    }
+    return hits;
+}
+
+// ---------------------------------------------------------------------------
+// Proof it is fixed (1.4)
+// ---------------------------------------------------------------------------
+
+export type FixProof = 'fixed-in-branch' | 'fix-failed' | 'unverifiable';
+
+/**
+ * The same authority that reported the finding must stop reporting it on the
+ * changed lockfile. An authority that did not answer proves nothing either way.
+ */
+export function proveFixed(key: string, sourcesBefore: string[], after: { findings: Finding[]; okSources: string[] }): FixProof {
+    const reporters = sourcesBefore.filter((s) => after.okSources.includes(s));
+    if (reporters.length === 0) return 'unverifiable';
+    const still = after.findings.find((f) => f.key === key || (f.id === key.split('|')[0] && f.package === key.split('|')[1]));
+    if (still === undefined) return 'fixed-in-branch';
+    return still.sources.some((s) => reporters.includes(s)) ? 'fix-failed' : 'fixed-in-branch';
+}
+
+// ---------------------------------------------------------------------------
+// The PR and the release (2.3, 2.4)
+// ---------------------------------------------------------------------------
+
+export function branchName(f: Finding): string {
+    const slug = (s: string): string => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 40);
+    return `security/${slug(f.package)}-${slug(f.id)}`;
+}
+
+export function prTitle(f: Finding): string {
+    const ids = [f.id, ...f.aliases].slice(0, 2).join(', ');
+    return `fix(security): ${f.package} ${f.version ?? '?'} → ${f.fixed ?? '?'} (${ids})`;
+}
+
+export interface PrEvidence {
+    before: string;
+    after: FixProof;
+    tests: 'passed' | 'failed' | 'not-run';
+    cooldown: string;
+    deploy: string;
+}
+
+/** The seven fields every security PR carries. */
+export function prBody(f: Finding, e: PrEvidence): string {
+    return [
+        `## Security fix — ${f.package}`,
+        '',
+        `- **Finding:** ${[f.id, ...f.aliases].join(', ')}`,
+        `- **Tier:** ${f.tier} (${f.verdict}${f.severity === null ? '' : `, ${f.severity}`})`,
+        `- **Before:** ${e.before}`,
+        `- **After:** ${e.after === 'fixed-in-branch' ? 'the reporting source no longer reports it on this branch' : e.after}`,
+        `- **Tests:** ${e.tests}`,
+        `- **Cooldown / provenance:** ${e.cooldown}`,
+        `- **Deploy:** ${e.deploy}`,
+        '',
+        'Security-only: no unrelated change rides along. Merge, tag and deploy stay with the owner.',
+    ].join('\n');
+}
+
+/** Next patch version and a changelog entry naming the advisory IDs (2.4). Stops before the tag. */
+export function releaseDraft(currentVersion: string, fixes: Finding[]): { version: string; changelog: string } | null {
+    const m = /^(\d+)\.(\d+)\.(\d+)/.exec(currentVersion);
+    if (m === null) return null;
+    const version = `${m[1]}.${m[2]}.${Number(m[3]) + 1}`;
+    const lines = fixes.map((f) => `- ${f.package} ${f.version ?? '?'} → ${f.fixed ?? '?'} (${[f.id, ...f.aliases].join(', ')})`);
+    return { version, changelog: [`## ${version}`, '', '### Security', '', ...lines].join('\n') };
+}
+
+// ---------------------------------------------------------------------------
+// Following the fix to production (Phase 3)
+// ---------------------------------------------------------------------------
+
+export type RemediationState =
+    | 'fix-in-progress'
+    | 'ready-to-merge'
+    | 'fixed-in-trunk'
+    | 'fixed-released'
+    | 'fixed-deployed'
+    | 'fix-failed'
+    | 'mitigated';
+
+export interface Remediation {
+    key: string;
+    state: RemediationState;
+    /** One open fix per finding fingerprint; a second session joins this one (3.3). */
+    owner_session: string | null;
+    branch: string | null;
+    pr: number | null;
+    merge_sha: string | null;
+    stamps: Partial<Record<RemediationState, string>>;
+    /** A mitigation's note, when no fix exists (1.5). */
+    note: string | null;
+}
+
+export type Remediations = Record<string, Remediation>;
+
+/**
+ * Start a fix, or join the one already open for this finding. Returns the
+ * remediation the caller must work on and whether it is new.
+ */
+export function claimRemediation(all: Remediations, key: string, session: string, now: Date = new Date()): { remediation: Remediation; joined: boolean } {
+    const open = all[key];
+    if (open !== undefined && (open.state === 'fix-in-progress' || open.state === 'ready-to-merge')) {
+        return { remediation: open, joined: true };
+    }
+    const at = now.toISOString();
+    const r: Remediation = { key, state: 'fix-in-progress', owner_session: session, branch: null, pr: null, merge_sha: null, stamps: { 'fix-in-progress': at }, note: null };
+    all[key] = r;
+    return { remediation: r, joined: false };
+}
+
+export function advance(r: Remediation, to: RemediationState, now: Date = new Date(), extra: Partial<Pick<Remediation, 'branch' | 'pr' | 'merge_sha' | 'note'>> = {}): Remediation {
+    r.state = to;
+    r.stamps[to] = now.toISOString();
+    Object.assign(r, extra);
+    return r;
+}
+
+export interface TrackSignals {
+    /** The fix PR merged, with its merge commit. */
+    mergedSha: string | null;
+    /** A release tag contains the merge commit. */
+    releaseContains: boolean;
+    /** The project exposes a deploy signal that saw the merge commit (a deploy run, an environment, or the user's word). */
+    deployed: boolean;
+}
+
+/** Move a remediation forward on observed signals only; never backward, never on a guess (3.1). */
+export function track(r: Remediation, s: TrackSignals, now: Date = new Date()): Remediation {
+    if (r.state === 'fix-in-progress' || r.state === 'ready-to-merge') {
+        if (s.mergedSha !== null) advance(r, 'fixed-in-trunk', now, { merge_sha: s.mergedSha });
+    }
+    if (r.state === 'fixed-in-trunk' && s.releaseContains) advance(r, 'fixed-released', now);
+    if ((r.state === 'fixed-in-trunk' || r.state === 'fixed-released') && s.deployed) advance(r, 'fixed-deployed', now);
+    return r;
+}
+
+/** Merged but not deployed after this long stays in the notice (3.2). */
+export const UNDEPLOYED_AFTER_HOURS = 24;
+
+export function mergedNotDeployed(all: Remediations, findings: Finding[], now: Date = new Date()): string[] {
+    const byKey = new Map(findings.map((f) => [f.key, f]));
+    const lines: string[] = [];
+    for (const r of Object.values(all)) {
+        if (r.state !== 'fixed-in-trunk' && r.state !== 'fixed-released') continue;
+        const since = r.stamps['fixed-in-trunk'];
+        if (since === undefined || now.getTime() - Date.parse(since) < UNDEPLOYED_AFTER_HOURS * 3600000) continue;
+        const f = byKey.get(r.key);
+        if (f !== undefined && f.tier !== 'T0' && f.tier !== 'T1') continue;
+        lines.push(`advisory ${r.key.split('|')[0]}: merged${r.merge_sha === null ? '' : ` (${r.merge_sha.slice(0, 9)})`} but not deployed for ${Math.floor((now.getTime() - Date.parse(since)) / 3600000)} h — deploy it the way this project deploys`);
+    }
+    return lines;
+}
+
+/** A mitigated finding reopens the moment a refresh reports a fix for it (1.5). */
+export function reopenMitigations(all: Remediations, findings: Finding[]): string[] {
+    const reopened: string[] = [];
+    for (const f of findings) {
+        const r = all[f.key];
+        if (r?.state === 'mitigated' && f.fixed !== null) {
+            delete all[f.key];
+            reopened.push(f.key);
+        }
+    }
+    return reopened;
+}
