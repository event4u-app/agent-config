+    installInto(extras);
+    fs.writeFileSync(path.join(extras, "pre-commit.bak-20260729"), "stale backup\n");
+    fs.writeFileSync(path.join(extras, "commit-msg.sample"), "sample\n");
+    expect(runGate(extras).code).toBe(0);
