+        hooksDir,
+        verdicts,
+        // "Never installed" means nothing is THERE. An unreadable hook is
+        // there, so it must not be swallowed by the fresh-clone branch.
+        neverInstalled: verdicts.every((v) => v.state === 'missing'),
+    };
+}
