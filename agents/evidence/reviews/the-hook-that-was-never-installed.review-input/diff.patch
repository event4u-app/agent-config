+export function resolveHooksDir(repoRoot: string): string {
+    const res = spawnSync('git', ['-C', repoRoot, 'rev-parse', '--git-path', 'hooks'], {
+        encoding: 'utf-8',
+        timeout: GIT_TIMEOUT_MS,
+    });
