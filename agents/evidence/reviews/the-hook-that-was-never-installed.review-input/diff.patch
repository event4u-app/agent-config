+// unwritable TMPDIR leaves the push hanging with no diagnostic, and the
+// "could not render" branch is only reached if the child returns at all.
+const GIT_TIMEOUT_MS = 5_000;
+const INSTALLER_TIMEOUT_MS = 30_000;
