index 0000000000000000000000000000000000000000..5cb1f20c4adb1c4a6ad8848bbeead1f8ebb644e4
--- /dev/null
+++ b/tests/scripts/analysis_gate_surfacing.test.ts
@@ -0,0 +1,51 @@
+/**
+ * AC-4 of `road-to-an-analysis-family-that-deepens-itself` has two halves, and
+ * only one of them was pinned.
+ *
+ * `analysis_gate.test.ts` pins the DECISION: the round cap before the stop
+ * predicate, no fourth round, the next-call score as an estimate that never
+ * decides. Nothing pinned that the run SHOWS those numbers, or that a further
+ * round needs a recorded council or owner decision rather than the engine's
+ * own `offer: true`. A gate whose numbers are never printed is a gate nobody
+ * can audit after the fact — the run reads as "it ran one more round" with no
+ * trace of why.
+ *
+ * Two assertions, both over the shared context file every door links, so the
+ * obligation lands once rather than four times.
+ */
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+import { describe, expect, it } from 'vitest';
+
+import { evaluateGate, MAX_ROUNDS } from '../../src/scripts/analysis_gate.js';
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..', '..');
+const CONTEXT = path.join(ROOT, 'src/agent-src/contexts/execution/analysis-loop.md');
+const text = fs.readFileSync(CONTEXT, 'utf-8');
+
+describe('the gate is shown, not only obeyed', () => {
+    it('the context names every field of the gate result as a thing the run prints', () => {
+        for (const field of ['reason', 'settleable', 'band', 'estimate']) {
+            expect(text).toContain(`\`${field}\``);
+        }
+        expect(text).toMatch(/after every exchange/iu);
+    });
+
+    it('a further round needs a recorded decision, never the offer alone', () => {
+        expect(text).toMatch(/offer is not a decision|never the offer alone|an offer is not/iu);
+        expect(text).toMatch(/recorded (council|owner)/iu);
+    });
+
+    it('the printed fields are the ones the gate actually returns', () => {
+        const result = evaluateGate({ roundsCompleted: MAX_ROUNDS, items: [], remainingTokens: 0, stop: {
+            round: MAX_ROUNDS,
+            newArguments: 0,
+            repairedConformity: true,
+        } as never });
+        for (const field of ['reason', 'settleable', 'band', 'estimate']) {
+            expect(Object.keys(result)).toContain(field);
+        }
+    });
+});
diff --git a/tests/scripts/analysis_scope_line_doors.test.ts b/tests/scripts/analysis_scope_line_doors.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..44d568b0ab6a1d28f7224367b8da4ef28fe2b2bf
--- /dev/null
+++ b/tests/scripts/analysis_scope_line_doors.test.ts
@@ -0,0 +1,57 @@
+/**
+ * AC-1 of `road-to-an-analysis-family-that-deepens-itself`: from a subfolder
+ * EVERY one of the four ADR-288 doors prints the scope line before any read.
+ *
+ * `analysis_target.test.ts` pins the resolver — that a module without a marker
+ * places under the outer project, that `project_root` stays the outer one. It
+ * cannot see whether a door actually calls it, and the source door did not,
+ * so an invocation there printed no scope at all. This is the per-door half:
+ * one assertion per door, so a door that drops the line fails here rather than
+ * in a run nobody replays.
+ *
+ * The contract is the obligation, not one phrasing: a door satisfies it by
+ * naming the scope line (or the template `analysis-loop` defines) and saying,
+ * within that sentence, that it comes first.
+ */
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+import { describe, expect, it } from 'vitest';
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..', '..');
+const DOORS = ['repo', 'and-optimize', 'pr', 'inbox'] as const;
+/** `scope line`, or the template itself, which is the same obligation spelled out. */
+const MENTION = /scope line|Scope: <repo\|module\|subdir>/gu;
+const FIRST = /\bfirst\b|\bbefore any read\b|\bbefore it reads\b/u;
+
+function door(name: string): string {
+    return fs.readFileSync(
+        path.join(ROOT, 'src/domains/analysis-workbench/analyze', name, 'command.md'),
+        'utf-8',
+    );
+}
+
+describe('the four doors resolve and print one scope', () => {
+    for (const name of DOORS) {
+        it(`${name} prints the scope line before it reads`, () => {
+            const text = door(name);
+            const windows = [...text.matchAll(MENTION)].map((m) =>
+                text.slice(Math.max(0, m.index - 200), m.index + 200),
+            );
+            expect(windows.length).toBeGreaterThan(0);
+            expect(windows.some((w) => FIRST.test(w))).toBe(true);
+        });
+    }
+
+    it('every door links the context that defines the line and names its resolver', () => {
+        for (const name of DOORS) {
+            expect(door(name)).toContain('](../../contexts/execution/analysis-loop.md)');
+        }
+        const ctx = fs.readFileSync(
+            path.join(ROOT, 'src/agent-src/contexts/execution/analysis-loop.md'),
+            'utf-8',
+        );
+        expect(ctx).toContain('analysis_target.ts');
+    });
+});
