diff --git a/tests/scripts/source_snapshot_dedup.test.ts b/tests/scripts/source_snapshot_dedup.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b23b7ca108f36f3083eddc5b49a32c9ae555eabf
