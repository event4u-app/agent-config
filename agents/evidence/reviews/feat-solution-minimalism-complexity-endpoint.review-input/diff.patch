+
+    it('analyse() carries one size-claim row per rendered comparison', () => {
+        const payload = {
+            arms: ['vanilla', 'package'],
+            records: [
+                {
+                    id: 't1',
+                    arms: {
+                        vanilla: runs({ added: 30, cc: 3, safe: true }),
