+        // one: a report of "6 merges red" with no total is a number nobody can
+        // place.
+        for (const raw of patch.stdout.split('\n')) {
+            if (!raw.startsWith('+') || raw.startsWith('+++')) continue;
+            const clause = parseVerifyClause(raw.slice(1));
