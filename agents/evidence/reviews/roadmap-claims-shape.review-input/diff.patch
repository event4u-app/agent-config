+            added += 1;
+            if (clause.expect !== null) withExpectation += 1;
+        }
+        const hits = bareClausesIn(patch.stdout);
+        bare.push(...hits);
+        if (hits.length > 0) redMerges.push({ merge: m, bare: hits.length });
