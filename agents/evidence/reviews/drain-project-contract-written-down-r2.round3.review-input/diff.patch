+/**
+ * How each host spells a permission deny rule, and where that spelling was
+ * read from.
+ *
+ * `road-to-a-project-contract-written-down` step 2.1 named
+ * `src/scripts/hooks/host_lowering.yaml` as the home for this pin. It is not
+ * the home, and the departure is recorded in the roadmap's Decisions table
+ * rather than taken quietly. The measurement that forced it:
+ *
+ *   - That table is keyed `(host, surface, slot)` and its own header states
+ *     its subject — "how each host lowers a dispatcher verdict into its own
+ *     hook contract". A permission deny rule has no slot and no verdict; it is
+ *     consulted BEFORE a tool runs, not after a hook dispatches.
+ *   - `_structure()` there reads only named hook keys, so a `permissions:`
+ *     block added to the YAML would be dropped from the typed table and read
+ *     by nobody, while still moving the compiled body's fingerprint.
+ *
+ * Put to the AI council on 2026-10-13 (anthropic + openai, 2/2 present, both
+ * seats converging): place the fact here, keep the classifier host-neutral,
+ * and let a provenance gate stand in for the plumbing ratification the hook
+ * table would have carried.
+ *
+ * ```
+ * THE CLASSIFIER DECIDES WHAT A BULLET MEANS. THIS DECIDES HOW A HOST SPELLS IT.
+ * A HOST ABSENT FROM THE TABLE IS A HOST NOBODY ESTABLISHED — NEVER A REFUSAL.
+ * ```
+ */
+
+import type { NoGoClassification } from './noGoRules.js';
+
+/**
+ * Everything a later reader needs to re-check one host's spelling.
+ *
+ * `examples` are VERBATIM quotes from the page at `docs_url`, as read on
+ * `docs_at`. They are the grammar the renderer is checked against by
+ * `check_permission_deny_syntax`; they are not independent of the renderer in
+ * the way a live probe would be, and that limit is stated here rather than
+ * implied — see that gate's own honesty note.
+ */
+export interface HostPermissionSyntax {
+    readonly host: string;
+    readonly docs_url: string;
+    /** The day the page was read, ISO. */
+    readonly docs_at: string;
+    /**
+     * Review-by date for this row. No host this package supports publishes a
+     * documentation cadence, so this is a date THIS PACKAGE chose — `docs_at`
+     * plus a year — and never a vendor commitment. The same convention
+     * `host_lowering.yaml` states for its own `expires`.
+     */
+    readonly expires: string;
+    /** Where a row goes in the settings file, as a dotted key path. */
+    readonly deny_key: string;
+    /** Verbatim rule spellings from the page. */
+    readonly examples: readonly string[];
+}
+
+export const HOST_PERMISSION_SYNTAX: Readonly<Record<string, HostPermissionSyntax>> = {
+    claude: {
+        host: 'claude',
+        docs_url: 'https://code.claude.com/docs/en/permissions.md',
+        docs_at: '2026-10-13',
+        expires: '2027-10-13',
+        deny_key: 'permissions.deny',
+        examples: [
+            // "Claude Code checks file permissions against `Edit(path)` and
+            // `Read(path)` rules only. … Use `Edit(docs/**)` in place of
+            // `Write(docs/**)`, `NotebookEdit(docs/**)`, or `MultiEdit(docs/**)`."
+            'Edit(docs/**)',
+            // "To block Claude's file tools from reading a file or directory,
+            // add a `Read` deny rule for its path, such as `Read(./.env)` or
+            // `Read(./secrets/**)`."
+            'Read(./secrets/**)',
+            // "`Bash(npm run build)` | Matches the exact command `npm run build`"
+            'Bash(npm run build)',
+            // "A `*` at the end, with a space before it, also matches the bare
+            // command. `Bash(ls *)` matches `ls`, and `Bash(git log *)` matches
+            // `git log`. That holds only when the trailing `*` is the rule's
+            // only wildcard: `Bash(* --help *)` matches `npm --help x` but not
+            // `npm --help`."
+            'Bash(ls *)',
+        ],
+    },
+};
+
+/** The row for `host`, or `null` when nothing is established for it. */
+export function syntaxFor(host: string): HostPermissionSyntax | null {
+    return HOST_PERMISSION_SYNTAX[host] ?? null;
+}
+
+/**
+ * The path spec a rule carries.
+ *
+ * A trailing `/` means the directory's contents, which the host spells `/**`.
+ * Everything else is passed through as the consumer wrote it: "a deny or ask
+ * rule whose path isn't usable as a gitignore pattern still guards that exact
+ * path", and widening `src/generated` to `src/generated/**` on a guess would be
+ * the same guess the classifier refuses.
+ */
+function pathSpec(token: string): string {
+    return token.endsWith('/') ? `${token}**` : token;
+}
+
+/**
+ * The deny rows `c` becomes on `host`. Empty for prose, and empty for a host
+ * with no established row.
+ *
+ * A COMMAND BECOMES TWO ROWS, and the reason is NOT the one an earlier version
+ * of this comment gave. It claimed `Bash(x *)` never matches the bare `x`; the
+ * page says the opposite one line above the sentence that was read — "A `*` at
+ * the end, with a space before it, also matches the bare command." A review
+ * caught it, and it had reached the roadmap as that step's "one non-obvious
+ * finding", so the correction is recorded rather than quietly applied.
+ *
+ * The real reason is the page's own qualifier: the bare-command match "holds
+ * only when the trailing `*` is the rule's only wildcard". A consumer token
+ * carrying its own `*` breaks that, and the exact row is what still guards the
+ * plain command then. One row would be right for most tokens and silently
+ * wrong for those — Risk 3 in the register, "a rule in the wrong syntax is
+ * accepted by the file and enforced by nothing".
+ *
+ * A READ no-go renders `Read(...)` AND `Edit(...)`. The `Read` deny covers the
+ * Edit and Write tools on the same path, but the page names the exception:
+ * "NotebookEdit isn't covered, so add an `Edit` deny rule for paths no tool may
+ * change." A read no-go over a directory holding notebooks would otherwise
+ * leave NotebookEdit able to change it.
+ */
+export function denyRulesFor(host: string, c: NoGoClassification): readonly string[] {
+    if (syntaxFor(host) === null || c.action === null || c.token === null) return [];
+    if (c.kind === 'command') return [`Bash(${c.token})`, `Bash(${c.token} *)`];
+    if (c.kind === 'path') {
+        const spec = pathSpec(c.token);
+        return c.action === 'read' ? [`Read(${spec})`, `Edit(${spec})`] : [`Edit(${spec})`];
+    }
+    return [];
+}
diff --git a/src/install/noGoDenyRows.ts b/src/install/noGoDenyRows.ts
new file mode 100644
index 000000000..fae896a0a
--- /dev/null
+++ b/src/install/noGoDenyRows.ts
@@ -0,0 +1,368 @@
+/**
+ * The consent step between a classified no-go and a host deny list.
+ *
+ * `road-to-a-project-contract-written-down` step 2.2. Step 2.1 decides what a
+ * bullet WOULD become; nothing here happens without the consumer saying yes,
+ * and a no writes nothing at all.
+ *
+ * ```
+ * THE ROWS ARE SHOWN BEFORE THEY ARE WRITTEN. A DECLINE WRITES NOTHING.
+ * AN ENTRY THE CONSUMER ALREADY HAD SURVIVES THE APPEND BYTE FOR BYTE.
+ * A HOST WITH NO NATIVE DENY LIST GETS A REPORT, NEVER A FILE.
+ * ```
+ *
+ * WHY THE APPEND IS TEXTUAL. Parsing the settings file and re-serialising it
+ * would reformat a file the consumer owns — re-indenting it, dropping the key
+ * order a reader relies on, and rewriting lines this change has no business
+ * touching. Risk 4 in the roadmap's register is exactly that: "rewriting the
+ * settings file drops a user entry or reorders it". So the body is spliced:
+ * every byte outside the insertion point is the byte that was there before,
+ * which is a property a test can assert rather than a promise.
+ *
+ * The file is still PARSED first, to refuse a malformed one rather than splice
+ * into it.
+ */
+
+import { classifyNoGos, type NoGoClassification } from './noGoRules.js';
+import { denyRulesFor, syntaxFor } from './hostPermissionsAdapter.js';
+
+/**
+ * Does this tree know how `host` spells a deny rule?
+ *
+ * A host absent from the adapter is not a host that forbids the idea — it is a
+ * host for which nothing here has established a native deny list. The rows are
+ * then REPORTED and no file is touched, which is the honesty
+ * `host_lowering.yaml` keeps for an unestablished hook slot: absent means
+ * nobody established anything, never "cannot".
+ */
+export function hasNativeDenyList(host: string): boolean {
+    return syntaxFor(host) !== null;
+}
+
+/** A classified bullet together with what it spells on this host. */
+export interface PlannedRow {
+    readonly classification: NoGoClassification;
+    readonly rules: readonly string[];
+}
+
+/** What a run would do, before anything is written. */
+export interface DenyPlan {
+    /** Every bullet, classified and rendered, in file order. */
+    readonly rows: readonly PlannedRow[];
+    /** The deny rules the enforceable bullets produced, de-duplicated. */
+    readonly rules: readonly string[];
+    /** Bullets that stay instruction-only. */
+    readonly prose: readonly NoGoClassification[];
+    /** False when the host has no established deny list — then `rules` is a report. */
+    readonly enforceable: boolean;
+}
+
+export function planDenyRows(noGosSection: string, host: string): DenyPlan {
+    // Render against the one host whose spelling is established when the target
+    // host's is not, so an unsupported host still gets a REPORT of what its
+    // no-gos would become rather than an empty screen reading "nothing to do".
+    const renderHost = hasNativeDenyList(host) ? host : 'claude';
+    const classified = classifyNoGos(noGosSection);
+    const rows: PlannedRow[] = classified.map((c) => ({
+        classification: c,
+        rules: denyRulesFor(renderHost, c),
+    }));
+    const seen = new Set<string>();
+    const rules: string[] = [];
+    for (const r of rows) {
+        for (const rule of r.rules) {
+            if (seen.has(rule)) continue;
+            seen.add(rule);
+            rules.push(rule);
+        }
+    }
+    return {
+        rows,
+        rules,
+        prose: classified.filter((r) => r.kind === 'prose'),
+        enforceable: hasNativeDenyList(host),
+    };
+}
+
+/**
+ * The text shown before the one consent question.
+ *
+ * Every row names the bullet it came from. Risk 1 in the register is a broad
+ * row stopping an edit the consumer later needs "and the agent cannot say why";
+ * carrying the source bullet beside the rule is what lets it say why.
+ */
+export function renderDenyPlan(plan: DenyPlan, host: string): string {
+    const syntax = syntaxFor(plan.enforceable ? host : 'claude');
+    const out: string[] = [];
+    if (plan.rules.length === 0) {
+        out.push('No no-go bullet named a path or a command, so there is nothing to enforce.');
+    } else if (plan.enforceable) {
+        out.push(
+            `Deny rows for ${host} (${syntax?.deny_key ?? 'permissions.deny'}), one per enforceable no-go:`,
+            '',
+        );
+        for (const r of plan.rows) {
+            for (const rule of r.rules) out.push(`  ${rule}`);
+            if (r.rules.length > 0) out.push(`      from: ${r.classification.bullet}`);
+        }
+    } else {
+        out.push(
+            `${host} has no native deny list established in this tree, so these rows are a`,
+            'report and nothing is written. They are spelled the way `claude` spells a deny',
+            `rule, NOT the way ${host} does — nothing here has established that ${host} reads`,
+            'this syntax, or any syntax. They are what the no-gos would become there:',
+            '',
+        );
+        for (const r of plan.rows) for (const rule of r.rules) out.push(`  ${rule}`);
+    }
+    if (plan.prose.length > 0) {
+        out.push('', 'Instruction-only — no row was built, and the reason for each:');
+        for (const p of plan.prose) out.push(`  ${p.bullet}`, `      ${p.reason}`);
+    }
+    if (plan.rules.length > 0 && plan.enforceable) {
+        // What the rows do NOT cover, on the consent screen rather than in a
+        // comment. The point of the change is to replace a sentence the agent
+        // can read past with a rule the host refuses on; a consumer consenting
+        // to that should be told where the refusal stops.
+        out.push(
+            '',
+            'What these rows do not reach, per the same documentation:',
+            '  · a Bash rule is prefix-matched, so `./artisan …`, `bash -c "…"` and a',
+            '    wrapper such as `sail` or `devbox run` are not matched by it.',
+            '  · Read and Edit rules reach the file tools and the file commands the host',
+            '    recognises in Bash, but not a script that opens the file itself.',
+            '  A no-go is still worth writing down when no row can be built for it.',
+            '',
+            'Where they reach FURTHER than the bullet reads:',
+            '  · a path row anchors at the session working directory, not at the repository',
+            '    root, and as a DENY rule a single-segment path matches that directory name',
+            '    at any depth — `Edit(migrations/**)` also covers `vendor/pkg/migrations/`.',
+            '  · the rows go into a file your whole team shares if it is committed. The',
+            '    per-developer alternative is `.claude/settings.local.json`; pass it with',
+            '    `--settings` if these should bind only you.',
+        );
+    }
+    if (syntax !== null) {
+        out.push('', `Syntax read from ${syntax.docs_url} on ${syntax.docs_at}.`);
+    }
+    return `${out.join('\n')}\n`;
+}
+
+/* ------------------------------------------------------------------ *
+ * Locating a span inside a JSON body, without re-serialising it.
+ * ------------------------------------------------------------------ */
+
+interface Span {
+    /** Index of the opening `[` or `{`. */
+    readonly open: number;
+    /** Index of the matching closing `]` or `}`. */
+    readonly close: number;
+}
+
+/**
+ * Walk `text` as JSON and return the span of the value at `path`.
+ *
+ * A hand-rolled walk rather than a regex because a regex over JSON cannot tell
+ * a brace inside a string from a brace that nests, and a settings file holds
+ * both. Returns `null` when the path is absent or the body is not an object.
+ */
+function locate(text: string, path: readonly string[]): Span | null {
+    let i = 0;
+    const stack: string[] = [];
+    let pendingKey: string | null = null;
+    let target: Span | null = null;
+    const opens: number[] = [];
+
+    const matches = (depthPath: readonly string[]): boolean =>
+        depthPath.length === path.length && depthPath.every((s, n) => s === path[n]);
+
+    while (i < text.length) {
+        const ch = text[i] as string;
+        if (ch === '"') {
+            let j = i + 1;
+            while (j < text.length) {
+                if (text[j] === '\\') {
+                    j += 2;
+                    continue;
+                }
+                if (text[j] === '"') break;
+                j += 1;
+            }
+            const literal = text.slice(i + 1, j);
+            // A key is a string followed by a colon, inside an object.
+            let k = j + 1;
+            while (k < text.length && /\s/.test(text[k] as string)) k += 1;
+            if (text[k] === ':') pendingKey = literal;
+            i = j + 1;
+            continue;
+        }
+        if (ch === '{' || ch === '[') {
+            if (opens.length > 0 && pendingKey !== null) stack.push(pendingKey);
+            else if (opens.length > 0) stack.push('');
+            opens.push(i);
+            pendingKey = null;
+            if (matches(stack)) target = { open: i, close: -1 };
+            i += 1;
+            continue;
+        }
+        if (ch === '}' || ch === ']') {
+            const open = opens.pop();
+            if (target !== null && target.close === -1 && open === target.open) {
+                target = { open: target.open, close: i };
+            }
+            if (opens.length > 0) stack.pop();
+            // Clear it here too. A key is only pending for the container that
+            // opens right after it; carrying it across a close made the SECOND
+            // object in an array inherit the first one's last key, so
+            // `{"permissions": [{"deny": 1}, {"a": 2}]}` matched on the wrong
+            // element and spliced a bare string into an object.
+            pendingKey = null;
+            i += 1;
+            continue;
+        }
+        if (ch === ',') {
+            pendingKey = null;
+            i += 1;
+            continue;
+        }
+        i += 1;
+    }
+    return target !== null && target.close >= 0 ? target : null;
+}
+
+/** The indentation of the line `index` sits on. */
+function indentAt(text: string, index: number): string {
+    const lineStart = text.lastIndexOf('\n', index - 1) + 1;
+    const m = /^[ \t]*/.exec(text.slice(lineStart, index));
+    return m === null ? '' : (m[0] as string);
+}
+
+export interface AppendResult {
+    readonly text: string;
+    /** Rules actually inserted — a rule already present is not re-added. */
+    readonly added: readonly string[];
+    /** Rules skipped because the file already carried them. */
+    readonly alreadyPresent: readonly string[];
+}
+
+/**
+ * Append `rules` to the settings body's deny list.
+ *
+ * Three shapes, in order, and all three splice rather than rewrite:
+ *   1. `permissions.deny` exists — insert before its `]`.
+ *   2. `permissions` exists without `deny` — insert the key after its `{`.
+ *   3. neither — insert a whole `permissions` block after the root `{`.
+ *
+ * Throws on a body that is not a JSON object: refusing a malformed file is the
+ * only safe answer, since a splice into one would produce a second malformed
+ * file and lose the consumer's content.
+ */
+export function appendDenyRules(body: string, rules: readonly string[]): AppendResult {
+    const parsed: unknown = JSON.parse(body);
+    if (parsed === null || typeof parsed !== 'object' || Array.isArray(parsed)) {
+        throw new Error('settings body is not a JSON object');
+    }
+    const perms = (parsed as Record<string, unknown>)['permissions'];
+    // A `permissions` that is present but NOT an object has no span for
+    // `locate` to find, so without this the root branch below would insert a
+    // SECOND `"permissions"` key. The file stays parseable, the last key wins,
+    // and every row the consumer consented to is silently discarded while the
+    // command reports success — measured, and the defect this refusal exists
+    // for. Refusing is the only honest answer: merging would have to guess what
+    // the existing value meant.
+    if (
+        Object.hasOwn(parsed as Record<string, unknown>, 'permissions') &&
+        (perms === null || typeof perms !== 'object' || Array.isArray(perms))
+    ) {
+        throw new Error(
+            'settings body has a `permissions` key that is not an object — refusing rather ' +
+                'than writing a second one',
+        );
+    }
+    // The same refusal one level down, and it is NOT covered by the one above:
+    // `locate` finds no span for a `deny` that is not an array either, so the
+    // `permissions` branch would insert a SECOND `"deny"` key inside the same
+    // object — measured, with the consented row discarded and success
+    // reported. A `deny` that is a string or an object was worse still: the
+    // filter below threw `perms.deny?.filter is not a function`, which reached
+    // the consumer instead of the deliberate refusal written here.
+    const denyRaw =
+        perms !== null && typeof perms === 'object' && !Array.isArray(perms)
+            ? (perms as Record<string, unknown>)['deny']
+            : undefined;
+    if (
+        perms !== null &&
+        typeof perms === 'object' &&
+        !Array.isArray(perms) &&
+        Object.hasOwn(perms as Record<string, unknown>, 'deny') &&
+        !Array.isArray(denyRaw)
+    ) {
+        throw new Error(
+            'settings body has a `permissions.deny` key that is not an array — refusing ' +
+                'rather than writing a second one',
+        );
+    }
+    const existing: string[] = Array.isArray(denyRaw)
+        ? denyRaw.filter((e): e is string => typeof e === 'string')
+        : [];
+
+    const have = new Set(existing);
+    const added = rules.filter((r) => !have.has(r));
+    const alreadyPresent = rules.filter((r) => have.has(r));
+    if (added.length === 0) return { text: body, added, alreadyPresent };
+
+    const denySpan = locate(body, ['permissions', 'deny']);
+    if (denySpan !== null) {
+        const inner = body.slice(denySpan.open + 1, denySpan.close);
+        const closeIndent = indentAt(body, denySpan.open);
+        const indent = `${closeIndent}    `;
+        const entries = added.map((r) => `${indent}${JSON.stringify(r)}`).join(',\n');
+        if (inner.trim().length === 0) {
+            return {
+                text:
+                    `${body.slice(0, denySpan.open + 1)}\n${entries}\n${closeIndent}` +
+                    `${body.slice(denySpan.close)}`,
+                added,
+                alreadyPresent,
+            };
+        }
+        // Insert AFTER the last element rather than before the `]`, so the
+        // closing bracket keeps the line and the indentation it already had.
+        // Splicing at the bracket leaves the comma stranded on its own line and
+        // un-indents the `]` — a diff in a file the consumer owns, for nothing.
+        const lastChar = inner.replace(/\s+$/, '').length;
+        const at = denySpan.open + 1 + lastChar;
+        return {
+            text: `${body.slice(0, at)},\n${entries}${body.slice(at)}`,
+            added,
+            alreadyPresent,
+        };
+    }
+
+    const permSpan = locate(body, ['permissions']);
+    if (permSpan !== null) {
+        const indent = `${indentAt(body, permSpan.open)}    `;
+        const entries = added.map((r) => `${indent}    ${JSON.stringify(r)}`).join(',\n');
+        const inner = body.slice(permSpan.open + 1, permSpan.close);
+        const sep = inner.trim().length === 0 ? '' : ',';
+        const block = `\n${indent}"deny": [\n${entries}\n${indent}]${sep}`;
+        return {
+            text: `${body.slice(0, permSpan.open + 1)}${block}${body.slice(permSpan.open + 1)}`,
+            added,
+            alreadyPresent,
+        };
+    }
+
+    const rootSpan = locate(body, []);
+    if (rootSpan === null) throw new Error('settings body has no root object');
+    const indent = '    ';
+    const entries = added.map((r) => `${indent}        ${JSON.stringify(r)}`).join(',\n');
+    const inner = body.slice(rootSpan.open + 1, rootSpan.close);
+    const sep = inner.trim().length === 0 ? '' : ',';
+    const block = `\n${indent}"permissions": {\n${indent}    "deny": [\n${entries}\n${indent}    ]\n${indent}}${sep}`;
+    return {
+        text: `${body.slice(0, rootSpan.open + 1)}${block}${body.slice(rootSpan.open + 1)}`,
+        added,
+        alreadyPresent,
+    };
+}
diff --git a/src/install/noGoRules.ts b/src/install/noGoRules.ts
new file mode 100644
index 000000000..10a3812ba
--- /dev/null
+++ b/src/install/noGoRules.ts
@@ -0,0 +1,396 @@
+/**
+ * A consumer no-go bullet, sorted into `path`, `command` or `prose`, and
+ * rendered as the deny rule it would become.
+ *
+ * `road-to-a-project-contract-written-down` step 2.1. `/agents:init` asks the
+ * consumer for no-gos and writes them into their own `AGENTS.md`. A sentence
+ * there binds every turn and the agent may still read past it. This is what
+ * turns the two kinds that CAN be enforced into rows the host refuses on, and
+ * what refuses to turn the third kind into anything at all.
+ *
+ * ```
+ * A BULLET THE FUNCTION CANNOT CLASSIFY IS `prose`, NEVER A GUESSED ROW.
+ * A ROW ON A VAGUE SENTENCE BLOCKS LEGITIMATE WORK AND CANNOT SAY WHY.
+ * ```
+ *
+ * Pure: it reads a string and returns a verdict. Nothing here opens a settings
+ * file — the consent prompt and the append are step 2.2's.
+ *
+ * WHAT MAKES A VERDICT. Two independent signals must agree, and either one
+ * missing is `prose`:
+ *
+ *   1. ONE backticked token. The consumer guide's own `## No-gos` shape puts
+ *      the path or the command in backticks. Zero means the bullet names
+ *      neither; two or more means the subject is ambiguous, and picking one
+ *      would be the guess this module exists to refuse.
+ *   2. An action verb from a closed vocabulary. The token's SHAPE says what it
+ *      is; only the verb says what must not happen to it. "`vendor/` is
+ *      generated" carries a path and no action, and choosing `Edit` over `Read`
+ *      on its behalf would widen or narrow a rule nobody wrote.
+ */
+
+/** What a bullet turned out to be. */
+export type NoGoKind = 'path' | 'command' | 'prose';
+
+/**
+ * What the bullet forbids DOING — host-neutral, and the whole output of this
+ * module beside the token.
+ *
+ * `null` on a prose verdict. The split between this and the host's spelling is
+ * the council's convergent requirement of 2026-10-13 (anthropic + openai, 2/2):
+ * a classifier that resolves a host row at run time is not a pure classifier,
+ * and a renderer that re-derives the semantics is a second place for them to
+ * drift. The classifier never learns which host it is running for.
+ */
+export type NoGoAction = 'read' | 'edit' | 'run';
+
+export interface NoGoClassification {
+    /** The bullet as written, list marker stripped and trimmed. */
+    readonly bullet: string;
+    readonly kind: NoGoKind;
+    /** The one backticked token the verdict rests on; `null` for prose. */
+    readonly token: string | null;
+    /** What must not happen to it; `null` for prose. */
+    readonly action: NoGoAction | null;
+    /** Why the verdict is what it is — shown beside the row at consent time. */
+    readonly reason: string;
+}
+
+/** Verbs that forbid READING. A `Read` deny also covers edits and writes. */
+const READ_VERBS = ['read', 'open', 'view', 'cat', 'print', 'dump'] as const;
+
+/** Verbs that forbid CHANGING. `Edit` is the only path rule the host checks. */
+const EDIT_VERBS = [
+    'edit',
+    'modify',
+    'change',
+    'write',
+    'touch',
+    'delete',
+    'remove',
+    'rename',
+    'commit',
+    'overwrite',
+    'regenerate',
+] as const;
+
+/** Verbs that forbid EXECUTING. */
+const RUN_VERBS = ['run', 'execute', 'invoke', 'call'] as const;
+
+/**
+ * Words that make a bullet a PROHIBITION rather than a description.
+ *
+ * Required, and that is the correction a review forced: a verb scan alone
+ * accepts "``npm run build`` is the only sanctioned build command" and renders
+ * a deny row over the command the bullet PRESCRIBES. A no-go section is not the
+ * only place a backticked command appears in a sentence with a verb near it.
+ */
+const NEGATIONS = [
+    'never',
+    'not',
+    'no',
+    "don't",
+    'dont',
+    'avoid',
+    'forbidden',
+    'prohibited',
+] as const;
+
+/**
+ * Text that ends the clause the prohibition governs.
+ *
+ * The second half of the same correction. "Never run migrations in production
+ * - use `php artisan migrate --pretend` instead" negates, carries a run verb,
+ * and carries a backticked command — and the command is the ESCAPE HATCH the
+ * bullet recommends. A separator between the verb and the token means the token
+ * belongs to a different clause, so the verdict is prose.
+ */
+const CLAUSE_BREAK =
+    /(?:^|\s)[-–—](?:\s|$)|[;:,()]|\b(?:instead|use|using|prefer|except|unless|but|rather|need|needs|needed|necessary|required|optional|if|when|while)\b/i;
+
+/** Backticked spans replaced by spaces, so a verb INSIDE the token is not read as the bullet's verb. */
+function maskTokens(bullet: string): string {
+    return bullet.replace(/`[^`]+`/g, (m) => ' '.repeat(m.length));
+}
+
+/** First index at which any whole word in `words` occurs, or -1. */
+function firstWordIndex(haystack: string, words: readonly string[]): number {
+    let best = -1;
+    for (const w of words) {
+        const m = new RegExp(`\\b${w}\\b`, 'i').exec(haystack);
+        if (m !== null && (best === -1 || m.index < best)) best = m.index;
+    }
+    return best;
+}
+
+interface VerbHit {
+    readonly action: NoGoAction;
+    readonly start: number;
+    readonly end: number;
+}
+
+/** The first action verb at or after `from`, or `null`. */
+function verbAfter(masked: string, from: number): VerbHit | null {
+    const groups: readonly (readonly [NoGoAction, readonly string[]])[] = [
+        ['run', RUN_VERBS],
+        ['read', READ_VERBS],
+        ['edit', EDIT_VERBS],
+    ];
+    let best: VerbHit | null = null;
+    for (const [action, verbs] of groups) {
+        for (const v of verbs) {
+            const re = new RegExp(`\\b${v.replace("'", "'?")}\\b`, 'gi');
+            let m = re.exec(masked);
+            while (m !== null) {
+                if (m.index >= from && (best === null || m.index < best.start)) {
+                    best = { action, start: m.index, end: m.index + m[0].length };
+                }
+                m = re.exec(masked);
+            }
+        }
+    }
+    return best;
+}
+
+/** The backticked spans of a bullet, in order. */
+function backticked(bullet: string): string[] {
+    const out: string[] = [];
+    const re = /`([^`]+)`/g;
+    let m = re.exec(bullet);
+    while (m !== null) {
+        const inner = (m[1] as string).trim();
+        if (inner.length > 0) out.push(inner);
+        m = re.exec(bullet);
+    }
+    return out;
+}
+
+/**
+ * Does `token` look like a filesystem path?
+ *
+ * A path separator, a leading dot, or a file extension. A bare word is NOT a
+ * path: `migrations` alone could be a directory or a command, and the guide's
+ * own example writes the trailing slash.
+ */
+/**
+ * File extensions a single-dot token is accepted on.
+ *
+ * A closed list, because neither open rule works. `/\.[A-Za-z0-9]+$/` accepted
+ * `users.id`, `app.debug` and `v2.1`; the replacement that excluded
+ * all-lowercase single-dot tokens refused `package.json`, `main.go` and
+ * `index.js` — a consumer's most likely first no-go — while still accepting
+ * `Users.id` and `my_table.id`. Both were measured; the list is what
+ * distinguishes the two classes without guessing either way.
+ */
+const FILE_EXTENSIONS = new Set([
+    'cjs', 'conf', 'css', 'csv', 'env', 'go', 'html', 'ini', 'java', 'js', 'json', 'jsx',
+    'kt', 'lock', 'log', 'md', 'mjs', 'php', 'pem', 'py', 'rb', 'rs', 'scss', 'sh', 'sql',
+    'sqlite', 'svg', 'toml', 'ts', 'tsx', 'txt', 'xml', 'yaml', 'yml',
+]);
+
+function looksLikePath(token: string): boolean {
+    if (/\s/.test(token)) return false;
+    if (token.includes('/')) return true;
+    if (token.startsWith('.')) return true;
+    const dot = token.lastIndexOf('.');
+    if (dot <= 0) return false;
+    return FILE_EXTENSIONS.has(token.slice(dot + 1).toLowerCase());
+}
+
+/**
+ * Characters that make a path token mean something other than it reads.
+ *
+ * `!` is a gitignore NEGATION on the host: a deny row starting with it carves
+ * paths OUT of the deny rules listed before it, so a no-go bullet would weaken
+ * a consumer's existing list while being shown as a deny row. `[`, `]` and `?`
+ * are gitignore character classes, and the host does not escape a rule you
+ * wrote yourself — `reports/[2024]/**` matches `reports/2/`, never the
+ * directory the consumer named.
+ *
+ * A single leading `/` joins them, and the page carries a warning box about it:
+ * a pattern with one leading slash "isn't an absolute path. The single leading
+ * slash anchors at the settings source, not the filesystem root" — the page's
+ * own example of the mistake is elided here because a home-shaped literal in a
+ * published file is what `check_bundle_path_leakage` exists to refuse. A
+ * consumer who writes `` `/etc/passwd` `` means the absolute path, and the row
+ * would guard `<working directory>/etc/passwd` — a path that does not exist.
+ *
+ * `*` is deliberately NOT here: a consumer who writes `src/generated/**` means
+ * that glob, and the guide teaches the trailing slash for everything else.
+ */
+const UNSAFE_PATH_CHARS = /^!|^\/(?!\/)|[[\]?]/;
+
+const PROSE = (bullet: string, reason: string): NoGoClassification => ({
+    bullet,
+    kind: 'prose',
+    token: null,
+    action: null,
+    reason,
+});
+
+/** Strip a leading markdown list marker, if present. */
+function stripMarker(line: string): string {
+    return line.replace(/^\s*[-*+]\s+/, '').trim();
+}
+
+export function classifyNoGo(raw: string): NoGoClassification {
+    const bullet = stripMarker(raw);
+    if (bullet.length === 0) return PROSE(bullet, 'empty bullet');
+
+    const tokens = backticked(bullet);
+    if (tokens.length === 0) {
+        return PROSE(bullet, 'names no path and no command in backticks');
+    }
+    if (tokens.length > 1) {
+        return PROSE(
+            bullet,
+            `${String(tokens.length)} backticked tokens — the subject is ambiguous, so no row is built`,
+        );
+    }
+
+    const token = tokens[0] as string;
+    const masked = maskTokens(bullet);
+    const tokenAt = bullet.indexOf(`\`${token}\``);
+
+    const negAt = firstWordIndex(masked, NEGATIONS);
+    if (negAt === -1) {
+        return PROSE(
+            bullet,
+            'states no prohibition, so the backticked token may be what the bullet recommends',
+        );
+    }
+    const verb = verbAfter(masked, negAt);
+    if (verb === null) {
+        return PROSE(bullet, 'names no action verb, so what must not happen to it is unstated');
+    }
+    // The negation must govern the VERB too, not merely appear earlier in the
+    // line. Without this, "If no cache exists, run `npm run build`" and "There
+    // is no need to run `npm install`" both denied the command they permit —
+    // round 1's finding narrowed rather than closed, measured by round 2.
+    if (CLAUSE_BREAK.test(masked.slice(negAt, verb.start))) {
+        return PROSE(
+            bullet,
+            'the prohibition and the action verb sit in different clauses, so the bullet may ' +
+                'be permitting rather than forbidding',
+        );
+    }
+    if (verb.start > tokenAt) {
+        return PROSE(bullet, 'the action verb comes after the token, so the two may not be related');
+    }
+    const between = bullet.slice(verb.end, tokenAt);
+    if (CLAUSE_BREAK.test(between)) {
+        return PROSE(
+            bullet,
+            `\`${token}\` sits in a different clause from the prohibition — it may be the ` +
+                'alternative the bullet recommends, so no rule is built',
+        );
+    }
+
+    if (verb.action === 'run') {
+        return {
+            bullet,
+            kind: 'command',
+            token,
+            action: verb.action,
+            reason: 'a negated run verb over a backticked command',
+        };
+    }
+    const action = verb.action;
+
+    if (!looksLikePath(token)) {
+        return PROSE(
+            bullet,
+            `a ${action} verb over \`${token}\`, which has no path shape — no rule is built`,
+        );
+    }
+    if (UNSAFE_PATH_CHARS.test(token)) {
+        return PROSE(
+            bullet,
+            `\`${token}\` carries a gitignore metacharacter (\`!\`, \`[\`, \`]\` or \`?\`) that the ` +
+                'host does not escape, so a rule built from it would guard something else',
+        );
+    }
+
+    return {
+        bullet,
+        kind: 'path',
+        token,
+        action,
+        reason:
+            action === 'read'
+                ? 'a read verb over a backticked path'
+                : 'an edit verb over a backticked path',
+    };
+}
+
+/**
+ * Every bullet of a `## No-gos` section, in file order.
+ *
+ * Non-bullet lines — the heading, blanks, a sentence between bullets — are not
+ * no-gos and are skipped rather than classified as prose: a prose verdict is a
+ * statement about a bullet somebody wrote, and a heading is not one.
+ */
+export function classifyNoGos(section: string): readonly NoGoClassification[] {
+    return section
+        .split('\n')
+        .filter((line) => /^\s*[-*+]\s+\S/.test(line))
+        .map((line) => classifyNoGo(line));
+}
+
+/** The `##` heading spellings a no-gos section is written under. */
+const NO_GOS_HEADINGS = new Set(['no-gos', 'no-gos (never do this)']);
+
+/**
+ * The body of a consumer `AGENTS.md`'s `## No-gos` section, or `''`.
+ *
+ * Skips fenced blocks for the reason `report_project_contract` does, and it is
+ * the same load-bearing reason rather than a shared habit: the consumer guide
+ * ships this exact heading INSIDE a ```markdown fence as copy-in material, so a
+ * reader without the skip would classify the guide's own example bullets and
+ * offer to deny `migrations/` in a repository that never asked.
+ */
+export function extractNoGosSection(body: string): string {
+    const out: string[] = [];
+    /** The open fence's marker character AND its length. */
+    let fence: { char: string; len: number } | null = null;
+    let inside = false;
+    const lines = body.split('\n');
+    for (let n = 0; n < lines.length; n += 1) {
+        const line = (lines[n] as string).trimEnd();
+        const open = /^\s*(`{3,}|~{3,})/.exec(line);
+        if (open !== null) {
+            const marker = open[1] as string;
+            const char = marker[0] as string;
+            if (fence === null) {
+                fence = { char, len: marker.length };
+                continue;
+            }
+            // A fence closes only on the SAME character and at least its own
+            // length. Tracking the character alone let a ````-delimited block
+            // close on its first inner ``` line, so the rest of a guide's
+            // copy-in example was read as the consumer's own rules.
+            if (char === fence.char && marker.length >= fence.len) fence = null;
+            continue;
+        }
+        if (fence !== null) continue;
+        // A setext underline turns the PREVIOUS line into a heading, which
+        // closes the section the same way an ATX heading does.
+        if (/^(?:=+|-{2,})\s*$/.test(line) && out.length > 0 && inside) {
+            out.pop();
+            inside = false;
+            continue;
+        }
+        // ANY heading level closes the section; only a level-two one with a
+        // matching title opens it. Matching `##` alone let a following `#
+        // Appendix` leave the section open, so every bullet of every later
+        // top-level section was classified as a no-go.
+        const h = /^(#{1,6})[ \t]+(.+?)[ \t]*#*$/.exec(line);
+        if (h !== null) {
+            const level2 = (h[1] as string).length === 2;
+            inside = level2 && NO_GOS_HEADINGS.has((h[2] as string).trim().toLowerCase());
+            continue;
+        }
+        if (inside) out.push(line);
+    }
+    return out.join('\n');
+}
