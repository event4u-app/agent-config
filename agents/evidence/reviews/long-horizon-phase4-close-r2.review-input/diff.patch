+        expect(fs.existsSync(path.join(r, SUPERVISE_STATE_REL))).toBe(true);
+    });
+});
+
+describe('digest — the release line follows the WRITE, not the intent', () => {
+    const done = (over: Partial<Candidate> = {}): Candidate =>
