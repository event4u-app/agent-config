+    it('keeps `stop` out of both counted sets', () => {
+        expect(COUNTED_EVENTS as readonly string[]).not.toContain('stop');
+        expect(JOURNAL_BOUND_COUNTED_EVENTS as readonly string[]).not.toContain('stop');
+    });
+});
