+        const all = read([]);
+        windowExtended = all.length > commits.length;
+        if (windowExtended) commits = all;
+    }
+    const refs = _git(cwd, ['for-each-ref', '--format=%(refname:short)', 'refs/remotes']) ?? '';
+    const branches = refs
