<?xml version="1.0" encoding="UTF-8"?>
<!--
  agents/.ai-video.xml.example
  ============================

  Operator-facing provider configuration for the /video:* command cluster.

  Copy this file to `agents/.ai-video.xml` and fill in the API keys for the
  providers you actually use. The real file is gitignored and MUST NEVER be
  committed.

  Loader: scripts/ai-video/lib/load-config.sh
  Redaction: scripts/ai-video/lib/redact.sh
  Docs: agents/reference/ai-video/README.md
-->
<ai-video version="1">

  <!--
    Defaults: pick which provider a /video:* run uses when the command
    does not pass the image-provider / video-provider flags. Must match
    a provider id="..." declared below.

    Each provider carries a <lifecycle> tag — experimental | stable |
    deprecated | community — per docs/contracts/provider-lifecycle.md.
    Day-one shipped tiers are conservative: every adapter is
    `experimental` until a maintainer captures a real-API smoke trace.
    The agent refuses to *default* to a non-stable provider silently;
    it surfaces the tier and asks before running.
  -->
  <default-image-provider>openai-images</default-image-provider>
  <default-video-provider>gemini-veo</default-video-provider>

  <!-- ============================================================ -->
  <!-- Image providers                                              -->
  <!-- ============================================================ -->

  <provider id="openai-images" kind="image">
    <lifecycle>experimental</lifecycle>
    <api-key>sk-REPLACE-ME</api-key>
    <endpoint>https://api.openai.com/v1</endpoint>
    <default-model>gpt-image-1</default-model>
    <dry-run>true</dry-run>
    <tuning>
      <aspect>16:9</aspect>
      <quality>high</quality>
      <best-of-n>4</best-of-n>
    </tuning>
  </provider>

  <provider id="higgsfield" kind="image+video">
    <lifecycle>experimental</lifecycle>
    <api-key>hf-REPLACE-ME</api-key>
    <endpoint>https://api.higgsfield.ai/v1</endpoint>
    <default-model>higgsfield-soul</default-model>
    <dry-run>true</dry-run>
    <tuning>
      <aspect>16:9</aspect>
      <preset>cinematic</preset>
      <max-duration>5</max-duration>
      <best-of-n>2</best-of-n>
    </tuning>
  </provider>

  <!-- ============================================================ -->
  <!-- Video providers                                              -->
  <!-- ============================================================ -->

  <provider id="gemini-veo" kind="video">
    <lifecycle>experimental</lifecycle>
    <api-key>AIza-REPLACE-ME</api-key>
    <endpoint>https://generativelanguage.googleapis.com/v1beta</endpoint>
    <default-model>veo-3.0-generate-001</default-model>
    <dry-run>true</dry-run>
    <tuning>
      <aspect>16:9</aspect>
      <fps>24</fps>
      <max-duration>8</max-duration>
      <audio-native>true</audio-native>
    </tuning>
  </provider>

  <provider id="kling" kind="video">
    <lifecycle>experimental</lifecycle>
    <api-key>kling-REPLACE-ME</api-key>
    <endpoint>https://api.klingai.com/v1</endpoint>
    <default-model>kling-v2-master</default-model>
    <dry-run>true</dry-run>
    <tuning>
      <aspect>16:9</aspect>
      <fps>30</fps>
      <max-duration>10</max-duration>
      <audio-native>false</audio-native>
    </tuning>
  </provider>

  <provider id="sora" kind="video">
    <lifecycle>experimental</lifecycle>
    <api-key>sora-REPLACE-ME</api-key>
    <endpoint>https://api.openai.com/v1</endpoint>
    <default-model>sora-2</default-model>
    <dry-run>true</dry-run>
    <tuning>
      <aspect>16:9</aspect>
      <fps>30</fps>
      <max-duration>20</max-duration>
      <audio-native>true</audio-native>
    </tuning>
  </provider>

  <!-- ============================================================ -->
  <!-- Multiplexer providers — one adapter, many models             -->
  <!-- Model selection: top-level `model_id` stdin key overrides    -->
  <!-- <default-model>. Per-model capabilities:                     -->
  <!-- scripts/ai-video/lib/model-capabilities/<id>.json            -->
  <!-- Kill-switch: <enabled>false</enabled> refuses every network  -->
  <!-- subcommand without editing procedures that name the provider.-->
  <!-- ============================================================ -->

  <provider id="fal" kind="video">
    <lifecycle>experimental</lifecycle>
    <enabled>true</enabled>
    <api-key>fal-REPLACE-ME</api-key>
    <endpoint>https://queue.fal.run</endpoint>
    <default-model>fal-ai/ltx-2/text-to-video</default-model>
    <dry-run>true</dry-run>
    <tuning>
      <aspect>16:9</aspect>
      <max-duration>10</max-duration>
      <audio-native>false</audio-native>
    </tuning>
  </provider>

  <provider id="replicate" kind="video">
    <lifecycle>experimental</lifecycle>
    <enabled>true</enabled>
    <api-key>r8_REPLACE-ME</api-key>
    <endpoint>https://api.replicate.com/v1</endpoint>
    <default-model>kwaivgi/kling-v2.1-master</default-model>
    <dry-run>true</dry-run>
    <tuning>
      <aspect>16:9</aspect>
      <max-duration>10</max-duration>
      <audio-native>false</audio-native>
    </tuning>
  </provider>

  <!-- ============================================================ -->
  <!-- Audio adapters (music-video orchestration)                   -->
  <!-- Contract: scripts/ai-video/lib/audio-adapter-contract.md     -->
  <!-- local-cli adapters wrap an OPERATOR-installed tool (pip) —   -->
  <!-- no api-key element needed; <enabled>false</enabled> opts a   -->
  <!-- configured-but-unwanted adapter out (otherwise a missing CLI -->
  <!-- is a loud config failure, never a silent probe fallback).    -->
  <!-- ============================================================ -->

  <provider id="allin1" kind="audio-analysis">
    <lifecycle>experimental</lifecycle>
    <enabled>true</enabled>
    <dry-run>true</dry-run>
  </provider>

  <provider id="whisperx" kind="lyrics">
    <lifecycle>experimental</lifecycle>
    <enabled>true</enabled>
    <dry-run>true</dry-run>
  </provider>

  <!-- ============================================================ -->
  <!-- Lip-sync post-process (v2 contract, kind="lipsync")          -->
  <!-- Sparse budget: lib/model-capabilities/syncso.json            -->
  <!-- ============================================================ -->

  <provider id="syncso" kind="lipsync">
    <lifecycle>experimental</lifecycle>
    <enabled>true</enabled>
    <api-key>sk-REPLACE-ME</api-key>
    <endpoint>https://api.sync.so</endpoint>
    <default-model>lipsync-2</default-model>
    <dry-run>true</dry-run>
  </provider>

  <!-- ============================================================ -->
  <!-- Extra slot — future providers without schema bump            -->
  <!-- Use kind="image" | "video" | "image+video" | "audio-analysis"-->
  <!-- | "lyrics" | "lipsync".                                      -->
  <!-- ============================================================ -->

  <extra>
    <!--
    <provider id="my-future-backend" kind="video">
      <lifecycle>experimental</lifecycle>
      <api-key>REPLACE-ME</api-key>
      <endpoint>https://example.invalid/v1</endpoint>
      <default-model>example-1</default-model>
      <dry-run>true</dry-run>
      <tuning>
        <aspect>16:9</aspect>
        <fps>24</fps>
        <max-duration>6</max-duration>
        <audio-native>false</audio-native>
      </tuning>
    </provider>
    -->
  </extra>

</ai-video>
