{
  "manifest_version": 1,
  "domain": "a11y-patterns",
  "tier": "lookup-only",
  "retriever": "bm25",
  "default_domain": "patterns",
  "domains": {
    "patterns": {
      "file": "aria-patterns.csv",
      "search_cols": [
        "Component",
        "Keywords",
        "Pattern",
        "Implementation"
      ],
      "output_cols": [
        "Component",
        "Pattern",
        "Implementation",
        "WCAG Refs",
        "Anti-Patterns",
        "Docs URL"
      ],
      "max_results": 3
    }
  },
  "owner": "package-maintainer",
  "refresh_cadence": "quarterly",
  "upstream": {
    "repo": "derived: W3C ARIA Authoring Practices Guide + WCAG 2.2",
    "sha": "WCAG 2.2 W3C-REC-2024-12-12; APG 2026 menu-button",
    "last_checked": "2026-10-01"
  }
}
