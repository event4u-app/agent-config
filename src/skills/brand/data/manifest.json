  "default_domain": "archetype",
  "domains": {
    "archetype": {
      "file": "archetypes.csv",
      "search_cols": [
        "Archetype",
        "Core Desire",
        "Voice Traits",
        "Messaging Angle",
        "Best For"
      ],
