{
    "name": "@event4u/agent-config",
    "version": "5.9.0",
    "description": "Universal AI Agent OS \u2014 audited skills, governance rules, commands, and templates for AI coding tools (Claude Code, Cursor, Windsurf, Copilot).",
    "license": "MIT",
    "private": false,
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/event4u-app/agent-config.git"
    },
    "bugs": {
        "url": "https://github.com/event4u-app/agent-config/issues"
    },
    "homepage": "https://github.com/event4u-app/agent-config#readme",
    "keywords": [
        "ai-agent",
        "mcp",
        "claude-code",
        "cursor",
        "windsurf",
        "copilot",
        "llm",
        "agent-governance",
        "ai-video",
        "skills",
        "prompt-engineering",
        "typescript",
        "python",
        "agent-skills",
        "cinematic-ai-video"
    ],
    "files": [
        ".agent-src/",
        ".augment-plugin/",
        ".claude-plugin/",
        "config/",
        "dist/",
        "docs/",
        "scripts/",
        "templates/",
        "AGENTS.md",
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "LICENSE",
        "README.md",
        "llms.txt"
    ],
    "bin": {
        "agent-config": "dist/cli/agent-config.js"
    },
    "engines": {
        "node": ">=20.11.0"
    },
    "scripts": {
        "build:cli": "tsc -p tsconfig.json && chmod +x dist/cli/agent-config.js",
        "build:ui": "vite build",
        "build:discovery": "python3 scripts/build_discovery_manifest.py --write --strict",
        "build:mcp-manifest": "python3 scripts/build_mcp_registry_manifest.py --write --strict",
        "build": "npm run build:cli && npm run build:ui",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint:ts": "eslint 'src/**/*.ts'",
        "test:ts": "vitest run",
        "prepack": "npm run build && npm run build:discovery && npm run build:mcp-manifest && node scripts/prepack-check.mjs",
        "prepublishOnly": "python3 scripts/check_release_includes_discovery.py"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "peerDependencies": {
        "@event4u/agent-memory": "^1.1.0"
    },
    "peerDependenciesMeta": {
        "@event4u/agent-memory": {
            "optional": true
        }
    },
    "devDependencies": {
        "@inquirer/prompts": "^7.10.1",
        "@playwright/test": "^1.60.0",
        "@preact/preset-vite": "^2.10.5",
        "@testing-library/preact": "^3.2.4",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^20.19.41",
        "@typescript-eslint/eslint-plugin": "^8.59.4",
        "@typescript-eslint/parser": "^8.59.4",
        "eslint": "^9.39.4",
        "happy-dom": "^20.9.0",
        "tsx": "^4.22.3",
        "typescript": "^5.9.3",
        "vite": "^5.4.21",
        "vitest": "^2.1.9"
    },
    "dependencies": {
        "@fastify/static": "^9.1.0",
        "@preact/signals": "^2.9.0",
        "commander": "^12.1.0",
        "execa": "^9.5.0",
        "fastify": "^5.8.0",
        "js-yaml": "^4.1.0",
        "open": "^10.2.0",
        "preact": "^10.29.0",
        "zod": "^3.25.0",
        "zod-to-json-schema": "^3.25.0"
    }
}
