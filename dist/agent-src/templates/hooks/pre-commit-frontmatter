#!/usr/bin/env bash
# Pre-commit hook: artefact frontmatter lint (event4u/agent-config, ADR-013)
#
# Aborts the commit when any staged .md file under
# `.agent-src.uncondensed/` violates the per-artefact frontmatter
# contract (workspaces / packs / lifecycle / trust / install). Exits
# silently when no such files are staged — zero overhead on unrelated
# commits.
#
# To run manually:
#   ./agent-config hooks:install-frontmatter
#   ./scripts-run src/scripts/lint_artefact_frontmatter
#
# To uninstall:
#   rm .git/hooks/pre-commit
set -e

# Only act on commits that touch the source-of-truth artefact tree
# (or the linter / vocabulary that govern it). The runtime is Node/tsx
# (py2ts migration) — the linter runs through the package tsx runner,
# never python3.
staged="$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)"
case "$staged" in
  *.agent-src.uncondensed/*.md*|*src/agent-src/*.md*|*config/discovery/*.yml*|*scripts/lint_artefact_frontmatter.ts*)
    : ;;
  *)
    exit 0 ;;
esac

# Resolve the linter — a source-repo artefact (the frontmatter contract
# governs the source tree; consumer repos have nothing to lint).
script=""
for cand in \
  "src/scripts/lint_artefact_frontmatter.ts" \
  ".augment/scripts/lint_artefact_frontmatter.ts"; do
  if [ -f "$cand" ]; then
    script="$cand"
    break
  fi
done

if [ -z "$script" ]; then
  echo "⚠️  pre-commit-frontmatter: lint_artefact_frontmatter.ts not found." >&2
  echo "    Skipping check — letting commit through." >&2
  exit 0
fi

run_lint() {
  if [ -x "./scripts-run" ]; then
    ./scripts-run src/scripts/lint_artefact_frontmatter --quiet
  elif [ -x "node_modules/.bin/tsx" ]; then
    node_modules/.bin/tsx "$script" --quiet
  else
    npx tsx "$script" --quiet
  fi
}

if ! run_lint >/dev/null 2>&1; then
  echo "❌  Artefact frontmatter lint failed (ADR-013 contract violation)." >&2
  echo "" >&2
  echo "    Re-run for details:" >&2
  echo "      ./scripts-run src/scripts/lint_artefact_frontmatter" >&2
  echo "      task lint-artefact-frontmatter" >&2
  echo "" >&2
  echo "    Common fixes:" >&2
  echo "      • Add missing workspaces/packs/lifecycle/trust/install keys." >&2
  echo "      • Pick values from config/discovery/{workspaces,packs}.yml." >&2
  echo "      • For scaffolds, add the path to" >&2
  echo "        config/discovery/unassigned-artefacts.yml with a reason." >&2
  echo "" >&2
  echo "    To bypass once (NOT recommended):" >&2
  echo "      git commit --no-verify" >&2
  exit 1
fi

exit 0
