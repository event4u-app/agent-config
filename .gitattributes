# .gitattributes — controls what ships in distribution archives.
#
# Packagist and GitHub release tarballs are built with `git archive`, which
# honors `export-ignore`. Paths listed here are stripped from every tarball
# a consumer ever sees (composer, Packagist, GitHub Releases).
#
# Rule of thumb:
#   - Ship anything a consumer needs at install- or runtime.
#   - Exclude authoring sources, dev tooling, tool mirrors, and CI files.

# Authoring + dev tooling
/.agent-src.uncondensed export-ignore
/.augmentignore          export-ignore
/.agent-settings         export-ignore
/agents                  export-ignore
/tests                   export-ignore
/Taskfile.yml            export-ignore

# Tool mirrors — regenerated from `.agent-src/` by `task generate-tools`.
# Consumers generate their own via the installer; shipping them is pure weight.
/.augment                export-ignore
/.claude                 export-ignore
/.cursor                 export-ignore
/.clinerules             export-ignore
/.windsurfrules          export-ignore
/CLAUDE.md               export-ignore
/GEMINI.md               export-ignore

# CI, IDE, caches
/.github                 export-ignore
/.idea                   export-ignore
/.vscode                 export-ignore
/.phpunit.cache          export-ignore
/.pytest_cache           export-ignore

# Git / npm metadata — not useful inside the vendored package
/.gitattributes          export-ignore
/.gitignore              export-ignore
/.npmignore              export-ignore

# --- BEGIN agent-config managed: memory merge attributes ---
# Agent memory — merge-safety attributes for parallel-branch memory writes.
# Append this block to the consumer project's root .gitattributes.
# See: agents/roadmaps/archive/road-to-reachable-code-memory.md (Phase 5)

# Intake layer — agent-written, append-only JSONL. Union merge concats both
# sides on conflict instead of failing. Reader (_iter_intake_entries in
# memory_lookup.ts) resolves supersede chains keyed by id, so a duplicate
# line surviving a bad merge collapses harmlessly — same id, later line wins.
agents/memory/intake/*.jsonl merge=union eol=lf

# Curated memory — flat layout: one YAML file per type holding an `entries:`
# list (agents/memory/<type>.yml). Two branches each appending a genuinely
# NEW entry — the common case — union-merges cleanly (concats both sides).
# CAVEAT: union merge operates per LINE, not per YAML block. If both branches
# touch overlapping lines (not pure appends), the result can interleave
# partial multi-line list items into invalid YAML. The reader
# (_iter_curated_entries in memory_lookup.ts) does NOT dedup entries by id for
# this layout, so an exact duplicate block surviving a bad union merge would
# surface twice. Treat this as a best-effort safety net for the append-only
# case, not a guarantee — the directory layout below has no such caveat.
agents/memory/ownership.yml              merge=union text eol=lf
agents/memory/historical-patterns.yml    merge=union text eol=lf
agents/memory/domain-invariants.yml      merge=union text eol=lf
agents/memory/incident-learnings.yml     merge=union text eol=lf
agents/memory/product-rules.yml          merge=union text eol=lf

# Curated memory — directory layout: one file per entry, content-addressed
# by hash. Filename collisions are content-identity, so normal (non-union)
# merge is fine here; only line-ending normalization matters.
agents/memory/ownership/*.yml              text eol=lf
agents/memory/historical-patterns/*.yml    text eol=lf
agents/memory/domain-invariants/*.yml      text eol=lf
agents/memory/incident-learnings/*.yml     text eol=lf
agents/memory/product-rules/*.yml          text eol=lf
# --- END agent-config managed: memory merge attributes ---
