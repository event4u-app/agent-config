{
  "primitive": {
    "color": { "ink": { "$type": "color", "$value": "#000000" } },
    "shadow": {
      "one": {
        "$type": "shadow",
        "$value": { "color": "{primitive.color.ink}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 2, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }
      },
      "stack": {
        "$type": "shadow",
        "$value": [
          { "color": { "colorSpace": "srgb", "components": [0, 0, 0], "hex": "#000000", "alpha": 0.5 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 4, "unit": "px" }, "blur": { "value": 8, "unit": "px" }, "spread": { "value": -2, "unit": "px" } },
          { "color": "#00000033", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 0, "unit": "px" }, "blur": { "value": 1, "unit": "px" }, "spread": { "value": 0, "unit": "px" }, "inset": true }
        ]
      }
    }
  }
}
