        "s2-surgical-face/delivered/figure.svg"
      ],
      "asserts": {
        "preservation_changes_outside_allowed": 0,
        "silhouette_change_outside_box": "within the anti-aliasing band only",
        "changed_box": {
          "x": 18,
          "y": 46,
          "width": 84,
          "height": 80
        }
      }
    },
    {
      "id": "scales-3000x-sharp",
      "dir": "s3-scale",
      "task": "s3-scale/task.md",
      "asset_class": "mark",
      "delivery": "inline",
      "input": "s1-new-logo/delivered/mark.svg",
      "delivered": [],
