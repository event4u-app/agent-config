{
  "fixture": "svg end-to-end scenarios",
  "roadmap": "road-to-svg-with-a-witness",
  "step": "Phase 6",
  "note": "Each scenario is a recorded run of the svg-authoring skill. The witnesses decide the outcome; this file is what svg_scenarios.test.ts reads so the assertions are declared beside the artefacts rather than buried in the test.",
  "scenarios": [
    {
      "id": "new-logo-true-vector",
      "dir": "s1-new-logo",
      "task": "s1-new-logo/task.md",
      "asset_class": "mark",
      "delivery": "inline",
      "delivered": [
        "s1-new-logo/delivered/mark.svg"
      ],
      "asserts": {
        "image_elements": 0,
        "foreign_objects": 0,
        "text_elements": 0,
        "lint_errors": 0,
        "fill_ratio_within_class_threshold": true,
        "status": "verified"
      }
    },
    {
      "id": "new-logo-from-raster",
      "dir": "s1b-conversion",
      "task": "s1b-conversion/task.md",
      "asset_class": "mark",
      "delivery": "inline",
      "source_reference": "../fixtures/svg-assets/conversion/reference.svg",
      "delivered": [
        "s1b-conversion/delivered/mark.svg"
      ],
      "asserts": {
        "image_elements": 0,
        "wordmark_or_slogan_region": false,
        "hole_is_transparent_on_dark": true,
        "max_scored_passes": 5,
        "tolerance_from": "../fixtures/svg-assets/manifest.json#raster_conversion_tolerance"
      }
    },
    {
      "id": "face-removed-hat-unchanged",
      "dir": "s2-surgical-face",
